---
import { salePrice, type Product } from "../data/products";
type Props = { product: Product; compact?: boolean };
const { product, compact = false } = Astro.props;
const discounted = Boolean(product.couponCode && product.discountAmount);
---

<div class:list={["sale-price", { compact }]}>
  <div class="sale-price-current">${product.price}</div>
  <div class="sale-price-note">one-time enrollment</div>
  {discounted && <div class="sale-price-code">Take ${product.discountAmount} off at checkout with <strong>{product.couponCode}</strong><br />Pay ${salePrice(product)} with code.</div>}
</div>

<style>
  .sale-price { margin: 20px 0 0; }
  .sale-price-current { color: #fff; font-size: 58px; font-weight: 950; letter-spacing: -.055em; line-height: 1.15; margin: 3px 0; }
  .sale-price-code { color: #c8e6ff; font-size: 13px; line-height: 1.5; margin-top: 10px; }
  .sale-price-code strong { font-weight: 850; letter-spacing: .02em; }
  .sale-price-note { color: #afc2db; font-size: 11px; margin-top: 2px; }
  .compact { margin: 0; }
  .compact .sale-price-current { font-size: 46px; }
  .compact .sale-price-code { font-size: 11px; }
</style>
