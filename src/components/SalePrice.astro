---
import { salePrice, type Product } from "../data/products";
type Props = { product: Product; compact?: boolean };
const { product, compact = false } = Astro.props;
const discounted = Boolean(product.couponCode && product.discountAmount);
---

<div class:list={["sale-price", { compact }]}>
  {discounted && <div class="sale-price-before"><s aria-label={`Regular price ${product.price} dollars`}>${product.price}</s><span>50% OFF</span></div>}
  <div class="sale-price-current">${salePrice(product)}</div>
  {discounted && <div class="sale-price-code">with code <strong>{product.couponCode}</strong></div>}
  <div class="sale-price-note">one-time enrollment</div>
</div>

<style>
  .sale-price { margin: 20px 0 0; }
  .sale-price-before { display: flex; align-items: center; gap: 12px; }
  .sale-price-before s { color: #afc2db; font-size: 21px; line-height: 1.3; text-decoration-thickness: 2px; }
  .sale-price-before > span { display: inline-block; color: #061b3b; background: #a9d7ff; border-radius: 5px; padding: 3px 7px; font-size: 10px; font-weight: 900; letter-spacing: .06em; }
  .sale-price-current { color: #fff; font-size: 58px; font-weight: 950; letter-spacing: -.055em; line-height: 1.15; margin: 3px 0; }
  .sale-price-code { color: #c8e6ff; font-size: 13px; line-height: 1.5; }
  .sale-price-code strong { font-weight: 850; letter-spacing: .02em; }
  .sale-price-note { color: #afc2db; font-size: 11px; margin-top: 2px; }
  .compact { margin: 0; }
  .compact .sale-price-current { font-size: 46px; }
  .compact .sale-price-before s { font-size: 17px; }
  .compact .sale-price-before { gap: 8px; }
  .compact .sale-price-code { font-size: 11px; }
</style>
