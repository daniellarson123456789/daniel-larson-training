---
type Props = { amount: number };
const { amount } = Astro.props;
---

<span class="original-price">${amount}<svg class="price-brush" viewBox="0 0 128 48" preserveAspectRatio="none" aria-hidden="true" focusable="false">
  <path class="price-brush-wash" d="M3 43 C32 26 76 3.5 124 4 C76 21.5 32 38 3 43Z" />
  <path class="price-brush-stroke" d="M3 43 C32 26 76 3.5 124 4 C76 21.5 32 38 3 43Z" />
</svg></span>
