---
const reviews = [
  {
    name: "John Colin Simoneau",
    excerpt: "great information and quick replies.",
    url: "https://www.trustpilot.com/reviews/6ad7b5da844c403076fb3a7c",
  },
  {
    name: "Cheryl V",
    excerpt: "I passed easily and I learned a lot.",
    url: "https://www.trustpilot.com/reviews/6ad7b1ceb64b7c7d04ab8e08",
  },
  {
    name: "Jessica Ann Linville",
    excerpt: "The course was so easy to navigate",
    url: "https://www.trustpilot.com/reviews/6ad7b0511aa85a375c2daba4",
  },
];
---

<section class="tp-section" id="trustpilot-reviews" aria-labelledby="trustpilot-heading">
  <div class="tp-container">
    <header class="tp-heading">
      <p class="tp-eyebrow">DANIEL LARSON TRAINING</p>
      <h2 id="trustpilot-heading">Customer reviews on Trustpilot</h2>
      <p class="tp-intro">A few words from our customers. Follow each link to read the full review.</p>
    </header>

    <div class="tp-grid">
      {reviews.map((review) => (
        <article class="tp-card">
          <div class="tp-stars" role="img" aria-label="5 out of 5 stars">
            <span aria-hidden="true">★★★★★</span>
          </div>
          <blockquote><p>“{review.excerpt}”</p></blockquote>
          <footer class="tp-attribution">
            <strong>{review.name}</strong>
            <time datetime="2026-10-20">October 20, 2026</time>
            <a href={review.url} aria-label={`Read ${review.name}'s review on Trustpilot`}>Read on Trustpilot →</a>
          </footer>
        </article>
      ))}
    </div>

    <div class="tp-actions">
      <a class="tp-button tp-primary" href="https://www.trustpilot.com/review/daniellarsontraining.com">Read all reviews</a>
      <div class="tp-invitation">
        <span>Already a student? Share your experience.</span>
        <a class="tp-button tp-secondary" href="https://www.trustpilot.com/evaluate/daniellarsontraining.com">Leave a review</a>
      </div>
    </div>
  </div>
</section>

<style>
  .tp-section {
    padding: 64px 0;
    background: #f4f8fd;
    color: #0b1f3a;
    scroll-margin-top: 145px;
  }
  .tp-container {
    width: min(1180px, calc(100% - 40px));
    margin-inline: auto;
  }
  .tp-heading { max-width: 820px; margin-bottom: 28px; }
  .tp-eyebrow {
    margin: 0 0 12px;
    color: #1766c7;
    font-size: .72rem;
    font-weight: 900;
    letter-spacing: .11em;
  }
  .tp-heading h2 {
    margin: 0;
    font-size: clamp(1.9rem, 3.5vw, 2.8rem);
    line-height: 1.08;
    letter-spacing: -.035em;
  }
  .tp-intro { margin: 14px 0 0; color: #53667d; line-height: 1.6; }
  .tp-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
  .tp-card {
    display: flex;
    flex-direction: column;
    padding: 25px;
    border: 1px solid #dbe5f1;
    border-radius: 15px;
    background: #fff;
    box-shadow: 0 10px 28px rgba(6,28,54,.04);
  }
  .tp-stars { color: #1766c7; font-size: 1.15rem; line-height: 1; letter-spacing: .12em; }
  .tp-card blockquote { margin: 18px 0 24px; }
  .tp-card blockquote p { margin: 0; font-size: 1.13rem; font-weight: 650; line-height: 1.5; }
  .tp-attribution { display: flex; flex-direction: column; gap: 5px; margin-top: auto; }
  .tp-attribution strong { font-size: .87rem; }
  .tp-attribution time { color: #63758a; font-size: .77rem; }
  .tp-attribution a { margin-top: 9px; color: #155eae; font-weight: 800; font-size: .82rem; text-underline-offset: 3px; }
  .tp-actions { display: flex; justify-content: space-between; align-items: center; gap: 24px; margin-top: 26px; }
  .tp-button { display: inline-flex; justify-content: center; align-items: center; min-height: 46px; padding: 11px 17px; border: 1px solid transparent; border-radius: 9px; font-weight: 850; font-size: .88rem; text-decoration: none; }
  .tp-primary { background: #1766c7; color: #fff; }
  .tp-primary:hover { background: #0f55ab; }
  .tp-secondary { border-color: #bfd0e5; background: #fff; color: #155eae; }
  .tp-secondary:hover { border-color: #1766c7; background: #edf5ff; }
  .tp-invitation { display: flex; align-items: center; gap: 15px; }
  .tp-invitation span { max-width: 260px; color: #53667d; font-size: .84rem; line-height: 1.5; }
  @media (max-width: 800px) {
    .tp-grid { grid-template-columns: 1fr; gap: 13px; }
    .tp-card { padding: 22px; }
    .tp-card blockquote { margin-bottom: 19px; }
    .tp-actions { align-items: flex-start; }
    .tp-invitation { align-items: flex-start; flex-direction: column; gap: 10px; }
  }
  @media (max-width: 520px) {
    .tp-section { padding: 48px 0; }
    .tp-container { width: calc(100% - 28px); }
    .tp-actions { flex-direction: column; gap: 20px; }
    .tp-primary { width: 100%; }
    .tp-invitation { width: 100%; }
    .tp-invitation span { max-width: none; }
    .tp-secondary { width: 100%; }
  }
</style>
