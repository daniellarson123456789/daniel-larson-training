---
import { licensingSale } from "../data/products";

const path = Astro.url.pathname;
const isBroker = path.includes("broker");
const packageLink = path === "/" || path === "/broker-licensing/"
  ? "#packages"
  : `${isBroker ? "/broker-licensing/" : "/"}#packages`;
---

<aside class="licensing-sale" aria-label="50 percent off licensing and certification sale">
  <div class="sale-inner">
    <div class="sale-discount" aria-label="50 percent off">
      <span>50<span class="sale-percent">%</span></span><strong>OFF</strong>
    </div>
    <div class="sale-message">
      <span class="sale-eyebrow">LICENSING + CERTIFICATION SALE</span>
      <p>Your course. <strong>Half the price.</strong></p>
      <span class="sale-scope">All six sales &amp; broker licensing packages.</span>
    </div>
    <div class="sale-actions">
      <button class="sale-code" type="button" data-copy-sale-code={licensingSale.code} aria-label={`Copy sale code ${licensingSale.code}`}>
        <span>Use code</span><strong>{licensingSale.code}</strong>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><rect x="8" y="8" width="12" height="13" rx="2" fill="none" stroke="currentColor" stroke-width="1.7"/><path d="M15 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h3" fill="none" stroke="currentColor" stroke-width="1.7"/></svg>
      </button>
      <a href={packageLink}>Shop the sale <span aria-hidden="true">→</span></a>
      <span class="sale-copy-status" role="status" aria-live="polite"></span>
    </div>
  </div>
</aside>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-copy-sale-code]").forEach((button) => {
    button.addEventListener("click", async () => {
      const status = button.parentElement?.querySelector("[role='status']");
      try {
        await navigator.clipboard.writeText(button.dataset.copySaleCode!);
        if (status) status.textContent = "Code copied!";
      } catch {
        if (status) status.textContent = `Enter ${button.dataset.copySaleCode} at checkout.`;
      }
    });
  });
</script>

<style>
  .licensing-sale { position: relative; isolation: isolate; overflow: hidden; color: #fff; background: radial-gradient(ellipse at 30% 0%, #378bff 0%, transparent 62%), linear-gradient(110deg, #134ba3, #1154be 54%, #092d74); border-bottom: 1px solid #72b5ff; }
  .licensing-sale::before { content: ""; position: absolute; z-index: -1; width: 430px; height: 430px; right: 14%; top: -270px; border: 1px solid #ffffff29; border-radius: 50%; box-shadow: 0 0 0 42px #ffffff08, 0 0 0 84px #ffffff06; }
  .sale-inner { width: min(1180px, calc(100% - 40px)); margin: auto; display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 30px; padding: 23px 0; }
  .sale-discount { display: flex; align-items: center; gap: 10px; padding-right: 30px; border-right: 1px solid #ffffff50; white-space: nowrap; }
  .sale-discount > span { font-size: clamp(54px, 6vw, 76px); font-weight: 950; line-height: .95; letter-spacing: -.065em; text-shadow: 0 4px 24px #001b4d55; }
  .sale-percent { font-size: .55em; vertical-align: top; line-height: 1.3; letter-spacing: -.035em; }
  .sale-discount > strong { font-size: 20px; writing-mode: vertical-rl; transform: rotate(180deg); letter-spacing: .12em; }
  .sale-eyebrow { font-size: 10px; font-weight: 850; letter-spacing: .14em; color: #d9ecff; }
  .sale-message p { font-size: clamp(21px, 2.1vw, 29px); line-height: 1.15; margin: 5px 0 6px; letter-spacing: -.025em; }
  .sale-message strong { font-weight: 900; }
  .sale-scope { color: #e0eeff; font-size: 13px; }
  .sale-actions { position: relative; display: grid; justify-items: center; gap: 8px; }
  .sale-code { display: inline-flex; align-items: center; gap: 10px; padding: 12px 16px; border: 1px dashed #a6d5ff; border-radius: 9px; background: #06285985; color: #fff; cursor: pointer; box-shadow: 0 4px 18px #06295730; }
  .sale-code > span { font-size: 11px; color: #d2e7ff; }
  .sale-code strong { font-size: 19px; letter-spacing: .035em; font-weight: 850; }
  .sale-code:hover { background: #062859; border-color: #fff; }
  .sale-actions a { color: #fff; font-size: 12px; font-weight: 800; text-decoration: none; }
  .sale-actions a:hover { text-decoration: underline; }
  .sale-copy-status { position: absolute; top: 100%; padding-top: 2px; font-size: 11px; color: #e3f1ff; text-align: center; }
  @media (prefers-reduced-motion: no-preference) {
    .sale-discount { animation: sale-arrive .65s ease-out both; }
    @keyframes sale-arrive { from { opacity: .3; transform: translateY(7px); } to { opacity: 1; transform: translateY(0); } }
  }
  @media (max-width: 900px) {
    .sale-inner { gap: 18px; }
    .sale-discount { padding-right: 18px; }
    .sale-code { gap: 7px; padding: 10px 12px; }
    .sale-code strong { font-size: 16px; }
    .sale-code > span { display: none; }
  }
  @media (max-width: 620px) {
    .sale-inner { grid-template-columns: auto 1fr; gap: 14px; padding: 18px 0 23px; }
    .sale-discount { padding-right: 14px; gap: 5px; }
    .sale-discount > span { font-size: 54px; }
    .sale-discount > strong { font-size: 13px; }
    .sale-eyebrow { font-size: 9px; letter-spacing: .09em; }
    .sale-message p { font-size: 21px; margin: 5px 0; }
    .sale-message strong { display: block; }
    .sale-scope { font-size: 11px; display: block; line-height: 1.35; }
    .sale-actions { grid-column: 1 / -1; display: flex; flex-wrap: wrap; justify-content: center; gap: 10px 20px; }
    .sale-code > span { display: inline; }
    .sale-code { padding: 8px 12px; }
    .sale-copy-status { left: 0; right: 0; }
  }
</style>
