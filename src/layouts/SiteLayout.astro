---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SiteMotion from "../components/SiteMotion.astro";
import { site } from "../data/site";
import "../styles/global.css";
import "../styles/interactions.css";

type Props = {
  title: string;
  description: string;
  canonicalPath?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  robots?: string;
  ogImage?: string;
  shareTitle?: string;
};

const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
  schema = [],
  robots,
  ogImage = "/social-share.png",
  shareTitle = title,
} = Astro.props;

const canonical = new URL(canonicalPath, site.url).toString();
const socialImage = new URL(ogImage, site.url).toString();
const allowIndex = import.meta.env.PUBLIC_SITE_ENV === "production";
const robotsContent = robots ?? (allowIndex
  ? "index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1"
  : "noindex,nofollow");

const globalGraph = [
  {
    "@type": "EducationalOrganization",
    "@id": `${site.url}/#organization`,
    name: site.name,
    url: site.url,
    telephone: site.phoneDisplay,
    email: site.email,
    identifier: {
      "@type": "PropertyValue",
      name: "Florida Licensed Real Estate School",
      value: site.schoolLicense,
    },
  },
  {
    "@type": "Person",
    "@id": `${site.url}/#daniel-larson`,
    name: site.instructorName,
    worksFor: { "@id": `${site.url}/#organization` },
    identifier: {
      "@type": "PropertyValue",
      name: "Florida Real Estate Instructor",
      value: site.instructorLicense,
    },
  },
  {
    "@type": "WebSite",
    "@id": `${site.url}/#website`,
    url: site.url,
    name: site.name,
    publisher: { "@id": `${site.url}/#organization` },
  },
];

const pageSchema = Array.isArray(schema) ? schema : [schema];
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [...globalGraph, ...pageSchema.filter(Boolean)],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={robotsContent} />
    <meta name="theme-color" content="#080426" />
    <meta name="color-scheme" content="light" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/fastpass-icon-192.png" type="image/png" />
    <link rel="apple-touch-icon" href="/fastpass-icon-192.png" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={shareTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Daniel Larson Training — Florida Real Estate Education" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={shareTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />

    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
    {allowIndex && (
      <>
        <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-2DMNXG3KHZ"></script>
        <script is:inline>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', 'G-2DMNXG3KHZ');
        </script>
      </>
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <SiteMotion />
  </body>
</html>
