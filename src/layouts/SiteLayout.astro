---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SiteMotion from "../components/SiteMotion.astro";
import { site } from "../data/site";
import { breadcrumbList, enrichSchemaNode, globalGraph } from "../lib/seo";
import { resolveOg, stripPrices } from "../data/og";
import "../styles/global.css";
import "../styles/interactions.css";

type Props = {
  title: string;
  description: string;
  canonicalPath?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  robots?: string;
  ogImage?: string;
  shareTitle?: string;
};

const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
  schema = [],
  robots,
  ogImage,
  shareTitle,
} = Astro.props;

const og = resolveOg(canonicalPath, title, description);
const resolvedShareTitle = stripPrices(shareTitle ?? og.title);
const resolvedShareDescription = stripPrices(og.description);
const resolvedOgImage = ogImage ?? og.image;
const resolvedOgAlt = og.alt;

const canonical = new URL(canonicalPath, site.url).toString();
const socialImage = new URL(resolvedOgImage, site.url).toString();
const preview = process.env.VERCEL_ENV === "preview" || import.meta.env.PUBLIC_SITE_PREVIEW === "true";
const allowIndex = !preview && import.meta.env.PUBLIC_SITE_ENV === "production";
const allowAnalytics = allowIndex && (!process.env.VERCEL_ENV || process.env.VERCEL_ENV === "production");
const robotsContent = robots ?? (allowIndex
  ? "index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1"
  : "noindex,nofollow");
const noindex = /\bnoindex\b/i.test(robotsContent);
const isErrorPage = canonicalPath === "/404" || canonicalPath === "/404/";

const pageSchema = (Array.isArray(schema) ? schema : [schema])
  .filter(Boolean)
  .map((node) => enrichSchemaNode(node as Record<string, unknown>));
const graph = [
  ...globalGraph(),
  ...pageSchema,
  ...(!noindex && !isErrorPage ? [breadcrumbList(canonicalPath, title)] : []),
];
const structuredData = {
  "@context": "https://schema.org",
  "@graph": graph,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={robotsContent} />
    <meta name="msvalidate.01" content="AD90B38F7C0E7E7C04FA27D5710FE8FF" />
    <meta name="theme-color" content="#080426" />
    <meta name="color-scheme" content="light" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/fastpass-icon-192.png" type="image/png" />
    <link rel="apple-touch-icon" href="/fastpass-icon-192.png" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={resolvedShareTitle} />
    <meta property="og:description" content={resolvedShareDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={resolvedOgAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={resolvedShareTitle} />
    <meta name="twitter:description" content={resolvedShareDescription} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={resolvedOgAlt} />
    <link rel="alternate" type="text/plain" href={`${site.url}/llms.txt`} title="LLM content source" />

    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
    {allowAnalytics && (
      <>
        <script is:inline>
          (() => {
            if (!['realestatefastpass.com', 'www.realestatefastpass.com', 'daniellarsontraining.com', 'www.daniellarsontraining.com'].includes(location.hostname)) return;
            window.dataLayer = window.dataLayer || [];
            window.gtag = window.gtag || function(){window.dataLayer.push(arguments);};
            window.gtag('set', 'linker', {
              domains: ['realestatefastpass.com', 'portal.daniellarsontraining.com'],
              accept_incoming: true
            });
            window.gtag('js', new Date());
            window.gtag('config', 'G-2DMNXG3KHZ');
            const script = document.createElement('script');
            script.async = true;
            script.src = 'https://www.googletagmanager.com/gtag/js?id=G-2DMNXG3KHZ';
            document.head.appendChild(script);
          })();
        </script>
      </>
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <SiteMotion />
  </body>
</html>
