---
import SiteLayout from "../layouts/SiteLayout.astro";
import { site } from "../data/site";
import "../styles/draft-sales.css";
---

<SiteLayout
  title="Student Sign In | Real Estate FastPass"
  description="Sign in to your Daniel Larson Training student account."
  canonicalPath="/course-portal/"
  robots="noindex,nofollow"
>
  <div class="draft-sales">
    <section class="draft-hero">
      <div class="wrap" style="text-align:center;max-width:40rem;">
        <p class="draft-kicker" style="justify-content:center;">
          <span class="draft-brand">{site.name}</span>
        </p>
        <h1>Student Sign In</h1>
        <p class="lead">Course access is in your student account. Sign in to continue.</p>
        <div class="draft-hero-actions" style="justify-content:center;">
          <a class="draft-btn primary" href={site.studentHubUrl}>Go to Student Sign In</a>
        </div>
      </div>
    </section>
  </div>
  <script define:vars={{ dest: site.studentHubUrl }}>
    window.location.replace(dest);
  </script>
</SiteLayout>
