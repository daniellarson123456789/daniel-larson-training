---
import SiteLayout from "../layouts/SiteLayout.astro";
import TrustpilotReviews from "../components/TrustpilotReviews.astro";
import { site } from "../data/site";
import "../styles/draft-sales.css";

const schema = [
  {
    "@type": "AboutPage",
    "@id": `${site.url}/about/#webpage`,
    url: `${site.url}/about/`,
    name: "About FastPass | Daniel Larson Training",
    isPartOf: { "@id": `${site.url}/#website` },
    publisher: { "@id": `${site.url}/#organization` },
    inLanguage: "en-US",
  },
];
---

<SiteLayout
  title="About FastPass | Daniel Larson Training"
  description="FastPass means self-empowerment: a framework to choose your path. Florida Course 1, Course 2, Post-Licensing, 14-Hour CE, and exam prep from Daniel Larson Training."
  canonicalPath="/about/"
  schema={schema}
>
  <div class="draft-sales">
    <section class="draft-hero">
      <div class="wrap why-grid about-owner">
        <img class="why-photo about-owner-photo" src="/daniel-larson-suit.webp" alt="Daniel Larson" width="720" height="1080" loading="eager" decoding="async" />
        <div class="about-copy">
          <p class="draft-kicker">
            <span class="draft-brand">{site.name}</span>
            <span class="draft-school">{site.tagline}</span>
          </p>
          <h1>FastPass means<br />self-empowerment.</h1>
          <p class="lead">FastPass grew out of years of working with Course 1 students, training trainers, and getting course content approved for Florida licensure and continuing education.</p>
          <p>I built it the way I’d want to learn — with all the content available, but with the student deciding what to cover, what to review, how, and when. You set the pace and the style:</p>
          <ul class="about-formats">
            <li>Listen to the audio</li>
            <li>Read the PDF or the full textbook</li>
            <li>Work through the interactive workbook</li>
            <li>Watch long-form explainer videos</li>
            <li>Drill review questions with detailed explanations</li>
          </ul>
          <p>Want a printed workbook? Just ask and we’ll send one free through Amazon. And broker students ALWAYS get the Course 2 textbook and the FastPass workbook.</p>
          <div class="draft-hero-actions">
            <a class="draft-btn primary" href="/">Explore licensing courses</a>
            <a class="draft-link-secondary" href="sms:+12394718500">Text me</a>
          </div>
        </div>
      </div>
    </section>

    <section class="draft-section navy" id="background">
      <div class="wrap why-grid">
        <img class="why-photo" src="/daniel-larson-teaching.webp" alt="Teaching a Florida real estate class" width="1200" height="800" loading="lazy" decoding="async" />
        <div>
          <h2>I've spent more than two decades in real estate education.</h2>
          <p class="intro">That work has included teaching licensing material, training instructors and agents, writing course content, and working directly with students preparing for Florida licensing and renewal.</p>
          <p class="intro">Before Daniel Larson Training, it also included national training leadership with Kaplan, work with Larson Educational Services, classroom instruction, and publishing.</p>
        </div>
      </div>
    </section>

    <section class="draft-section">
      <div class="wrap">
        <h2>Courses</h2>
        <p class="intro">Florida Course 1, Course 2, Post-Licensing, 14-Hour CE, and exam prep — including FastPass.</p>
        <ol class="draft-bundle">
          <li><span class="num">1</span><div><h3>Sales Associate Licensing</h3><p>Florida Course 1, study resources, exam preparation, and FastPass.</p></div></li>
          <li><span class="num">2</span><div><h3>Broker Licensing</h3><p>Florida Course 2, broker exam preparation, and Broker FastPass. Broker students always get the Course 2 textbook and the FastPass workbook.</p></div></li>
          <li><span class="num">P</span><div><h3>Post-Licensing</h3><p>Sales and Broker first-renewal education.</p></div></li>
          <li><span class="num">CE</span><div><h3>14-Hour Continuing Education</h3><p>Florida renewal education for Sales Associates and Brokers after the Post-Licensing stage.</p></div></li>
          <li><span class="num">F</span><div><h3>FastPass Exam Prep</h3><p>Focused Florida exam preparation for Sales Associate and Broker candidates.</p></div></li>
        </ol>
      </div>
    </section>

    <TrustpilotReviews />

    <section class="draft-section soft">
      <div class="wrap why-grid">
        <div>
          <h2>Questions? Ask me.</h2>
          <p class="intro">Call, text, or email about licensing, Post, CE, exam prep, or which course applies. If you run a Florida brokerage or agent team and want to partner with the school, see <a href="/broker-connection/">Find a Broker</a>.</p>
        </div>
        <aside class="price-card">
          <h3>{site.schoolName}</h3>
          <p class="note"><a href="tel:+12394718500">{site.phoneDisplay}</a><br /><a href={`mailto:${site.email}`}>{site.email}</a></p>
          <p class="note">Florida Licensed Real Estate School #{site.schoolLicense}<br />{site.instructorName} · Florida Real Estate Instructor #{site.instructorLicense}</p>
        </aside>
      </div>
    </section>

    <section class="draft-section navy final-cta">
      <div class="wrap">
        <div class="draft-hero-actions" style="justify-content:center;">
          <a class="draft-btn primary" href="/">Explore licensing courses</a>
          <a class="draft-btn primary" style="background:#fff;color:#0a1236;" href={site.studentHubUrl}>Student Sign In</a>
        </div>
      </div>
    </section>
  </div>
</SiteLayout>
