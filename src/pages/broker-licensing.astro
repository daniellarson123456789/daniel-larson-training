---
import SiteLayout from "../layouts/SiteLayout.astro";
import TrustpilotReviews from "../components/TrustpilotReviews.astro";
import CheckoutNote from "../components/CheckoutNote.astro";
import { products, salePrice } from "../data/products";
import { courseOffer } from "../lib/courseOffer";
import { site } from "../data/site";
import { faqPage } from "../lib/seo";
import "../styles/draft-sales.css";

const pageTitle = "Florida Broker License Course | Real Estate FastPass";
const pageDescription = `Florida 72-hour Course 2 $${salePrice(products.brokerCourse2)}; Broker FastPass $${salePrice(products.brokerFastPass)}; Full Package $${salePrice(products.brokerCareerLaunch)}. Broker FastPass is self-paced, with no lesson clock, and three exams built to closely match the Pearson broker exam; pass all three and you’re certified to take it. One-year access and direct support.`;

const schema = [
  {
    "@type": "Course",
    "@id": "https://realestatefastpass.com/broker-licensing/#course2",
    "name": "Florida 72-Hour Broker Pre-License Course (Course 2)",
    "description": `${pageDescription} FastPass includes certification exams, 500+ questions and explanations, audio/video instruction, and a digital workbook. Every licensing package includes one-year access and direct instructor support. Broker students always get the Course 2 textbook and the FastPass workbook. Want a printed copy? Just ask and we'll send one free through Amazon.`,
    "provider": { "@id": "https://realestatefastpass.com/#organization" },
    "inLanguage": "en-US",
    "offers": [
      courseOffer(products.brokerCourse2, "Broker Course 2 + Traditional Final"),
      courseOffer(products.brokerFastPass, "Broker Course 2 + FastPass"),
      courseOffer(products.brokerCareerLaunch, "Full Package: Broker FastPass + 60-Hour Post-Licensing"),
    ]
  },
  {
    "@type": "WebPage",
    "@id": "https://realestatefastpass.com/broker-licensing/#webpage",
    "url": "https://realestatefastpass.com/broker-licensing/",
    "name": pageTitle,
    "description": pageDescription,
    "isPartOf": { "@id": "https://realestatefastpass.com/#website" },
    "about": { "@id": "https://realestatefastpass.com/broker-licensing/#course2" },
    "publisher": { "@id": "https://realestatefastpass.com/#organization" },
    "inLanguage": "en-US"
  },
  faqPage("https://realestatefastpass.com/broker-licensing/#faq", [
    { name: "How much is the Florida 72-hour broker course?", text: `Course 2 is $${salePrice(products.brokerCourse2)}. Includes the complete DBPR-approved 72-hour course, traditional final, and Exam Math Basics. One-time enrollment includes one year of access and direct instructor support. State application, fingerprinting, and state-exam fees are separate.` },
    { name: "What is included in the Broker FastPass package?", text: `Broker FastPass is $${salePrice(products.brokerFastPass)}. The package includes the DBPR-approved 72-hour Broker Course 2, three FastPass certification exams, Exam Math Basics, 500+ practice questions and explanations, audio ebook review, the FastPass Workbook online and as a PDF, one year of access, and direct support.` },
    { name: "How is Broker FastPass different?", text: "Broker FastPass for the Florida broker license is three certification exams built to closely match the content on the Pearson broker exam, used in place of the traditional Course 2 final. Pass all three and you’re certified to take the Florida broker exam, so course certification and state-exam prep happen at the same time. Course 2 with the traditional final uses a standard course final instead. Broker FastPass is self-paced, so you take the exams when you’re ready, and you still take the Florida broker licensing exam separately." },
    { name: "What’s the fastest way to get my Florida broker license?", text: "The fastest way to get your Florida broker license with Real Estate FastPass is to work through Broker FastPass at your own pace instead of on a lesson clock. Broker FastPass pairs the self-paced 72-hour Course 2 with three certification exams built to closely match the content on the Pearson broker exam, and once you pass all three, you’re certified to take the Florida broker exam. There are no page timers or forced lesson stops, so students who already know the material can go straight to the Broker FastPass exams, and Course 2, the textbook, and the workbook are there for anything they want to brush up on." },
    { name: "Do I have to sit through 72 hours of timed videos?", text: "No. Broker FastPass for the Florida broker license is self-paced, with no timed videos, lesson clock, or page timers. Take the three Broker FastPass exams, built to closely match the content on the Pearson broker exam, when you’re ready, and once you pass all three, you’re certified to take the Florida broker exam. Course 2, the audio review, the textbook, and the workbook are there for anything you want to review." },
    { name: "Can I go straight to the Broker FastPass exams?", text: "Yes. Broker FastPass for the Florida broker license is self-paced, with no lesson clock or page timers, so you can take the three Broker FastPass exams whenever you’re ready. Course 2, the textbook, and the workbook are there for whatever you want to review. Passing all three certifies you to take the Florida broker exam, which you still take separately." },
    { name: "Does FastPass replace the Florida broker licensing exam?", text: "No. The Florida broker licensing exam is a separate exam administered through Pearson Professional Assessments (formerly Pearson VUE). FastPass is preparation and part of the Course 2 certification path; you still take the state exam separately." },
    { name: "What is the Full Package with FastPass + Post?", text: `The Full Package is $${salePrice(products.brokerCareerLaunch)}. Includes Course 2, Broker FastPass, and your required 60-hour Broker Post-Licensing course. Broker students always get the Course 2 textbook and the FastPass workbook. Want a printed copy? Just ask and we'll send one free through Amazon.` },
    { name: "Do broker students get the textbooks?", text: "Broker students always get the Course 2 textbook and the FastPass workbook, to read online or download as a PDF. Want a printed copy? Just ask and we'll send one free through Amazon." },
    { name: "How long do I have access?", text: "Broker course bundles include one year of online access." },
    { name: "Can I contact the school directly?", text: "Yes. Text or email us at 239.471.8500 or daniel@daniellarsontraining.com about broker licensing, exam preparation, post-licensing, or your next licensing step." },
  ]),
];
---

<SiteLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath="/broker-licensing/"
  schema={schema}
>
  <div class="draft-sales">

    <section class="draft-hero">
      <div class="wrap draft-hero-grid">
        <div class="draft-hero-intro">
          <p class="draft-kicker">
            <span class="draft-brand">{site.name}</span>
            <span class="draft-school">{site.tagline}</span>
          </p>
          <h1>Get your Florida broker license with FastPass.</h1>
          <p class="lead">Self-paced Course 2, with no lesson clock, and three Broker FastPass exams built to closely match the content on the Pearson broker exam. Pass all three and you’re certified to take the state exam, so you get certified while you prep for it.</p>
          <a class="draft-link-more" href="#whats-included">See what’s included <span aria-hidden="true">→</span></a>
        </div>
        <aside class="draft-hero-panel">
          <div class="draft-hero-price">${salePrice(products.brokerFastPass)}<span>Most popular · one-time enrollment</span></div>
          <h2>The complete broker licensing path.</h2>
          <p>Course 2, FastPass certification exams that mirror the state exam, the Course 2 textbook and FastPass workbook, plus direct support.</p>
          <a class="draft-btn primary" data-plan={products.brokerFastPass.id} data-placement="hero_panel" href={products.brokerFastPass.checkoutUrl} target="_top">Start Broker FastPass — ${salePrice(products.brokerFastPass)}</a>
          <CheckoutNote />
        </aside>
      </div>
    </section>

    <section class="draft-section" id="whats-included">
      <div class="wrap">
        <p class="draft-eyebrow">What you get</p>
        <h2>What you get with Broker FastPass</h2>
        <p class="intro">Here’s what’s included — the complete Broker FastPass bundle.</p>
        <ol class="draft-bundle">
          <li id="include-course-2">
            <span class="num">1</span>
            <div>
              <h3>Course 2 (DBPR-approved 72-hour)</h3>
              <p>The required Florida broker pre-license course.</p>
            </div>
          </li>
          <li id="include-textbook">
            <span class="num">2</span>
            <div>
              <h3>Course 2 textbook</h3>
              <p>Broker students always get the Course 2 textbook, to read online or download as a PDF. Want a printed copy? Just ask and we&apos;ll send one free through Amazon.</p>
            </div>
          </li>
          <li id="include-workbook">
            <span class="num">3</span>
            <div>
              <h3>FastPass Workbook (online + PDF)</h3>
              <p>The FastPass workbook is included to read online or download as a PDF. Want a printed copy? Just ask and we&apos;ll send one free through Amazon.</p>
            </div>
          </li>
          <li id="include-certification">
            <span class="num">4</span>
            <div>
              <h3>FastPass Certification (three certification exams)</h3>
              <p>Three FastPass certification exams that mirror the state exam, in place of the traditional course final. Certification and exam prep happen together.</p>
            </div>
          </li>
          <li id="include-audio">
            <span class="num">5</span>
            <div>
              <h3>Audio Ebook Review</h3>
              <p>Listen through the review when you can’t sit down with the workbook.</p>
            </div>
          </li>
          <li id="include-math">
            <span class="num">6</span>
            <div>
              <h3>Exam Math Basics</h3>
              <p>The math you’ll need for the course and the state exam, explained clearly.</p>
            </div>
          </li>
          <li id="include-sample-questions">
            <span class="num">7</span>
            <div>
              <h3>500 Sample Q&amp;A with explanations</h3>
              <p>Practice questions with answers and explanations, so you can see why an answer is right.</p>
            </div>
          </li>
          <li id="include-access">
            <span class="num">8</span>
            <div>
              <h3>One year of access</h3>
              <p>Broker FastPass includes one year of online access.</p>
            </div>
          </li>
          <li id="include-support">
            <span class="num">9</span>
            <div>
              <h3>Direct support</h3>
              <p>Text or email us when you get stuck. There is no call center.</p>
            </div>
          </li>
        </ol>
      </div>
    </section>

    <section class="draft-section soft" id="pricing">
      <div class="wrap">
        <p class="draft-eyebrow">Pricing</p>
        <h2>Choose your broker licensing package</h2>
        <p class="intro">Three options. Broker FastPass is the complete path most students choose.</p>
        <div class="price-grid">
          <article class="price-card">
            <h3>Course 2 + Traditional Final</h3>
            <div class="price">${salePrice(products.brokerCourse2)}</div>
            <p class="note">FastPass gets you certified and ready for the state exam at the same time, for just $80 more.</p>
            <a class="draft-btn navy" data-plan={products.brokerCourse2.id} data-placement="pricing_card" href={products.brokerCourse2.checkoutUrl} target="_top">Enroll — ${salePrice(products.brokerCourse2)}</a>
            <CheckoutNote />
          </article>
          <article class="price-card popular">
            <span class="price-badge">MOST POPULAR</span>
            <h3>Broker FastPass</h3>
            <div class="price">${salePrice(products.brokerFastPass)}</div>
            <p class="note">The full Broker FastPass bundle: Course 2, certification exams that mirror the state exam, the Course 2 textbook and FastPass workbook, audio review, math basics, and 500 sample questions. Certification and exam prep happen together. Want a printed copy? Just ask and we&apos;ll send one free through Amazon.</p>
            <a class="draft-btn primary" data-plan={products.brokerFastPass.id} data-placement="pricing_card" href={products.brokerFastPass.checkoutUrl} target="_top">Start Broker FastPass — ${salePrice(products.brokerFastPass)}</a>
            <CheckoutNote />
          </article>
          <article class="price-card">
            <h3>Full Package</h3>
            <div class="price">${salePrice(products.brokerCareerLaunch)}</div>
            <p class="note">Best value: your required Post-Licensing course is included at a bundle price, ready for when you&apos;re licensed, before your first renewal.</p>
            <a class="draft-btn navy" data-plan={products.brokerCareerLaunch.id} data-placement="pricing_card" href={products.brokerCareerLaunch.checkoutUrl} target="_top">Enroll — ${salePrice(products.brokerCareerLaunch)}</a>
            <CheckoutNote />
          </article>
        </div>
      </div>
    </section>

    <TrustpilotReviews context="broker" />

    <section class="draft-section soft" id="faq">
      <div class="wrap">
        <p class="draft-eyebrow">Questions</p>
        <h2>Florida Broker Licensing FAQ</h2>
        <div class="faq-list">
          <details><summary>How much is the Florida 72-hour broker course?</summary><p>Course 2 is <strong>${salePrice(products.brokerCourse2)}</strong>. Includes the complete DBPR-approved 72-hour course, traditional final, and Exam Math Basics. One-time enrollment includes one year of access and direct instructor support. State application, fingerprinting, and state-exam fees are separate.</p></details>
          <details><summary>What is included in the Broker FastPass package?</summary><p>Broker FastPass is <strong>${salePrice(products.brokerFastPass)}</strong>. The package includes the DBPR-approved 72-hour Broker Course 2, three FastPass certification exams, Exam Math Basics, 500+ practice questions and explanations, audio ebook review, the FastPass Workbook online and as a PDF, one year of access, and direct support.</p></details>
          <details><summary>How is Broker FastPass different?</summary><p>Broker FastPass for the Florida broker license is three certification exams built to closely match the content on the Pearson broker exam, used in place of the traditional Course 2 final. Pass all three and you’re certified to take the Florida broker exam, so course certification and state-exam prep happen at the same time. Course 2 with the traditional final uses a standard course final instead. Broker FastPass is self-paced, so you take the exams when you’re ready, and you still take the Florida broker licensing exam separately.</p></details>
          <details><summary>What’s the fastest way to get my Florida broker license?</summary><p>The fastest way to get your Florida broker license with Real Estate FastPass is to work through Broker FastPass at your own pace instead of on a lesson clock. Broker FastPass pairs the self-paced 72-hour Course 2 with three certification exams built to closely match the content on the Pearson broker exam, and once you pass all three, you’re certified to take the Florida broker exam. There are no page timers or forced lesson stops, so students who already know the material can go straight to the Broker FastPass exams, and Course 2, the textbook, and the workbook are there for anything they want to brush up on.</p></details>
          <details><summary>Do I have to sit through 72 hours of timed videos?</summary><p>No. Broker FastPass for the Florida broker license is self-paced, with no timed videos, lesson clock, or page timers. Take the three Broker FastPass exams, built to closely match the content on the Pearson broker exam, when you’re ready, and once you pass all three, you’re certified to take the Florida broker exam. Course 2, the audio review, the textbook, and the workbook are there for anything you want to review.</p></details>
          <details><summary>Can I go straight to the Broker FastPass exams?</summary><p>Yes. Broker FastPass for the Florida broker license is self-paced, with no lesson clock or page timers, so you can take the three Broker FastPass exams whenever you’re ready. Course 2, the textbook, and the workbook are there for whatever you want to review. Passing all three certifies you to take the Florida broker exam, which you still take separately.</p></details>
          <details><summary>Does FastPass replace the Florida broker licensing exam?</summary><p>No. The Florida broker licensing exam is a separate exam administered through <a href="https://www.pearsonvue.com/us/en/fl/dbpr.html" rel="noopener" target="_blank">Pearson Professional Assessments</a> (formerly Pearson VUE). FastPass is preparation and part of the Course 2 certification path; you still take the state exam separately.</p></details>
          <details><summary>What is the Full Package with FastPass + Post?</summary><p>The Full Package is <strong>${salePrice(products.brokerCareerLaunch)}</strong>. Includes Course 2, Broker FastPass, and your required 60-hour Broker Post-Licensing course. Broker students always get the Course 2 textbook and the FastPass workbook. Want a printed copy? Just ask and we&apos;ll send one free through Amazon.</p></details>
          <details><summary>Do broker students get the textbooks?</summary><p>Broker students always get the Course 2 textbook and the FastPass workbook, to read online or download as a PDF. Want a printed copy? Just ask and we&apos;ll send one free through Amazon.</p></details>
          <details><summary>How long do I have access?</summary><p>Broker course bundles include one year of online access.</p></details>
          <details><summary>Can I contact the school directly?</summary><p>Yes. Text or email us at <a href="sms:+12394718500">239.471.8500</a> or <a href="mailto:daniel@daniellarsontraining.com">daniel@daniellarsontraining.com</a> about broker licensing, exam preparation, post-licensing, or your next licensing step.</p></details>
        </div>
      </div>
    </section>

    <section class="draft-section navy final-cta">
      <div class="wrap">
        <h2>Ready to get your Florida broker license?</h2>
        <span class="checkout-cta">
          <a class="draft-btn primary" data-plan={products.brokerFastPass.id} data-placement="final_cta" href={products.brokerFastPass.checkoutUrl} target="_top">Start Broker FastPass — ${salePrice(products.brokerFastPass)}</a>
          <CheckoutNote />
        </span>
      </div>
    </section>
  </div>
</SiteLayout>
