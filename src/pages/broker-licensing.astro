<tr><th scope="row">Audio ebook review</th><td class="dash">—</td><td class="yes best">✓ Included</td><td class="yes">✓ Included</td></tr>
<tr><th scope="row">500+ Q&amp;A and explanations</th><td class="dash">—</td><td class="yes best">✓ Included</td><td class="yes">✓ Included</td></tr>
