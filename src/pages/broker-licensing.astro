<th class="best-head" scope="col">FastPass<small>${salePrice(products.brokerFastPass)} with {products.brokerFastPass.couponCode}<br />Regularly ${products.brokerFastPass.price} · Save ${products.brokerFastPass.discountAmount}</small></th>
