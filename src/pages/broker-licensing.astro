---
import SiteLayout from "../layouts/SiteLayout.astro";
import TrustpilotReviews from "../components/TrustpilotReviews.astro";
import TrustpilotReviewLink from "../components/TrustpilotReviewLink.astro";
import SalePrice from "../components/SalePrice.astro";
import { products, salePrice } from "../data/products";
import { courseOffer } from "../lib/courseOffer";
import "../styles/licensing-parity.css";

const pageTitle = `Florida Broker License Course $${salePrice(products.brokerCourse2)} with Code | Daniel Larson Training`;
const pageDescription = `Florida 72-hour broker course $${salePrice(products.brokerCourse2)} with ${products.brokerCourse2.couponCode}; FastPass $${salePrice(products.brokerFastPass)} with ${products.brokerFastPass.couponCode}; Full Package with 60-hour post $${salePrice(products.brokerCareerLaunch)} with ${products.brokerCareerLaunch.couponCode}. One-time tuition.`;

const schema = [
  {
    "@type": "Course",
    "@id": "https://daniellarsontraining.com/broker-licensing/#course2",
    "name": "Florida 72-Hour Broker Pre-License Course (Course 2)",
    "description": `${pageDescription} FastPass includes certification exams, 500+ questions and explanations, audio/video instruction, and a digital workbook. Every licensing package includes one-year access and direct instructor support. Printed books included on request with the Full Package.`,
    "provider": {
      "@id": "https://daniellarsontraining.com/#organization"
    },
    "inLanguage": "en-US",
    "offers": [
      courseOffer(products.brokerCourse2, "Broker Course 2 + Traditional Final"),
      courseOffer(products.brokerFastPass, "Broker Course 2 + FastPass"),
      courseOffer(products.brokerCareerLaunch, "Full Package: Broker FastPass + 60-Hour Post-Licensing"),
    ]
  },
  {
    "@type": "WebPage",
    "@id": "https://daniellarsontraining.com/broker-licensing/#webpage",
    "url": "https://daniellarsontraining.com/broker-licensing/",
    "name": pageTitle,
    "description": pageDescription,
    "isPartOf": {
      "@id": "https://daniellarsontraining.com/#website"
    },
    "about": {
      "@id": "https://daniellarsontraining.com/broker-licensing/#course2"
    },
    "publisher": {
      "@id": "https://daniellarsontraining.com/#organization"
    },
    "inLanguage": "en-US"
  }
];
---

<SiteLayout
  title={pageTitle}
  description={pageDescription}
  shareTitle={`Florida Broker Licensing from $${salePrice(products.brokerCourse2)} with Code`}
  ogImage="/share-license-expanded-v2.png"
  canonicalPath="/broker-licensing/"
  schema={schema}
>
  <div class="licensing-parity">

<section class="hero" data-motion-section="hero">
<div class="wrap">
<div>
<div class="eyebrow">Florida Broker Licensing</div>
<h1>Get your Florida real estate broker license <em>fast.</em></h1>
<p class="hero-deck">Move toward your Florida broker license with required broker pre-license education, Broker FastPass certification and exam preparation, 500+ Q&amp;A, and direct help from the instructor who built the system. Printed books included on request with the Full Package.</p>
<p class="hero-kicker">No 72-hour video marathon. No endless PDF grind.</p>
<div class="hero-actions">
<a class="btn btn-primary" href="#packages">See licensing packages ↓</a>
<a class="btn btn-ghost" data-placement="hero" data-plan={products.brokerFastPass.id} href={products.brokerFastPass.checkoutUrl} target="_top">Broker FastPass</a>
</div>
<TrustpilotReviewLink />
</div>
<aside aria-label="Direct broker licensing support" class="hero-card">
<div class="eyebrow">Personalized answers</div>
<h2>When you need help, you can ask Daniel.</h2>
<p>Questions about broker licensing, exam prep, Pearson Professional Assessments, post-licensing, or what to do next? You are not routed to a generic call center.</p>
<a class="support-number" href="sms:+12394718500">TEXT 239.471.8500</a>
<div class="support-note">Professional broker-license support from Daniel Larson Training.</div>
</aside>
</div>
<div aria-label="Broker course highlights" class="truststrip">
<div><b>1 year</b>online access</div>
<div><b>DBPR approved</b>Course 2</div>
<div><b>500+ Q&amp;A</b>plus explainers</div>
<div><b>Printed books</b>on request with Full Package</div>
<div class="support-trust"><b>Direct Support</b><a href="mailto:daniel@daniellarsontraining.com">daniel@daniellarsontraining.com</a></div>
</div>
</section>
<section class="packages" data-motion-section="packages" id="packages-section">
<div class="wrap">
<div class="section-head">
<div class="eyebrow">Broker Licensing Options</div>
<h2 id="packages">Choose your path. Fast to thorough — it’s up to you.</h2>
<p>Florida-required pre-license education + exam-prep tools. With FastPass, you can go straight into the three FastPass exams and use the full course, Q&A, audio, video, and study materials as much or as little as you need. Pass FastPass to complete your course-certification path, then head to the state exam prepared. Add Post-Licensing to cover your first-renewal period.</p>
</div>
<div class="package-grid">
<article class="package">
<span class="badge">Course + Traditional Final</span>
<h3>Course 2</h3>
<div class="subplan">Required broker pre-license education + traditional final exam + state exam math</div>
<SalePrice product={products.brokerCourse2} />
<ul>
<li>DBPR-approved 72-hour Broker Course 2</li>
<li>Traditional course final exam</li>
<li>State exam math — Exam Math Basics</li>
<li>One year of access</li>
<li>Direct support from Daniel</li>
</ul>
<a class="btn btn-primary" data-placement="package_card" data-plan={products.brokerCourse2.id} href={products.brokerCourse2.checkoutUrl} target="_top">Enroll in Course 2</a>
</article>
<article class="package featured">
<span class="badge blue">Most Popular</span>
<h3>FastPass</h3>
<div class="subplan">Required broker pre-license education + FastPass certification + exam prep</div>
<SalePrice product={products.brokerFastPass} />
<ul>
<li>Three Broker FastPass certification exams</li>
<li>Full 72-hour Broker Course 2 included</li>
<li>State exam math — Exam Math Basics</li>
<li>Audio ebook review</li>
<li>500+ Q&amp;A and explanations</li>
<li>Broker FastPass Workbook — online + PDF</li>
<li>One year of access</li>
<li>Direct support from Daniel</li>
</ul>
<a class="btn btn-primary" data-placement="package_card" data-plan={products.brokerFastPass.id} href={products.brokerFastPass.checkoutUrl} target="_top">Enroll in Broker FastPass</a>
</article>
<article class="package">
<span class="badge">Best Value</span>
<h3>Full Package</h3>
<div class="subplan">Broker FastPass + your required 60-hour Broker Post-Licensing course</div>
<SalePrice product={products.brokerCareerLaunch} />
<ul>
<li>Everything in Broker FastPass</li>
<li>60-hour Broker Post-Licensing — required before first renewal</li>
<li>Bundle your next required education step now</li>
<li>Printed books included on request with the Full Package.</li>
<li>One year of access</li>
<li>Broker FastPass Workbook — online + PDF</li>
<li>Direct support from Daniel</li>
</ul>
<a class="btn btn-primary" data-placement="package_card" data-plan={products.brokerCareerLaunch.id} href={products.brokerCareerLaunch.checkoutUrl} target="_top">Get the Full Package</a>
</article>
</div>
</div>
</section>
    <TrustpilotReviews context="broker" />

<section class="fastpass" data-motion-section="fastpass" id="fastpass">
<div class="wrap fast-grid">
<div class="mark-scene">
<a aria-label="Enroll in Broker FastPass" class="mark" data-placement="logo" data-plan={products.brokerFastPass.id} href={products.brokerFastPass.checkoutUrl} target="_top">
<img alt="FastPass Florida broker exam preparation" src="/fastpass-logo.webp" width="700" height="700" />
</a>
</div>
<div>
<div class="section-head">
<div class="eyebrow" style="color:#1766c7">The FastPass approach</div>
<h2>Go straight into Broker FastPass. Use everything else to get you through it.</h2>
<p>FastPass gives you a clear testing target instead of forcing you through every resource in the same order. Use Course 2, 500+ practice questions, the FastPass book, audio reviews, videos, and study materials as your toolbox while you prepare for the three Broker FastPass exams and the separate Florida broker licensing exam administered by Pearson Professional Assessments (formerly Pearson VUE).</p>
<p><a href="/florida-broker-exam-prep/">Explore Florida broker exam prep: study tools, instructor experience, and official exam references →</a></p>
</div>
<div class="steps">
<div class="step"><div class="stepnum">01</div><div><h3>Start with Broker FastPass.</h3><p>Use the three Broker FastPass exams as a clear target and quickly see what you already know — and what you still need to review.</p></div></div>
<div class="step"><div class="stepnum">02</div><div><h3>Use the rest as your prep toolbox.</h3><p>Course 2, 500+ Q&amp;A, the FastPass book, audio/video explainers, PDFs, and drills are there when you need them.</p></div></div>
<div class="step"><div class="stepnum">03</div><div><h3>Pass Broker FastPass. Head to the state exam prepared.</h3><p>Pass the three Broker FastPass exams to complete your Course 2 certification path, then take the separate Florida broker licensing exam administered through Pearson Professional Assessments.</p></div></div>
</div>
</div>
</div>
</section>
<section class="included" data-motion-section="included">
<div class="wrap included-grid">
<div>
<div class="eyebrow">Built for experienced licensees</div>
<h2>Everything you need to pass — <em>fast.</em></h2>
<p class="included-copy">Broker candidates already know real estate. The goal is not to make you consume every minute of content — it is to give you a complete, organized system you can use as heavily or lightly as you need.</p>
</div>
<div class="feature-grid">
<div class="feature"><b>Optional video explainers</b><span>Focused explanations when a broker topic needs more than text.</span></div>
<div class="feature"><b>Glossary review</b><span>Broker terminology and concepts in a fast-reference format.</span></div>
<div class="feature"><b>PDF study supplements</b><span>Printable reference material, checklists, and review tools.</span></div>
<div class="feature"><b>Audio review</b><span>Review key material away from the screen.</span></div>
<div class="feature"><b>500+ broker Q&amp;A</b><span>Practice questions with explanations and exam-focused repetition.</span></div>
<div class="feature"><b>Broker FastPass Workbook included</b><span>Read online or download the PDF with FastPass. Printed books included on request with the Full Package.</span></div>
<div class="feature"><b>State-exam focus</b><span>Preparation built around the content and testing experience you are working toward.</span></div>
<div class="feature"><b>Ongoing support</b><span>Real help from the person who wrote the course.</span></div>
</div>
</div>
</section>
<section class="books" data-motion-section="books">
<div class="wrap">
<div class="bookcard">
<div><h2>Your Broker FastPass Workbook is included.</h2><p>Broker FastPass and the Full Package include the workbook to read online or download as a PDF. Printed books included on request with the Full Package.</p></div>
<div class="bookaside"><b>Printed books with the Full Package</b><span>Choose Broker FastPass + Post, then text or email your name, shipping address, and course to request your printed books.</span></div>
<div class="credential">Written &amp; published by Daniel Larson — DBPR-approved Course 1, Course 2, Post-Licensing &amp; 14-Hour CE — plus Exam Prep and FastPass.</div>
</div>
</div>
</section>
<section class="compare" data-motion-section="compare" id="compare">
<div class="wrap">
<div class="section-head">
<div class="eyebrow" style="color:#1766c7">Compare the broker bundles</div>
<h2>Compare your broker licensing paths.</h2>
<p>Every option includes the required Florida broker pre-license education. Earn your course certification through the traditional final exam or test out with the three Broker FastPass exams when you’re ready. Add Broker Post-Licensing to cover your first-renewal period.</p>
</div>
<div class="comparison">
<table class="comparison-table">
<caption>Daniel Larson Training Florida broker licensing bundle comparison</caption>
<colgroup><col class="feature-col"/><col/><col/><col/></colgroup>
