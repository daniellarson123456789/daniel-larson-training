---
import SiteLayout from "../layouts/SiteLayout.astro";
import { site } from "../data/site";
import "../styles/post-licensing.css";

const salesPostUrl = "https://portal.daniellarsontraining.com/bundles/post-licensing";
const brokerPostUrl = "https://portal.daniellarsontraining.com/bundles/broker-post-licensing";

const schema = [
  {
    "@type": "WebPage",
    "@id": `${site.url}/post-licensing/#webpage`,
    url: `${site.url}/post-licensing/`,
    name: "Florida Real Estate Post-Licensing Courses | Daniel Larson Training",
    description:
      "Complete Florida first-renewal Post-Licensing online: 45-hour Sales Associate Post-Licensing or 60-hour Broker Post-Licensing with FastPass final, PDFs, narrated lessons, review questions, and completion reporting support.",
    isPartOf: { "@id": `${site.url}/#website` },
    publisher: { "@id": `${site.url}/#organization` },
  },
  {
    "@type": "Course",
    "@id": `${site.url}/post-licensing/#sales-post`,
    name: "Florida 45-Hour Sales Associate Post-Licensing",
    description:
      "Florida Sales Associate first-renewal Post-Licensing with downloadable section PDFs, narrated lessons, review questions, FastPass final exam, and completion reporting support.",
    provider: { "@id": `${site.url}/#organization` },
    inLanguage: "en-US",
  },
  {
    "@type": "Course",
    "@id": `${site.url}/post-licensing/#broker-post`,
    name: "Florida 60-Hour Broker Post-Licensing",
    description:
      "Florida Broker and Broker Associate first-renewal Post-Licensing with broker-focused PDFs, narrated lessons, review questions, FastPass final exam, and completion reporting support.",
    provider: { "@id": `${site.url}/#organization` },
    inLanguage: "en-US",
  },
];
---

<SiteLayout
  title="Florida Real Estate Post-Licensing Courses | Daniel Larson Training"
  description="Complete Florida first-renewal Post-Licensing online: 45-hour Sales Associate Post-Licensing or 60-hour Broker Post-Licensing with FastPass final, PDFs, narrated lessons, and completion reporting support."
  canonicalPath="/post-licensing/"
  schema={schema}
>
  <div class="post-page">
    <section class="post-hero">
      <div class="shell post-hero-grid">
        <div class="post-hero-copy">
          <p class="post-eyebrow">Florida First-Renewal Education</p>
          <h1>45-Hour Sales Post. 60-Hour Broker Post.</h1>
          <p class="post-lead">
            <strong>Read it. Listen to it. Review it. Use FastPass to test out when you're ready.</strong>
            Choose the course for your license and use the downloadable section PDFs,
            podcast-style narrated lessons, and review questions as much — or as little — as you need.
          </p>

          <div class="post-hero-actions">
            <a class="button button-primary" href="#post-options">Choose your Post course ↓</a>
            <a class="button button-secondary post-ghost" href="#post-course">Explore the course</a>
          </div>
        </div>

        <aside class="post-help-card" data-tilt>
          <p class="post-help-kicker">First-renewal education</p>
          <h2>Choose by the license you most recently earned.</h2>
          <p>
            Sales associates take 45-hour Post. Brokers and broker associates take 60-hour Post.
            Both options include the course material, FastPass final, and completion reporting support.
          </p>
          <a href="sms:+12394718500">Not sure? Text Daniel · {site.phoneDisplay}</a>
        </aside>
      </div>

      <div class="post-trust">
        <div><strong>45 or 60 hours</strong><span>first-renewal courses</span></div>
        <div><strong>Self-paced</strong><span>use what you need</span></div>
        <div><strong>Section PDFs</strong><span>download + keep</span></div>
        <div><strong>Narrated lessons</strong><span>podcast-style audio</span></div>
        <div><strong>FastPass final</strong><span>included</span></div>
      </div>
    </section>

    <section class="post-options-section" id="post-options">
      <div class="shell">
        <header class="post-section-head" data-post-reveal>
          <p class="post-eyebrow">Choose by license type</p>
          <h2>Choose the Post course for your license.</h2>
          <p>
            Both combine Florida-required education with practical course material, review tools,
            the FastPass final exam, and school reporting support.
          </p>
        </header>

        <div class="post-options-grid">
          <article class="post-option" data-post-reveal>
            <div class="post-option-top">
              <div>
                <p class="post-option-kicker">Sales Associate · First Renewal</p>
                <h3>45-Hour Sales Post-Licensing</h3>
              </div>
              <div class="post-price">$130</div>
            </div>

            <p class="post-option-copy">
              For Florida sales associates completing the required 45 hours of post-licensing
              education before the first renewal of the initial sales associate license.
            </p>

            <ul>
              <li>Required 45-hour Sales Post course</li>
              <li>Florida law, ethics + business planning</li>
              <li>Downloadable section PDFs</li>
              <li>Podcast-style narrated lessons</li>
              <li>Section review questions</li>
              <li>FastPass final + reporting support</li>
            </ul>

            <a class="button button-primary post-option-button" href={salesPostUrl} target="_top">
              View Sales Post details →
            </a>
          </article>

          <article class="post-option post-option-broker" data-post-reveal>
            <div class="post-option-top">
              <div>
                <p class="post-option-kicker">Broker or Broker Associate · First Renewal</p>
                <h3>60-Hour Broker Post-Licensing</h3>
              </div>
              <div class="post-price">$160</div>
            </div>

            <p class="post-option-copy">
              For Florida brokers and broker associates completing the required 60 hours of
              post-licensing education before the first renewal of the initial broker license.
            </p>

            <ul>
              <li>Required 60-hour Broker Post course</li>
              <li>Management, operations + trust accounts</li>
              <li>Broker-focused PDFs + narrated lessons</li>
              <li>Section review questions</li>
              <li>FastPass final exam included</li>
              <li>Completion reporting support</li>
            </ul>

            <a class="button button-primary post-option-button" href={brokerPostUrl} target="_top">
              View Broker Post details →
            </a>
          </article>
        </div>

        <p class="post-partner-note">
          <strong>Have a Partner Code?</strong> Enter it at checkout. No code? Ask your broker, office manager, recruiter, or trainer.
        </p>
      </div>
    </section>

    <section class="post-flow" id="how-it-works">
      <div class="shell">
        <div class="post-flow-grid">
          <article data-post-reveal>
            <span>01</span>
            <h3>Choose the right Post course.</h3>
            <p>Sales associates take 45 hours. Brokers and broker associates take 60 hours.</p>
          </article>
          <article data-post-reveal>
            <span>02</span>
            <h3>Use what you need.</h3>
            <p>Read, listen, and review at your own pace without a forced lesson sequence.</p>
          </article>
          <article data-post-reveal>
            <span>03</span>
            <h3>Finish with FastPass.</h3>
            <p>Complete the included on-demand final exam when you are ready.</p>
          </article>
          <article data-post-reveal>
            <span>04</span>
            <h3>We report. You renew.</h3>
            <p>Send the required license information, then complete the separate renewal with DBPR.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="post-course-system" id="post-course">
      <div class="shell post-system-grid">
        <div>
          <header class="post-section-head post-section-head-light" data-post-reveal>
            <p class="post-eyebrow">Inside the course</p>
            <h2>Course material you can return to.</h2>
            <p>
              Read the section PDFs, follow the narration, and check your understanding with review
              questions. Use the material in the way that helps you, then take the included FastPass
              final when you're ready.
            </p>
          </header>
        </div>

        <div class="post-tool-grid">
          <article class="post-tool" data-post-reveal>
            <span>Read</span>
            <h3>Professionally formatted section PDFs</h3>
            <p>Read inside the course, download each section, and keep useful material for later reference.</p>
          </article>
          <article class="post-tool" data-post-reveal>
            <span>Listen</span>
            <h3>Narrated, audio-guided lessons</h3>
            <p>Listen podcast-style or follow the narration while reading the section PDF.</p>
          </article>
          <article class="post-tool" data-post-reveal>
            <span>Review</span>
            <h3>Section review questions</h3>
            <p>Use quick confidence checks whenever you want reinforcement before the final.</p>
          </article>
          <article class="post-tool" data-post-reveal>
            <span>Finish</span>
            <h3>FastPass final exam</h3>
            <p>An on-demand final exam designed to make course completion clear and manageable.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="post-included">
      <div class="shell">
        <header class="post-section-head" data-post-reveal>
          <p class="post-eyebrow">Inside the enrollment</p>
          <h2>Florida requirements, connected to real practice.</h2>
          <p>
            The Sales and Broker courses cover the responsibilities of a Florida licensee and the
            decisions you make in the business. Broker Post adds a focus on running a brokerage.
          </p>
        </header>

        <div class="post-feature-grid">
          <article data-post-reveal>
            <span>Required Education</span>
            <h3>Florida law + procedures</h3>
            <p>Licensing responsibilities, contracts, brokerage relationships, advertising, compensation, and consumer protection.</p>
          </article>
          <article data-post-reveal>
            <span>Professional Practice</span>
            <h3>Ethics + risk awareness</h3>
            <p>Professional judgment, client service, communication, ethical decisions, and avoiding preventable problems.</p>
          </article>
          <article data-post-reveal>
            <span>Business Development</span>
            <h3>Business + brokerage operations</h3>
            <p>Planning, marketing, and systems for Sales Post; management, risk, and trust accounts for Broker Post.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="post-updates">
      <div class="shell">
        <header class="post-section-head" data-post-reveal>
          <p class="post-eyebrow">Current course material</p>
          <h2>Relevant material beyond the required hours.</h2>
          <p>
            The courses include practical bonus material, with room for meaningful updates when
            legal, licensing, or industry changes affect Florida real estate practice.
          </p>
        </header>

        <div class="post-bonus-grid">
          <article data-post-reveal>
            <p>Bonus</p>
            <h3>NAR settlement overview</h3>
            <span>Written buyer agreements, compensation communication, what changed in national practice, and what did not replace Florida license law.</span>
          </article>
          <article data-post-reveal>
            <p>Course Update</p>
            <h3>Post, CE + renewal</h3>
            <span>Which education belongs to which renewal stage, what completion means, how reporting works, and what you still do through MyFloridaLicense.com.</span>
          </article>
        </div>
      </div>
    </section>

    <section class="post-finish">
      <div class="shell">
        <header class="post-section-head post-section-head-light" data-post-reveal>
          <p class="post-eyebrow">After the final exam</p>
          <h2>Finish the course. Send the license information. Complete your renewal.</h2>
          <p>
            Completing the final exam is the course milestone. Reporting and the separate state renewal transaction come next.
          </p>
        </header>

        <div class="post-finish-grid">
          <article data-post-reveal>
            <strong>1</strong>
            <h3>Complete the FastPass final.</h3>
            <p>Finish the included on-demand final exam for your Sales or Broker Post course.</p>
          </article>
          <article data-post-reveal>
            <strong>2</strong>
            <h3>Send your license information.</h3>
            <p>Email your full licensed name, license number, and course completion date to the school.</p>
          </article>
          <article data-post-reveal>
            <strong>3</strong>
            <h3>We report completion.</h3>
            <p>Daniel Larson Training reports completion to DBPR within 24 hours after receiving the required license information.</p>
          </article>
          <article data-post-reveal>
            <strong>4</strong>
            <h3>You finish the renewal.</h3>
            <p>Complete the separate license-renewal transaction through MyFloridaLicense.com.</p>
          </article>
        </div>

        <div class="post-warning">
          <span>!</span>
          <p>
            <strong>Do not wait until the final minute.</strong> State processing may take additional business days
            after the school reports completion.
          </p>
        </div>
      </div>
    </section>

    <section class="post-final">
      <div class="shell post-final-inner">
        <div>
          <p class="post-eyebrow">First renewal</p>
          <h2>Choose your Post course.</h2>
          <p>See the full course details and everything included before enrolling.</p>
        </div>
        <div class="post-final-actions">
          <a class="button button-primary" href={salesPostUrl} target="_top">View Sales Post</a>
          <a class="button button-secondary post-final-secondary" href={brokerPostUrl} target="_top">View Broker Post</a>
        </div>
      </div>
    </section>
  </div>
</SiteLayout>
