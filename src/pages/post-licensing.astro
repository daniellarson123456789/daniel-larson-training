---
import SiteLayout from "../layouts/SiteLayout.astro";
import { site } from "../data/site";
import "../styles/post-licensing-wix.css";


const schema = [
  {
    "@type": "WebPage",
    "@id": `${site.url}/post-licensing/#webpage`,
    url: `${site.url}/post-licensing/`,
    name: "Florida Real Estate Post-Licensing Courses | Daniel Larson Training",
    description:
      "Complete Florida first-renewal Post-Licensing online: 45-hour Sales Associate Post-Licensing or 60-hour Broker Post-Licensing with FastPass final, PDFs, narrated lessons, review questions, and completion reporting support.",
    isPartOf: { "@id": `${site.url}/#website` },
    publisher: { "@id": `${site.url}/#organization` },
  },
  {
    "@type": "Course",
    "@id": `${site.url}/post-licensing/#sales-post`,
    name: "Florida 45-Hour Sales Associate Post-Licensing",
    description:
      "Florida Sales Associate first-renewal Post-Licensing with downloadable section PDFs, narrated lessons, review questions, FastPass final exam, and completion reporting support.",
    provider: { "@id": `${site.url}/#organization` },
    inLanguage: "en-US",
  },
  {
    "@type": "Course",
    "@id": `${site.url}/post-licensing/#broker-post`,
    name: "Florida 60-Hour Broker Post-Licensing",
    description:
      "Florida Broker and Broker Associate first-renewal Post-Licensing with broker-focused PDFs, narrated lessons, review questions, FastPass final exam, and completion reporting support.",
    provider: { "@id": `${site.url}/#organization` },
    inLanguage: "en-US",
  },
];
---

<SiteLayout
  title="Florida Real Estate Post-Licensing Courses | Daniel Larson Training"
  description="Choose the course that matches your license and use the downloadable PDFs, podcast-style narrated lessons, and review tools as much — or as little — as you need."
  canonicalPath="/post-licensing/"
  schema={schema}
>
  <div class="wix-course-shell">
<section class="dlt-post" aria-label="Florida real estate post-licensing courses">
    <div class="dlt-post__wrap">

      <header class="dlt-post__hero">
        <p class="dlt-post__eyebrow"><span class="dlt-post__liveDot" aria-hidden="true"></span>Florida First-Renewal Education</p>
        <h1 class="dlt-post__title">45-Hour Sales Post or 60-Hour Broker Post</h1>
        <p class="dlt-post__promo">New for 2026 • PDF + Podcast-Style Learning • FastPass</p>
        <p class="dlt-post__lead">
          <strong>Read it. Listen to it. Review it. Use FastPass to test out when you're ready.</strong>
          Choose the course that matches your license and use the downloadable PDFs, podcast-style narrated lessons, and review tools as much — or as little — as you need.
        </p>

        <div class="dlt-post__pills" aria-label="Post-licensing course highlights">
          <span class="dlt-post__pill dlt-post__pill--accent">FastPass Final Included</span>
          <span class="dlt-post__pill">Self-Paced</span>
          <span class="dlt-post__pill">Downloadable PDFs</span>
          <span class="dlt-post__pill">Podcast-Style Audio</span>
        </div>
      </header>

      <div class="dlt-post__choiceGrid" id="dlt-post-choose" role="list" aria-label="Choose your post-licensing course">
        <article class="dlt-post__choice" role="listitem">
          <div class="dlt-post__choiceTop">
            <div>
              <p class="dlt-post__choiceKicker">Sales Associate • First Renewal</p>
              <h3 class="dlt-post__choiceTitle">45-Hour Sales Post-Licensing</h3>
            </div>
            <div class="dlt-post__priceBlock">
              <p class="dlt-post__price">$130</p>
              <p class="dlt-post__priceLabel">One-Time Enrollment</p>
              <a class="dlt-post__topEnroll" href="https://portal.daniellarsontraining.com/bundles/post-licensing" target="_blank" rel="noopener">View Sales Post →</a>
            </div>
          </div>

          <div class="dlt-post__choiceBody">
            <p class="dlt-post__choiceDesc">
              For Florida sales associates completing the required <strong>45 hours of post-licensing education before the first renewal</strong> of the initial sales associate license.
            </p>
            <div class="dlt-post__mini">
              <div class="dlt-post__miniItem"><span class="dlt-post__check">✓</span><span>Complete sales post-licensing course and FastPass final exam.</span></div>
              <div class="dlt-post__miniItem"><span class="dlt-post__check">✓</span><span>Downloadable section PDFs, podcast-style narrated lessons, and review questions.</span></div>
              <div class="dlt-post__miniItem"><span class="dlt-post__check">✓</span><span>Completion reporting after we receive your required license information.</span></div>
            </div>
          </div>

        </article>

        <article class="dlt-post__choice dlt-post__choice--broker" role="listitem">
          <div class="dlt-post__choiceTop">
            <div>
              <p class="dlt-post__choiceKicker">Broker or Broker Associate • First Renewal</p>
              <h3 class="dlt-post__choiceTitle">60-Hour Broker Post-Licensing</h3>
            </div>
            <div class="dlt-post__priceBlock">
              <p class="dlt-post__price">$160</p>
              <p class="dlt-post__priceLabel">One-Time Enrollment</p>
              <a class="dlt-post__topEnroll" href="https://portal.daniellarsontraining.com/bundles/broker-post-licensing" target="_blank" rel="noopener">View Broker Post →</a>
            </div>
          </div>

          <div class="dlt-post__choiceBody">
            <p class="dlt-post__choiceDesc">
              For Florida brokers and broker associates completing the required <strong>60 hours of post-licensing education before the first renewal</strong> of the initial broker license.
            </p>
            <div class="dlt-post__mini">
              <div class="dlt-post__miniItem"><span class="dlt-post__check">✓</span><span>Complete broker post-licensing course and FastPass final exam.</span></div>
              <div class="dlt-post__miniItem"><span class="dlt-post__check">✓</span><span>Broker-focused PDFs, podcast-style narrated lessons, and section review questions.</span></div>
              <div class="dlt-post__miniItem"><span class="dlt-post__check">✓</span><span>Management, operations, risk, trust accounts, and brokerage growth.</span></div>
            </div>
          </div>

        </article>
      </div>

      <div class="dlt-post__partnerCode">
        <strong>Have a Partner Code?</strong> Enter it at checkout. No code? Ask your broker, office manager, recruiter, or trainer if they have a Daniel Larson Training Partner Code.
      </div>

      <div class="dlt-post__band" aria-label="Post-licensing process">
        <div class="dlt-post__bandItem">
          <p class="dlt-post__bandTitle">1. Choose the Right Course</p>
          <p class="dlt-post__bandText">Sales associates take 45 hours. Brokers and broker associates take 60 hours.</p>
        </div>
        <div class="dlt-post__bandItem">
          <p class="dlt-post__bandTitle">2. Use What You Need</p>
          <p class="dlt-post__bandText">Read, listen, and review at your own pace — without a forced lesson sequence.</p>
        </div>
        <div class="dlt-post__bandItem">
          <p class="dlt-post__bandTitle">3. Test Out with FastPass</p>
          <p class="dlt-post__bandText">Go to the included on-demand final exam when you're ready.</p>
        </div>
        <div class="dlt-post__bandItem">
          <p class="dlt-post__bandTitle">4. We Report. You Renew.</p>
          <p class="dlt-post__bandText">Send your license information, let us report completion, and finish renewal with DBPR.</p>
        </div>
      </div>

      <section class="dlt-post__section" aria-labelledby="post-learn-your-way">
        <div class="dlt-post__sectionHead">
          <h3 class="dlt-post__sectionTitle" id="post-learn-your-way">A Complete Course — Not Just a Final Exam Link</h3>
          <p class="dlt-post__sectionText">
            FastPass is there when you're ready, and the enrollment still gives you a full learning system when you want it. Read the section PDFs, listen podcast-style, follow along with the narration, and use the review material wherever it helps.
          </p>
        </div>

        <div class="dlt-post__learnGrid">
          <article class="dlt-post__card">
            <p class="dlt-post__cardKicker">Download + Read</p>
            <h4 class="dlt-post__cardTitle">Professionally Formatted Section PDFs</h4>
            <p class="dlt-post__cardText">Read inside the course, download each section, and keep useful material for later reference.</p>
          </article>
          <article class="dlt-post__card">
            <p class="dlt-post__cardKicker">Play + Follow Along</p>
            <h4 class="dlt-post__cardTitle">Narrated, Audio-Guided Lessons</h4>
            <p class="dlt-post__cardText">Listen in a podcast-style format or follow the narration while reading the section PDF.</p>
          </article>
          <article class="dlt-post__card">
            <p class="dlt-post__cardKicker">Review + Reinforce</p>
            <h4 class="dlt-post__cardTitle">Section Review Questions</h4>
            <p class="dlt-post__cardText">Use the section questions whenever you want a quick confidence check before the FastPass final exam.</p>
          </article>
        </div>
      </section>

      <section class="dlt-post__section" aria-labelledby="post-included">
        <div class="dlt-post__sectionHead">
          <h3 class="dlt-post__sectionTitle" id="post-included">Everything Included in Your Enrollment</h3>
          <p class="dlt-post__sectionText">
            Both post-licensing options combine practical education, flexible course delivery, review tools, the FastPass final exam, and school reporting support.
          </p>
        </div>

        <div class="dlt-post__featureGrid">
          <article class="dlt-post__card">
            <p class="dlt-post__cardKicker">Required Education</p>
            <h4 class="dlt-post__cardTitle">Florida Law and Procedures</h4>
            <p class="dlt-post__cardText">Licensing responsibilities, contracts, brokerage relationships, advertising, compensation, and consumer protection.</p>
          </article>
          <article class="dlt-post__card">
            <p class="dlt-post__cardKicker">Professional Practice</p>
            <h4 class="dlt-post__cardTitle">Ethics and Risk Awareness</h4>
            <p class="dlt-post__cardText">Professional judgment, client service, communication, ethical decisions, and avoiding preventable problems.</p>
          </article>
          <article class="dlt-post__card">
            <p class="dlt-post__cardKicker">Business Development</p>
            <h4 class="dlt-post__cardTitle">Planning, Marketing, and Systems</h4>
            <p class="dlt-post__cardText">Practical tools for organizing the business, serving clients, developing opportunities, and working consistently.</p>
          </article>
          <article class="dlt-post__card">
            <p class="dlt-post__cardKicker">Modern Course Tools</p>
            <h4 class="dlt-post__cardTitle">PDFs + Narrated Lessons</h4>
            <p class="dlt-post__cardText">Use the course on a computer, tablet, or phone without depending on a printed textbook.</p>
          </article>
          <article class="dlt-post__card">
            <p class="dlt-post__cardKicker">Confidence Checks</p>
            <h4 class="dlt-post__cardTitle">Review Questions Throughout</h4>
            <p class="dlt-post__cardText">Use quick checks to reinforce important rules and concepts whenever you need them.</p>
          </article>
          <article class="dlt-post__card">
            <p class="dlt-post__cardKicker">Finish Efficiently</p>
            <h4 class="dlt-post__cardTitle">FastPass Final Exam</h4>
            <p class="dlt-post__cardText">A clear, on-demand final exam designed to make completion manageable and low-stress.</p>
          </article>
        </div>
      </section>

      <section class="dlt-post__section" aria-labelledby="post-updates">
        <div class="dlt-post__sectionHead">
          <h3 class="dlt-post__sectionTitle" id="post-updates">Current Bonus Material and Meaningful Updates</h3>
          <p class="dlt-post__sectionText">
            Real estate practice changes. The course experience includes practical bonus material and can be expanded when major legal, licensing, or industry changes deserve a clear explanation.
          </p>
        </div>

        <div class="dlt-post__bonusGrid">
          <article class="dlt-post__bonus">
            <h4 class="dlt-post__bonusTitle">NAR Settlement Overview</h4>
            <p class="dlt-post__bonusText">Understand written buyer agreements, compensation communication, what changed in national practice, and what did not replace Florida license law.</p>
          </article>
          <article class="dlt-post__bonus">
            <h4 class="dlt-post__bonusTitle">Post, CE, and Renewal</h4>
            <p class="dlt-post__bonusText">Know which education applies to each renewal stage, what completion means, how reporting works, and what you must still do through MyFloridaLicense.com.</p>
          </article>
        </div>

        <div class="dlt-post__updateNote">
          New bonus material can be added when a significant law, rule, licensing requirement, or industry practice changes the work Florida licensees perform.
        </div>
      </section>

      <section class="dlt-post__section" aria-labelledby="post-finish">
        <div class="dlt-post__sectionHead">
          <h3 class="dlt-post__sectionTitle" id="post-finish">What Happens After You Finish</h3>
          <p class="dlt-post__sectionText">
            Completing the final exam is the key course milestone. After that, send the school the information needed for reporting and make sure the separate state renewal step is completed.
          </p>
        </div>

        <div class="dlt-post__stepsGrid">
          <article class="dlt-post__stepCard">
            <p class="dlt-post__stepNum">Step 1</p>
            <h4 class="dlt-post__stepTitle">Use What You Need</h4>
            <p class="dlt-post__stepText">Read, listen, and review at your own pace. Use as much — or as little — as you need.</p>
          </article>
          <article class="dlt-post__stepCard">
            <p class="dlt-post__stepNum">Step 2</p>
            <h4 class="dlt-post__stepTitle">Test Out with FastPass</h4>
            <p class="dlt-post__stepText">When you're ready, complete the included on-demand final exam for your Sales or Broker Post course.</p>
          </article>
          <article class="dlt-post__stepCard">
            <p class="dlt-post__stepNum">Step 3</p>
            <h4 class="dlt-post__stepTitle">Send Your License Information</h4>
            <p class="dlt-post__stepText">Email your full licensed name, license number, and course completion date to the school.</p>
          </article>
          <article class="dlt-post__stepCard">
            <p class="dlt-post__stepNum">Step 4</p>
            <h4 class="dlt-post__stepTitle">We Report. You Renew.</h4>
            <p class="dlt-post__stepText">We report the education, and you complete the license-renewal process through MyFloridaLicense.com.</p>
          </article>
        </div>

        <div class="dlt-post__important">
          <div class="dlt-post__importantMark">!</div>
          <p class="dlt-post__importantText">
            <strong>Do not wait until the final minute.</strong> We report completion to DBPR within 24 hours after receiving the required license information. State processing may take additional business days, and the student must still complete the separate renewal transaction through MyFloridaLicense.com.
          </p>
        </div>
      </section>

      <section class="dlt-post__section" aria-labelledby="post-which-course">
        <div class="dlt-post__sectionHead">
          <h3 class="dlt-post__sectionTitle" id="post-which-course">Which Post-Licensing Course Do You Need?</h3>
          <p class="dlt-post__sectionText">Choose based on the license you most recently received — not the kind of real estate work you currently perform.</p>
        </div>

        <div class="dlt-post__compare">
          <article class="dlt-post__compareCard">
            <span class="dlt-post__compareBadge">45 Hours • $130</span>
            <h4 class="dlt-post__compareTitle">You Recently Earned a Sales Associate License</h4>
            <p class="dlt-post__compareText">Choose Sales Post-Licensing. This is the education requirement tied to the first renewal of the initial Florida sales associate license.</p>
            <a class="dlt-post__compareButton" href="https://portal.daniellarsontraining.com/bundles/post-licensing" target="_blank" rel="noopener">View Sales Post →</a>
          </article>
          <article class="dlt-post__compareCard">
            <span class="dlt-post__compareBadge">60 Hours • $160</span>
            <h4 class="dlt-post__compareTitle">You Recently Earned a Broker License</h4>
            <p class="dlt-post__compareText">Choose Broker Post-Licensing. This applies to brokers and broker associates completing the first renewal after initial broker licensure.</p>
            <a class="dlt-post__compareButton dlt-post__compareButton--broker" href="https://portal.daniellarsontraining.com/bundles/broker-post-licensing" target="_blank" rel="noopener">View Broker Post →</a>
          </article>
        </div>
      </section>


      <footer class="dlt-post__foot">
        <div><strong>Not sure whether you need Post-Licensing or 14-hour CE?</strong> Contact us and we will help identify the correct course.</div>
        <div><a href="tel:12394718500">239.471.8500</a>  •  <a href="mailto:daniel@daniellarsontraining.com">daniel@daniellarsontraining.com</a></div>
      </footer>

    </div>
  </section>

  
  </div>
</SiteLayout>
