---
import SiteLayout from "../layouts/SiteLayout.astro";
import TrustpilotReviews from "../components/TrustpilotReviews.astro";
import CheckoutNote from "../components/CheckoutNote.astro";
import { site } from "../data/site";
import { products, salePrice } from "../data/products";
import { courseOffer } from "../lib/courseOffer";
import { faqPage } from "../lib/seo";
import { postFaqs } from "../data/renewalFaqs";
import "../styles/draft-sales.css";

const sales = products.salesPost;
const broker = products.brokerPost;
const pageTitle = "Fastest Way to Finish Florida Post-Licensing Online | Final Exam When Ready | Real Estate FastPass";
const pageDescription = `The fastest way to finish Florida Post-Licensing online: self-paced 45-hour Sales ($${salePrice(sales)}) and 60-hour Broker ($${salePrice(broker)}) courses with no page timers. Take the FastPass final exam when you’re ready; DBPR reporting included.`;

const schema = [
  {
    "@type": "WebPage",
    "@id": `${site.url}/post-licensing/#webpage`,
    url: `${site.url}/post-licensing/`,
    name: pageTitle,
    description: pageDescription,
    isPartOf: { "@id": `${site.url}/#website` },
    publisher: { "@id": `${site.url}/#organization` },
    mainEntity: [
      { "@id": `${site.url}/post-licensing/#sales-post` },
      { "@id": `${site.url}/post-licensing/#broker-post` },
    ],
  },
  {
    "@type": "Course",
    "@id": `${site.url}/post-licensing/#sales-post`,
    url: `${site.url}/post-licensing/#sales-post`,
    name: "Florida 45-Hour Sales Associate Post-Licensing",
    description: "Online, self-paced 45-hour Sales Associate Post-Licensing, required before the first license renewal, with section PDFs, narrated lessons, review questions, an included FastPass final exam, and DBPR completion reporting.",
    educationalLevel: "Florida Sales Associate Post-Licensing (first renewal)",
    provider: { "@id": `${site.url}/#organization` },
    inLanguage: "en-US",
    offers: courseOffer(products.salesPost),
  },
  {
    "@type": "Course",
    "@id": `${site.url}/post-licensing/#broker-post`,
    url: `${site.url}/post-licensing/#broker-post`,
    name: "Florida 60-Hour Broker Post-Licensing",
    description: "Online, self-paced 60-hour Broker and Broker Associate Post-Licensing, required before the first license renewal, with course material, an included FastPass final exam, and DBPR completion reporting.",
    educationalLevel: "Florida Broker Post-Licensing (first renewal)",
    provider: { "@id": `${site.url}/#organization` },
    inLanguage: "en-US",
    offers: courseOffer(products.brokerPost),
  },
  faqPage(`${site.url}/post-licensing/#faq`, postFaqs.map((f) => ({ name: f.q, text: f.a }))),
];
---

<SiteLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath="/post-licensing/"
  schema={schema}
>
  <div class="draft-sales lic-style">
    <section class="draft-hero">
      <div class="wrap draft-hero-grid hero-dual">
        <div class="draft-hero-intro">
          <p class="draft-kicker">
            <span class="draft-brand">{site.name}</span>
            <span class="draft-school">{site.tagline}</span>
          </p>
          <h1>The fastest way to finish <em class="fast">Post‑Licensing</em> online in Florida.</h1>
          <p class="lic-q">What’s the fastest way to finish Florida <em class="lic-em">Post‑Licensing?</em></p>
          <p class="lead">Take it online with <em class="lic-em">FastPass.</em> It’s self-paced with no page timers, so if you already know the material you can move fast, then take the final exam when you’re ready.</p>
          <a class="draft-link-more" href="#post-options">See your options <span aria-hidden="true">→</span></a>
        </div>
        <aside class="draft-hero-panel">
          <h2>Due before your first renewal.</h2>
          <p>Finish before the first expiration date on your license. Your enrollment includes the complete course, the FastPass final exam, and DBPR completion reporting.</p>
          <div class="hero-panel-actions">
            <a class="draft-btn outline" data-plan={sales.id} data-placement="hero_panel" href={sales.checkoutUrl} target="_top">Sales Post-Licensing — ${salePrice(sales)}</a>
            <a class="draft-btn primary" data-plan={broker.id} data-placement="hero_panel" href={broker.checkoutUrl} target="_top">Broker Post-Licensing — ${salePrice(broker)}</a>
          </div>
          <CheckoutNote />
        </aside>
      </div>
    </section>

    <section class="draft-section soft" id="post-options">
      <div class="wrap">
        <p class="draft-eyebrow">Choose by license type</p>
        <h2>Which Post course do you need?</h2>
        <p class="intro">Both options include the complete course with FastPass final exam and automated DBPR completion reporting. State license renewal fees are separate.</p>
        <div class="price-grid two">
          <article class="price-card popular" id="sales-post">
            <span class="price-badge">Sales Associate · First Renewal</span>
            <h3>45‑Hour Sales Post</h3>
            <div class="price">${salePrice(sales)}</div>
            <p class="note">For Florida sales associates completing first-renewal Post-Licensing. Downloadable section PDFs, narrated lessons, review questions, and a FastPass final exam. Take the final when you’re ready, without waiting through lessons.</p>
            <a class="draft-btn primary" data-plan={sales.id} data-placement="pricing_card" href={sales.checkoutUrl} target="_top">Enroll in Sales Post — ${salePrice(sales)}</a>
            <CheckoutNote />
          </article>
          <article class="price-card" id="broker-post">
            <span class="price-badge">Broker or Broker Associate</span>
            <h3>60‑Hour Broker Post</h3>
            <div class="price">${salePrice(broker)}</div>
            <p class="note">For Florida brokers and broker associates completing first-renewal Post-Licensing. Broker-focused section PDFs, narrated lessons, review questions, and a FastPass final exam. Take the final when you’re ready, without waiting through lessons.</p>
            <a class="draft-btn navy" data-plan={broker.id} data-placement="pricing_card" href={broker.checkoutUrl} target="_top">Enroll in Broker Post — ${salePrice(broker)}</a>
            <CheckoutNote />
          </article>
        </div>
      </div>
    </section>

    <section class="draft-section" id="post-deadline">
      <div class="wrap">
        <p class="draft-eyebrow">Your first renewal</p>
        <h2>Your first renewal needs <em>Post‑Licensing</em></h2>
        <p class="intro">To renew your license the first time, you complete Post‑Licensing before your first expiration date. Florida licenses expire on March 31 or September 30, and your first one comes 18 to 24 months after you’re licensed.</p>
        <div class="draft-feature-grid">
          <article class="draft-feature"><h3>Find your date</h3><p>Your expiration date is in your <a href="https://www2.myfloridalicense.com/">DBPR account at MyFloridaLicense.com</a>. Not sure yet? <a href="/license-guides/post-licensing-vs-ce/">Estimate your renewal dates</a>.</p></article>
          <article class="draft-feature"><h3>If you miss it</h3><p>The license becomes null and void, and a later course can’t fix it. <a href="/license-guides/missed-post-licensing-deadline/">See what can still be done</a>.</p></article>
          <article class="draft-feature"><h3>After your first renewal</h3><p>You switch to <a href="/14ce/">14-hour CE online</a> every two years: Core Law, Ethics, and specialty hours.</p></article>
          <article class="draft-feature"><h3>Not sure what you need?</h3><p><a href="sms:+12394718500">Text Daniel at {site.phoneDisplay}</a> with your question and he’ll tell you exactly what you need.</p></article>
        </div>
      </div>
    </section>

    <TrustpilotReviews context="post" />

    <section class="draft-section" id="post-course">
      <div class="wrap">
        <p class="draft-eyebrow">Inside your Post course</p>
        <h2>Read it. Listen to it. Review what matters.</h2>
        <p class="intro">Each Post course includes clear, downloadable section PDFs, narrated lessons, and review questions. Work through the material at your own pace, go straight to a topic you want to brush up on. Take the FastPass final exam when you’re ready.</p>
        <div class="draft-feature-grid">
          <article class="draft-feature"><h3>Section PDFs</h3><p>Downloadable course material you can read in the course or keep for later.</p></article>
          <article class="draft-feature"><h3>Narrated lessons</h3><p>Podcast-style audio you can listen to anywhere.</p></article>
          <article class="draft-feature"><h3>Review questions</h3><p>Florida practice material to check what you want to reinforce.</p></article>
          <article class="draft-feature"><h3>FastPass final exam</h3><p>Test out when you’re ready, with no lesson clock in the way.</p></article>
        </div>
      </div>
    </section>

    <section class="draft-section soft" id="faq">
      <div class="wrap">
        <p class="draft-eyebrow">Questions</p>
        <h2>Your Post‑Licensing questions, answered</h2>
        <div class="faq-list">
          {postFaqs.map((f) => (<details><summary>{f.q}</summary><p>{f.a}</p></details>))}
        </div>
      </div>
    </section>

    <section class="draft-section navy final-cta">
      <div class="wrap">
        <h2>Pass your final exam. We report your completion.</h2>
        <div class="draft-hero-actions" style="justify-content:center;">
          <span class="checkout-cta">
            <a class="draft-btn primary" data-plan={sales.id} data-placement="final_cta" href={sales.checkoutUrl} target="_top">Sales Post — ${salePrice(sales)}</a>
            <CheckoutNote />
          </span>
          <span class="checkout-cta">
            <a class="draft-btn primary" style="background:#fff;color:#0a1236;" data-plan={broker.id} data-placement="final_cta" href={broker.checkoutUrl} target="_top">Broker Post — ${salePrice(broker)}</a>
            <CheckoutNote />
          </span>
        </div>
      </div>
    </section>
  </div>
</SiteLayout>
