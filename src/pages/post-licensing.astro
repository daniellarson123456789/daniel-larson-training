---
import SiteLayout from "../layouts/SiteLayout.astro";
import { site } from "../data/site";
import "../styles/post-licensing.css";

const salesPostUrl = "https://portal.daniellarsontraining.com/bundles/post-licensing";
const brokerPostUrl = "https://portal.daniellarsontraining.com/bundles/broker-post-licensing";

const schema = [
  {
    "@type": "WebPage",
    "@id": `${site.url}/post-licensing/#webpage`,
    url: `${site.url}/post-licensing/`,
    name: "Florida Real Estate Post-Licensing Courses | Daniel Larson Training",
    description:
      "Self-paced Florida Sales and Broker Post-Licensing with complete course materials and an included FastPass final exam when you're ready to test out.",
    isPartOf: { "@id": `${site.url}/#website` },
    publisher: { "@id": `${site.url}/#organization` },
  },
  {
    "@type": "Course",
    "@id": `${site.url}/post-licensing/#sales-post`,
    name: "Florida 45-Hour Sales Associate Post-Licensing",
    description:
      "Self-paced Sales Associate first-renewal Post-Licensing with section PDFs, narrated lessons, review questions, and an included FastPass final exam.",
    provider: { "@id": `${site.url}/#organization` },
    inLanguage: "en-US",
  },
  {
    "@type": "Course",
    "@id": `${site.url}/post-licensing/#broker-post`,
    name: "Florida 60-Hour Broker Post-Licensing",
    description:
      "Self-paced Broker and Broker Associate first-renewal Post-Licensing with course material and an included FastPass final exam.",
    provider: { "@id": `${site.url}/#organization` },
    inLanguage: "en-US",
  },
];
---

<SiteLayout
  title="Florida Post-Licensing: Self-Paced + FastPass | Daniel Larson Training"
  description="Sales and Broker Post-Licensing with a complete self-paced course and an included FastPass final. Study what you need, then test out when you're ready."
  shareTitle="Post-Licensing"
  ogImage="/share-renewal-expanded-v2.png"
  canonicalPath="/post-licensing/"
  schema={schema}
>
  <div class="post-page">
    <section class="post-hero">
      <div class="shell post-hero-grid">
        <div class="post-hero-copy">
          <p class="post-eyebrow">Florida Post-Licensing · First Renewal</p>
          <h1>Self-paced Post.<br /><span>FastPass when you're ready.</span></h1>
          <p class="post-lead">
            <strong>Know the material? Go straight to the included FastPass final when you're ready to test out.</strong>
            Want a refresher? Read, listen, and review the complete course at your own pace.
            No page timers or forced lesson stops.
          </p>
          <div class="post-hero-actions">
            <a class="button button-primary" href="#post-options">Choose your Post course ↓</a>
            <a class="button button-secondary post-ghost" href="#post-course">See the course material</a>
          </div>
        </div>

        <aside class="post-help-card" data-tilt>
          <div class="post-help-brand">
            <img src="/fastpass-logo.webp" alt="FastPass" width="640" height="640" loading="eager" decoding="async" />
            <p class="post-help-kicker">The FastPass way to finish</p>
          </div>
          <h2>A full course when you want it. A final when you're ready.</h2>
          <p>
            Your enrollment includes the Post course and its FastPass final.
            Use the materials to prepare, or test out when you feel ready.
          </p>
          <span class="post-help-rule">No waiting through a lesson clock.</span>
        </aside>
      </div>
      <div class="post-trust" aria-label="Post-Licensing highlights">
        <div><strong>Self-paced</strong><span>move through material freely</span></div>
        <div><strong>FastPass final</strong><span>test out when ready</span></div>
        <div><strong>Sales or Broker</strong><span>choose your license path</span></div>
        <div><strong>Complete course</strong><span>PDFs, audio + review</span></div>
      </div>
    </section>

    <section class="post-options-section" id="post-options">
      <div class="shell">
        <header class="post-section-head" data-post-reveal>
          <p class="post-eyebrow">Choose by license type</p>
          <h2>Which Post course do you need?</h2>
          <p>Both options include the complete course and a FastPass final you can take when you're ready.</p>
        </header>
        <div class="post-options-grid">
          <article class="post-option" data-post-reveal>
            <div class="post-option-top">
              <div>
                <p class="post-option-kicker">Sales Associate · First Renewal</p>
                <h3>45-Hour Sales Post</h3>
              </div>
              <div class="post-price">$130</div>
            </div>
            <p class="post-option-copy">For Florida sales associates completing first-renewal Post-Licensing.</p>
            <p class="post-fastpass">
              <span>FastPass included</span>
              <strong>Ready to test out? Take the final without waiting through lessons.</strong>
            </p>
            <p class="post-material-label">The course is there when you need it</p>
            <ul>
              <li>Downloadable section PDFs</li>
              <li>Podcast-style narrated lessons</li>
              <li>Review questions and Florida practice material</li>
            </ul>
            <a class="button button-primary post-option-button" href={salesPostUrl} target="_top">
              View Sales Post course + FastPass →
            </a>
          </article>

          <article class="post-option" data-post-reveal>
            <div class="post-option-top">
              <div>
                <p class="post-option-kicker">Broker or Broker Associate · First Renewal</p>
                <h3>60-Hour Broker Post</h3>
              </div>
              <div class="post-price">$160</div>
            </div>
            <p class="post-option-copy">For Florida brokers and broker associates completing first-renewal Post-Licensing.</p>
            <p class="post-fastpass">
              <span>FastPass included</span>
              <strong>Ready to test out? Take the final without waiting through lessons.</strong>
            </p>
            <p class="post-material-label">The course is there when you need it</p>
            <ul>
              <li>Broker-focused section PDFs</li>
              <li>Narrated lessons you can listen to anywhere</li>
              <li>Review questions and brokerage practice material</li>
            </ul>
            <a class="button button-primary post-option-button" href={brokerPostUrl} target="_top">
              View Broker Post course + FastPass →
            </a>
          </article>
        </div>
        <p class="post-partner-note"><strong>Have a Partner Code?</strong> Enter it at checkout after reviewing the bundle. No code? Ask your broker, office manager, recruiter, or trainer.</p>
      </div>
    </section>

    <section class="post-course-system" id="post-course">
      <div class="shell post-system-grid">
        <header class="post-section-head" data-post-reveal>
          <p class="post-eyebrow">Inside your Post course</p>
          <h2>Read it. Listen to it. Review what matters.</h2>
          <p>
            Each Post course includes clear, downloadable section PDFs, narrated lessons, and review questions.
            Work through the material at your own pace or go straight to a topic you want to brush up on.
            Take the FastPass final when you're ready.
          </p>
        </header>
        <div class="post-tool-grid">
          <article data-post-reveal>
            <span>Read</span>
            <h3>Section PDFs</h3>
            <p>Clear, downloadable material you can return to after the exam.</p>
          </article>
          <article data-post-reveal>
            <span>Listen</span>
            <h3>Narrated lessons</h3>
            <p>Learn podcast-style or follow the narration with the written section.</p>
          </article>
          <article data-post-reveal>
            <span>Review</span>
            <h3>Questions that reinforce</h3>
            <p>Check your understanding of Florida rules and practical decisions.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="post-finish">
      <div class="shell post-finish-inner">
        <div data-post-reveal>
          <p class="post-eyebrow">After you pass</p>
          <h2>Finish the course. We'll report your completion.</h2>
          <p>
            Send your licensed name, license number, and completion date after passing
            FastPass. We report your completed course to DBPR; you complete your separate
            license renewal through MyFloridaLicense.com.
          </p>
        </div>
        <aside class="post-finish-aside" data-post-reveal>
          <strong>Ready to see your options?</strong>
          <p>Each button opens the existing bundle details so you can review what's included before checkout.</p>
          <a class="button button-primary" href={salesPostUrl} target="_top">View Sales Post details →</a>
          <a class="button button-secondary post-final-secondary" href={brokerPostUrl} target="_top">View Broker Post details →</a>
          <small>Not sure which one applies? <a href="sms:+12394718500">Text Daniel · {site.phoneDisplay}</a></small>
        </aside>
      </div>
    </section>
  </div>
</SiteLayout>
