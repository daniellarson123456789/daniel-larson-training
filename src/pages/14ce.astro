---
import SiteLayout from "../layouts/SiteLayout.astro";
import { site } from "../data/site";
import "../styles/14ce.css";

const bundleUrl = "https://portal.daniellarsontraining.com/bundles/14ce";

const schema = [
  {
    "@type": "Course",
    "@id": `${site.url}/14ce/#course`,
    name: "Florida 14-Hour Real Estate Continuing Education",
    description: "Florida 14-hour continuing education for Sales Associates and Brokers after Post-Licensing, with PDFs, narrated lessons, review questions, FastPass final exam, and completion reporting support.",
    provider: { "@id": `${site.url}/#organization` },
    inLanguage: "en-US",
  },
  {
    "@type": "WebPage",
    "@id": `${site.url}/14ce/#webpage`,
    url: `${site.url}/14ce/`,
    name: "Florida 14-Hour Real Estate Continuing Education | Daniel Larson Training",
    isPartOf: { "@id": `${site.url}/#website` },
    about: { "@id": `${site.url}/14ce/#course` },
    publisher: { "@id": `${site.url}/#organization` },
    inLanguage: "en-US",
  },
];
---

<SiteLayout
  title="Florida 14-Hour Real Estate Continuing Education | Daniel Larson Training"
  description="Florida 14-Hour CE for $65: downloadable section PDFs, audio-guided lessons, review questions, relevant bonus material, and an included FastPass final. Explore the bundle before enrolling."
  canonicalPath="/14ce/"
  schema={schema}
>
  <div class="ce-page">
    <section class="ce-hero">
      <div class="shell ce-hero-grid">
        <div class="ce-hero-copy">
          <p class="ce-eyebrow">Florida 14-Hour Continuing Education</p>
          <h1>14-Hour CE. Built to be finished.</h1>
          <p class="ce-lead">
            <strong>Read it. Listen to it. Review it. Use FastPass to test out when you're ready.</strong>
            Complete your Florida continuing education with downloadable section PDFs,
            audio-guided lessons, review questions, and practical bonus material.
          </p>

          <div class="ce-hero-actions">
            <a class="button button-primary" href={bundleUrl} target="_top">View course &amp; enroll</a>
            <a class="button button-secondary ce-ghost" href="#ce-inside">Explore the course ↓</a>
          </div>
        </div>

        <aside class="ce-buy-card" data-tilt>
          <p class="ce-buy-kicker">14-Hour CE · One-Time Enrollment</p>
          <div class="ce-price">$65</div>
          <p class="ce-buy-copy">
            For your second license period and every renewal after Post-Licensing is completed.
          </p>
          <a class="button button-primary ce-buy-button" href={bundleUrl} target="_top">View course details →</a>
          <div class="ce-buy-list">
            <span>✓ Section PDFs + narrated lessons</span>
            <span>✓ Review questions + bonus material</span>
            <span>✓ FastPass final + reporting support</span>
          </div>
          <p class="ce-partner">
            <strong>Have a Partner Code? Enter it at checkout.</strong><br />
            No code? Ask your broker, office manager, recruiter, or trainer.
          </p>
        </aside>
      </div>

      <div class="ce-trust">
        <div><strong>14 hours</strong><span>Florida CE</span></div>
        <div><strong>Sales + Brokers</strong><span>after Post-Licensing</span></div>
        <div><strong>Self-paced</strong><span>read, listen + review</span></div>
        <div><strong>PDF + audio</strong><span>learn your way</span></div>
        <div><strong>FastPass final</strong><span>included</span></div>
      </div>
    </section>

    <section class="ce-learn" id="ce-inside">
      <div class="shell ce-learn-grid">
        <header class="ce-section-head ce-section-head-dark" data-ce-reveal>
          <p class="ce-eyebrow">Inside the course</p>
          <h2>Read it. Listen to it. Or use both.</h2>
          <p>
            Follow the written material, listen podcast-style, or play the narration while
            reading along with a section PDF. Keep the material to revisit later.
          </p>
        </header>

        <div class="ce-tool-grid">
          <article data-ce-reveal>
            <span>Download + Read</span>
            <h3>Professionally formatted PDFs</h3>
            <p>Read inside the course or download each section for later reference.</p>
          </article>
          <article data-ce-reveal>
            <span>Play + Follow Along</span>
            <h3>Audio-guided lessons</h3>
            <p>Listen podcast-style or use the narration as a companion to the written section.</p>
          </article>
          <article data-ce-reveal>
            <span>Check Understanding</span>
            <h3>Section review questions</h3>
            <p>Reinforce important rules and concepts whenever you want a confidence check.</p>
          </article>
          <article data-ce-reveal>
            <span>Finish Efficiently</span>
            <h3>FastPass final exam</h3>
            <p>A clear, on-demand final exam is included with the $65 enrollment.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="ce-curriculum">
      <div class="shell">
        <header class="ce-section-head" data-ce-reveal>
          <p class="ce-eyebrow">Inside your 14 hours</p>
          <h2>The subjects behind your 14 hours.</h2>
          <p>
            Four focused education areas connect Florida requirements with the work licensees do.
          </p>
        </header>

        <div class="ce-curriculum-grid">
          <article data-ce-reveal>
            <strong>01</strong>
            <span>Required Education</span>
            <h3>Law + required procedures</h3>
            <p>Florida law, licensee duties, advertising, compensation, brokerage relationships, and consumer protection.</p>
          </article>
          <article data-ce-reveal>
            <strong>02</strong>
            <span>Professional Standards</span>
            <h3>REALTOR® Ethics</h3>
            <p>Professional conduct, ethical decision-making, case applications, communication, and cooperation.</p>
          </article>
          <article data-ce-reveal>
            <strong>03</strong>
            <span>Practical Business</span>
            <h3>Business planning</h3>
            <p>Systems, planning, marketing, client service, risk awareness, and sustainable professional practice.</p>
          </article>
          <article data-ce-reveal>
            <strong>04</strong>
            <span>Market Knowledge</span>
            <h3>Property valuation</h3>
            <p>Market analysis, pricing logic, comparable properties, value considerations, and responsible communication.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="ce-bonus">
      <div class="shell">
        <header class="ce-section-head ce-section-head-light" data-ce-reveal>
          <p class="ce-eyebrow">Current course material</p>
          <h2>Current bonus material and meaningful updates.</h2>
          <p>
            The course includes practical bonus material and can grow when significant legal,
            licensing, or industry changes call for a clear explanation.
          </p>
        </header>

        <div class="ce-bonus-grid">
          <article data-ce-reveal>
            <p>Bonus</p>
            <h3>NAR settlement overview</h3>
            <span>
              Written buyer agreements, compensation communication, what changed nationally,
              and how those practice changes relate to Florida licensees.
            </span>
          </article>
          <article data-ce-reveal>
            <p>Course Update</p>
            <h3>Post, CE + renewal</h3>
            <span>
              Which education applies to which license period, how completion is reported,
              what deadlines matter, and what you still do through MyFloridaLicense.com.
            </span>
          </article>
        </div>
      </div>
    </section>

    <section class="ce-finish">
      <div class="shell">
        <header class="ce-section-head ce-section-head-dark" data-ce-reveal>
          <p class="ce-eyebrow">After the final exam</p>
          <h2>We report the education. You complete the renewal.</h2>
          <p>
            Passing the FastPass final completes the course side. Reporting and the separate state renewal transaction come next.
          </p>
        </header>

        <div class="ce-finish-grid">
          <article data-ce-reveal>
            <strong>1</strong>
            <h3>Use the course materials.</h3>
            <p>Read, listen, and review as much — or as little — as you need.</p>
          </article>
          <article data-ce-reveal>
            <strong>2</strong>
            <h3>Pass FastPass.</h3>
            <p>Complete the included 14CE FastPass final exam.</p>
          </article>
          <article data-ce-reveal>
            <strong>3</strong>
            <h3>Send your information.</h3>
            <p>Email your full licensed name, license number, and course completion date.</p>
          </article>
          <article data-ce-reveal>
            <strong>4</strong>
            <h3>Renew with the state.</h3>
            <p>We report completion, and you finish renewal through MyFloridaLicense.com.</p>
          </article>
        </div>

        <div class="ce-warning">
          <span>!</span>
          <p>
            <strong>Reporting timing:</strong> Daniel Larson Training reports completion to DBPR within
            24 hours after receiving your full licensed name, license number, and completion date.
            State processing may take approximately 3–5 business days.
          </p>
        </div>
      </div>
    </section>

    <section class="ce-clarity">
      <div class="shell ce-clarity-grid">
        <div>
          <p class="ce-eyebrow">Post-Licensing or CE?</p>
          <h2>14-Hour CE is the ongoing renewal path.</h2>
          <p>
            If you are still at the first renewal after earning a new Sales Associate or Broker license,
            you may need Post-Licensing instead. After Post-Licensing is completed, 14-Hour CE is the
            continuing-education requirement used for later renewal periods.
          </p>
        </div>
        <aside>
          <strong>Not sure?</strong>
          <p>Text Daniel before enrolling and we will help identify the right course.</p>
          <a href="sms:+12394718500">Text 239.471.8500 →</a>
        </aside>
      </div>
    </section>

    <section class="ce-final">
      <div class="shell ce-final-inner">
        <div>
          <p class="ce-eyebrow">Florida 14-Hour CE</p>
          <h2>See everything included in your CE.</h2>
          <p>Explore the course and included FastPass final on the bundle page before enrolling.</p>
        </div>
        <a class="button button-primary" href={bundleUrl} target="_top">View 14-Hour CE details</a>
      </div>
    </section>
  </div>
</SiteLayout>
