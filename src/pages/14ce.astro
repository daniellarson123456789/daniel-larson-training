---
import SiteLayout from "../layouts/SiteLayout.astro";
import TrustpilotReviews from "../components/TrustpilotReviews.astro";
import TrustpilotReviewLink from "../components/TrustpilotReviewLink.astro";
import LicensingSale from "../components/LicensingSale.astro";
import OriginalPrice from "../components/OriginalPrice.astro";
import { site } from "../data/site";
import { products, salePrice } from "../data/products";
import { courseOffer } from "../lib/courseOffer";
import "../styles/14ce.css";

const ce = products.ce14;
const offerPrice = salePrice(ce);
const bundleUrl = ce.checkoutUrl;
const pageTitle = `Florida 14-Hour CE $${offerPrice} with Coupon | Daniel Larson Training`;
const pageDescription = `Florida 14-Hour CE with FastPass final exam for $${offerPrice} with code ${ce.couponCode} (regularly $${ce.price}). Self-paced course, PDFs, audio, and automated DBPR reporting included.`;

const schema = [
  {
    "@type": "Course",
    "@id": `${site.url}/14ce/#course`,
    name: "Florida 14-Hour Real Estate Continuing Education with FastPass final exam",
    description: pageDescription,
    provider: { "@id": `${site.url}/#organization` },
    inLanguage: "en-US",
    offers: courseOffer(ce),
  },
  {
    "@type": "WebPage",
    "@id": `${site.url}/14ce/#webpage`,
    url: `${site.url}/14ce/`,
    name: pageTitle,
    description: pageDescription,
    dateModified: "2026-10-31",
    isPartOf: { "@id": `${site.url}/#website` },
    about: { "@id": `${site.url}/14ce/#course` },
    publisher: { "@id": `${site.url}/#organization` },
    inLanguage: "en-US",
  },
];
---

<SiteLayout
  title={pageTitle}
  description={pageDescription}
  shareTitle={`14-Hour CE — $${offerPrice} with ${ce.couponCode}`}
  ogImage="/share-renewal-expanded-v2.png"
  canonicalPath="/14ce/"
  schema={schema}
>
  <div class="ce-page">
    <LicensingSale variant="ce" />
    <section class="ce-hero">
      <div class="shell ce-hero-grid">
        <div class="ce-hero-copy">
          <p class="ce-eyebrow">Florida 14-Hour Continuing Education</p>
          <h1>Self-paced CE.<br /><span>With FastPass final exam.</span></h1>
          <p class="ce-lead">
            <strong>Already know the material? Go straight to the included FastPass final exam when you're ready to test out.</strong>
            If you want to study, read, listen, and review the complete 14-hour course at your own pace.
            No page timers or forced lesson stops.
          </p>
          <div class="ce-hero-actions">
            <a class="button button-primary" href={`https://portal.daniellarsontraining.com/bundles/14ce?coupon=${ce.couponCode}`} target="_top">Explore 14-Hour CE with FastPass Final Exam →</a>
            <a class="button button-secondary ce-ghost" href="#ce-inside">See the course material ↓</a>
          </div>
          <TrustpilotReviewLink />
        </div>

        <aside class="ce-buy-card" data-tilt>
          <div class="ce-buy-brand">
            <img src="/fastpass-logo.webp" alt="FastPass" width="640" height="640" loading="eager" decoding="async" />
            <p class="ce-buy-kicker">Complete 14-Hour CE with FastPass final exam</p>
          </div>
          <div class="ce-price">
            <span class="ce-price-was" aria-label={`Regular price $${ce.price}`}><OriginalPrice amount={ce.price} /></span>
            <span class="ce-price-now" aria-label={`$${offerPrice} with code ${ce.couponCode}`}>${offerPrice}</span>
          </div>
          <p class="ce-coupon-note">With code <strong>{ce.couponCode}</strong> · Save ${ce.discountAmount}</p>
          <h2>Take the final when you're ready.</h2>
          <p class="ce-buy-copy">
            Your enrollment includes a full CE course to use whenever you need it,
            and the FastPass final exam to test out.
          </p>
          <a class="button button-primary ce-buy-button" href={bundleUrl} target="_top">Purchase Bundle →</a>
          <p class="ce-buy-foot">Coupon applied automatically. One-time enrollment.</p>
        </aside>
      </div>
      <div class="ce-trust" aria-label="CE course highlights">
        <div><strong>Self-paced</strong><span>no page timers</span></div>
        <div><strong>FastPass final exam</strong><span>test out when ready</span></div>
        <div><strong>Complete course</strong><span>PDFs, audio + review</span></div>
        <div><strong>Sales + Brokers</strong><span>after Post-Licensing</span></div>
      </div>
    </section>

    <TrustpilotReviews context="ce" />

    <section class="ce-learn" id="ce-inside">
      <div class="shell ce-learn-grid">
        <header class="ce-section-head" data-ce-reveal>
          <p class="ce-eyebrow">Use the course when it helps you</p>
          <h2>Good material. No forced march.</h2>
          <p>
            Read a section, listen while you're out, or review a topic before the final.
            The material is there to make the education useful, even when your aim is to finish efficiently.
          </p>
        </header>
        <div class="ce-tool-grid">
          <article data-ce-reveal>
            <span>Read</span>
            <h3>Downloadable section PDFs</h3>
            <p>Clear material to read inside the course and keep for later reference.</p>
          </article>
          <article data-ce-reveal>
            <span>Listen</span>
            <h3>Audio-guided lessons</h3>
            <p>Listen podcast-style or follow along with the section PDF.</p>
          </article>
          <article data-ce-reveal>
            <span>Review</span>
            <h3>Section review questions</h3>
            <p>Check the concepts you want to reinforce before FastPass.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="ce-curriculum">
      <div class="shell">
        <header class="ce-section-head" data-ce-reveal>
          <p class="ce-eyebrow">Inside your CE</p>
          <h2>Useful topics, there when you need them.</h2>
          <p>Florida law, ethics, and practical real estate subjects in a course you can return to.</p>
        </header>
        <div class="ce-curriculum-grid">
          <article data-ce-reveal>
            <span>Florida rules</span>
            <h3>Law + required procedures</h3>
            <p>Licensee duties, brokerage relationships, advertising, and consumer protection.</p>
          </article>
          <article data-ce-reveal>
            <span>Professional standards</span>
            <h3>Ethics + business practices</h3>
            <p>Real decisions, responsible communication, and professional conduct.</p>
          </article>
          <article data-ce-reveal>
            <span>Specialty topics</span>
            <h3>Business + valuation</h3>
            <p>Planning, client service, market analysis, and pricing logic.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="ce-finish">
      <div class="shell ce-finish-inner">
        <div data-ce-reveal>
          <p class="ce-eyebrow">When you're ready</p>
          <h2>Pass your final exam. We report your completion.</h2>
          <p>
            Your licensed name and license number are collected before the final exam.
            After you pass, your completion is reported to DBPR automatically within
            1 business day, guaranteed. You complete the separate license renewal through MyFloridaLicense.com.
          </p>
        </div>
        <aside class="ce-finish-aside" data-ce-reveal>
          <strong>14-Hour CE with FastPass final exam</strong>
          <div class="ce-price ce-price-compact">
            <span class="ce-price-was" aria-label={`Regular price $${ce.price}`}><OriginalPrice amount={ce.price} /></span>
            <span class="ce-price-now" aria-label={`$${offerPrice} with code ${ce.couponCode}`}>${offerPrice}</span>
          </div>
          <p>Use code <strong>{ce.couponCode}</strong>. Coupon applied automatically when you purchase.</p>
          <a class="button button-primary" href={bundleUrl} target="_top">Purchase Bundle →</a>
          <small>Not sure whether you need CE or Post-Licensing? <a href="sms:+12394718500">Text Daniel · {site.phoneDisplay}</a></small>
        </aside>
      </div>
    </section>
  </div>
</SiteLayout>

