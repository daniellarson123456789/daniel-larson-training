---
import SiteLayout from "../layouts/SiteLayout.astro";
import { site } from "../data/site";
import "../styles/14ce-wix.css";


const schema = [
  {
    "@type": "Course",
    "@id": `${site.url}/14ce/#course`,
    name: "Florida 14-Hour Real Estate Continuing Education",
    description: "Florida 14-hour continuing education for Sales Associates and Brokers after Post-Licensing, with PDFs, narrated lessons, review questions, FastPass final exam, and completion reporting support.",
    provider: { "@id": `${site.url}/#organization` },
    inLanguage: "en-US",
  },
  {
    "@type": "WebPage",
    "@id": `${site.url}/14ce/#webpage`,
    url: `${site.url}/14ce/`,
    name: "Florida 14-Hour Real Estate Continuing Education | Daniel Larson Training",
    isPartOf: { "@id": `${site.url}/#website` },
    about: { "@id": `${site.url}/14ce/#course` },
    publisher: { "@id": `${site.url}/#organization` },
    inLanguage: "en-US",
  },
];
---

<SiteLayout
  title="Florida 14-Hour Real Estate Continuing Education | Daniel Larson Training"
  description="Complete your required Florida continuing education in a clear, modern course that works like an audiobook-style read-along — with downloadable PDFs, narrated lessons, review questions, and current bonus material."
  canonicalPath="/14ce/"
  schema={schema}
>
  <div class="wix-course-shell">
<section class="dlt-ce" aria-label="Florida 14-hour continuing education">
    <div class="dlt-ce__wrap">

      <div class="dlt-ce__hero">
        <div>
          <p class="dlt-ce__eyebrow"><span class="dlt-ce__liveDot" aria-hidden="true"></span>Florida Sales Associates + Brokers • Updated Course Experience</p>
          <h1 class="dlt-ce__title">14-Hour CE — Built to Be Finished</h1>
          <p class="dlt-ce__lead">
            <strong>Read it. Listen to it. Review it. Pass the FastPass final exam.</strong>
            Complete your required Florida continuing education in a clear, modern course that works like an audiobook-style read-along — with downloadable PDFs, narrated lessons, review questions, and current bonus material.
          </p>

          <div class="dlt-ce__pills" aria-label="Course highlights">
            <span class="dlt-ce__pill dlt-ce__pill--accent">FastPass Final Included</span>
            <span class="dlt-ce__pill">Self-Paced</span>
            <span class="dlt-ce__pill">Section PDFs</span>
            <span class="dlt-ce__pill">Audio-Guided Lessons</span>
          </div>

          <p class="dlt-ce__fastLine">
            <strong>Use FastPass to test out when you're ready.</strong> Read, listen, and review as much — or as little — as you need.
          </p>

        </div>

        <aside class="dlt-ce__buybox" id="dlt-ce-enroll" aria-label="Enroll in 14-hour continuing education">
          <p class="dlt-ce__buyLabel">Complete Course + Final Exam</p>
          <div class="dlt-ce__price">$65</div>
          <p class="dlt-ce__priceNote">
            For your second license period and every renewal after Post-Licensing is completed.
          </p>

          <div class="dlt-ce__buttonHost">
            <a class="dlt-ce__checkoutButton" href="https://portal.daniellarsontraining.com/bundles/14ce" target="_top" aria-label="Start Florida 14-hour continuing education">View Course &amp; Enroll <span class="dlt-ce__checkoutArrow" aria-hidden="true">→</span>
            </a>
          </div>

          <div class="dlt-ce__partnerCode">
            <strong>Have a Partner Code?</strong>
            Enter it at checkout. No code? Ask your broker, office manager, recruiter, or trainer if they have a Daniel Larson Training Partner Code.
          </div>

          <div class="dlt-ce__mini">
            <div class="dlt-ce__miniItem"><span class="dlt-ce__check">✓</span><span>Course and separate 14CE FastPass final exam are included.</span></div>
            <div class="dlt-ce__miniItem"><span class="dlt-ce__check">✓</span><span>Completion reported within 24 hours after we receive your required license information.</span></div>
            <div class="dlt-ce__miniItem"><span class="dlt-ce__check">✓</span><span>You complete the final renewal step through MyFloridaLicense.com.</span></div>
          </div>
        </aside>
      </div>

      <div class="dlt-ce__band" aria-label="FastPass course process">
        <div class="dlt-ce__bandItem">
          <p class="dlt-ce__bandTitle">1. Start Anywhere</p>
          <p class="dlt-ce__bandText">Read it, listen to it, review it — or move ahead when you're ready.</p>
        </div>
        <div class="dlt-ce__bandItem">
          <p class="dlt-ce__bandTitle">2. Test Out with FastPass</p>
          <p class="dlt-ce__bandText">Go straight to the included on-demand final exam when you feel ready.</p>
        </div>
        <div class="dlt-ce__bandItem">
          <p class="dlt-ce__bandTitle">3. Send Your License Info</p>
          <p class="dlt-ce__bandText">After you pass, send us the information we need to report completion.</p>
        </div>
        <div class="dlt-ce__bandItem">
          <p class="dlt-ce__bandTitle">4. We Report. You Renew.</p>
          <p class="dlt-ce__bandText">We report to DBPR; you complete renewal through MyFloridaLicense.com.</p>
        </div>
      </div>

      <section class="dlt-ce__section" aria-labelledby="learn-your-way">
        <div class="dlt-ce__sectionHead">
          <h3 class="dlt-ce__sectionTitle" id="learn-your-way">Read It, Listen to It, or Use Both</h3>
          <p class="dlt-ce__sectionText">
            This is not a wall of online text. Each major course area is organized so you can follow the written material, listen like a podcast, or play the narrated lesson while reading along with the PDF.
          </p>
        </div>

        <div class="dlt-ce__learnGrid">
          <article class="dlt-ce__card">
            <p class="dlt-ce__cardKicker">Download + Read</p>
            <h4 class="dlt-ce__cardTitle">Professionally Formatted PDFs</h4>
            <p class="dlt-ce__cardText">Open each section inside the course, read online, or download the material for later reference.</p>
          </article>
          <article class="dlt-ce__card">
            <p class="dlt-ce__cardKicker">Play + Follow Along</p>
            <h4 class="dlt-ce__cardTitle">Audio-Guided Lessons</h4>
            <p class="dlt-ce__cardText">Listen in a podcast-style format or use the narration as an audiobook-style companion to the written section.</p>
          </article>
          <article class="dlt-ce__card">
            <p class="dlt-ce__cardKicker">Check Understanding</p>
            <h4 class="dlt-ce__cardTitle">Section Review Questions</h4>
            <p class="dlt-ce__cardText">Review important rules and concepts throughout the course before moving to the FastPass final exam.</p>
          </article>
        </div>
      </section>

      <section class="dlt-ce__section" aria-labelledby="included">
        <div class="dlt-ce__sectionHead">
          <h3 class="dlt-ce__sectionTitle" id="included">Everything Included in One Enrollment</h3>
          <p class="dlt-ce__sectionText">
            The $65 bundle includes the complete 14-hour course and the separate 14CE EXAM PASS course used to complete your FastPass final exam.
          </p>
        </div>

        <div class="dlt-ce__featureGrid">
          <article class="dlt-ce__card">
            <p class="dlt-ce__cardKicker">Required Education</p>
            <h4 class="dlt-ce__cardTitle">Core Law and Procedures</h4>
            <p class="dlt-ce__cardText">Florida law, licensing responsibilities, advertising, compensation, brokerage practice, and required procedures.</p>
          </article>
          <article class="dlt-ce__card">
            <p class="dlt-ce__cardKicker">Professional Standards</p>
            <h4 class="dlt-ce__cardTitle">REALTOR® Ethics</h4>
            <p class="dlt-ce__cardText">Ethical duties, professional conduct, cooperation, communication, and real-world application.</p>
          </article>
          <article class="dlt-ce__card">
            <p class="dlt-ce__cardKicker">Practical Business</p>
            <h4 class="dlt-ce__cardTitle">Business Planning</h4>
            <p class="dlt-ce__cardText">Planning, systems, marketing, client service, risk awareness, and sustainable professional practice.</p>
          </article>
          <article class="dlt-ce__card">
            <p class="dlt-ce__cardKicker">Market Knowledge</p>
            <h4 class="dlt-ce__cardTitle">Property Valuation</h4>
            <p class="dlt-ce__cardText">Market analysis, value, pricing logic, comparable properties, and communicating valuation responsibly.</p>
          </article>
          <article class="dlt-ce__card">
            <p class="dlt-ce__cardKicker">Course Tools</p>
            <h4 class="dlt-ce__cardTitle">PDFs + Narrated Lessons</h4>
            <p class="dlt-ce__cardText">Written and audio-guided versions make the course easier to follow on a computer, tablet, or phone.</p>
          </article>
          <article class="dlt-ce__card">
            <p class="dlt-ce__cardKicker">Finish Confidently</p>
            <h4 class="dlt-ce__cardTitle">FastPass Final Exam</h4>
            <p class="dlt-ce__cardText">A clear, on-demand final exam designed to make course completion manageable and low-stress.</p>
          </article>
        </div>
      </section>

      <section class="dlt-ce__section" aria-labelledby="course-roadmap">
        <div class="dlt-ce__sectionHead">
          <h3 class="dlt-ce__sectionTitle" id="course-roadmap">Course Roadmap</h3>
          <p class="dlt-ce__sectionText">The main course is organized into four focused education sections, followed by your included FastPass final exam.</p>
        </div>

        <div class="dlt-ce__roadmap">
          <article class="dlt-ce__roadItem">
            <div class="dlt-ce__roadNum">01</div>
            <div>
              <h4 class="dlt-ce__roadTitle">Law and Required Procedures</h4>
              <p class="dlt-ce__roadText">Core law, licensee duties, advertising, compensation, brokerage relationships, and consumer protection.</p>
            </div>
          </article>
          <article class="dlt-ce__roadItem">
            <div class="dlt-ce__roadNum">02</div>
            <div>
              <h4 class="dlt-ce__roadTitle">REALTOR® Ethics</h4>
              <p class="dlt-ce__roadText">Professional standards, ethical decision-making, case applications, and cooperation with other professionals.</p>
            </div>
          </article>
          <article class="dlt-ce__roadItem">
            <div class="dlt-ce__roadNum">03</div>
            <div>
              <h4 class="dlt-ce__roadTitle">Business Planning</h4>
              <p class="dlt-ce__roadText">Systems, planning, marketing, client service, and practical business development.</p>
            </div>
          </article>
          <article class="dlt-ce__roadItem">
            <div class="dlt-ce__roadNum">04</div>
            <div>
              <h4 class="dlt-ce__roadTitle">Property Valuation</h4>
              <p class="dlt-ce__roadText">Pricing, market data, comparable analysis, value considerations, and responsible communication.</p>
            </div>
          </article>
        </div>
      </section>

      <section class="dlt-ce__section" aria-labelledby="course-updates">
        <div class="dlt-ce__sectionHead">
          <h3 class="dlt-ce__sectionTitle" id="course-updates">Current Bonus Sections and Meaningful Updates</h3>
          <p class="dlt-ce__sectionText">
            Real estate practice changes. The course includes practical bonus material now and is updated when significant rules, renewal requirements, or industry changes affect Florida licensees.
          </p>
        </div>

        <div class="dlt-ce__bonusGrid">
          <article class="dlt-ce__bonus">
            <h4 class="dlt-ce__bonusTitle">NAR Settlement Overview</h4>
            <p class="dlt-ce__bonusText">Understand what changed, what did not, written buyer agreements, compensation communication, and how the national practice changes relate to Florida licensees.</p>
          </article>
          <article class="dlt-ce__bonus">
            <h4 class="dlt-ce__bonusTitle">Post, CE and Renewal</h4>
            <p class="dlt-ce__bonusText">Know which education applies to your license period, how completion is reported, what deadlines matter, and what you must still do through MyFloridaLicense.com.</p>
          </article>
        </div>

        <div class="dlt-ce__updateNote">
          New bonus material can be added when a major legal, licensing, or industry change deserves a clear explanation for Florida professionals.
        </div>
      </section>

      <section class="dlt-ce__section" aria-labelledby="finish-course">
        <div class="dlt-ce__sectionHead">
          <h3 class="dlt-ce__sectionTitle" id="finish-course">The FastPass Finish Line</h3>
          <p class="dlt-ce__sectionText">
            Use the course material however it helps you. When you're ready, FastPass gets you to the final exam — then we handle the reporting step and you renew with the state.
          </p>
        </div>

        <div class="dlt-ce__stepsGrid">
          <article class="dlt-ce__stepCard">
            <p class="dlt-ce__stepNum">Step 1</p>
            <h4 class="dlt-ce__stepTitle">Use What You Need</h4>
            <p class="dlt-ce__stepText">Read, listen, and review at your own pace. You are not locked into a forced lesson sequence.</p>
          </article>
          <article class="dlt-ce__stepCard">
            <p class="dlt-ce__stepNum">Step 2</p>
            <h4 class="dlt-ce__stepTitle">Test Out with FastPass</h4>
            <p class="dlt-ce__stepText">When you're ready, open the included 14CE EXAM PASS course and take the final exam.</p>
          </article>
          <article class="dlt-ce__stepCard">
            <p class="dlt-ce__stepNum">Step 3</p>
            <h4 class="dlt-ce__stepTitle">Send Your Information</h4>
            <p class="dlt-ce__stepText">Email your full licensed name, license number, and course completion date to the school.</p>
          </article>
          <article class="dlt-ce__stepCard">
            <p class="dlt-ce__stepNum">Step 4</p>
            <h4 class="dlt-ce__stepTitle">We Report. You Renew.</h4>
            <p class="dlt-ce__stepText">We report your completion, and you finish renewal through MyFloridaLicense.com.</p>
          </article>
        </div>

        <div class="dlt-ce__important">
          <div class="dlt-ce__importantMark">!</div>
          <p class="dlt-ce__importantText">
            <strong>Reporting timing:</strong> We report course completion to DBPR within 24 hours after receiving your full licensed name, license number, and completion date. The state may then take approximately 3–5 business days to post the completion. Your certificate is for your records; it does not replace the separate license-renewal step.
          </p>
        </div>
      </section>

      <section class="dlt-ce__final" aria-label="Final enrollment call to action">
        <div>
          <h3 class="dlt-ce__finalTitle">Complete Your Florida 14-Hour CE for $65</h3>
          <p class="dlt-ce__finalText">
            Course PDFs, audio-guided lessons, review questions, current bonus sections, the FastPass final exam, and school reporting are all included.
          </p>
        </div>
        <a class="dlt-ce__directButton" href="https://portal.daniellarsontraining.com/bundles/14ce" target="_top">View Course &amp; Enroll</a>
      </section>

      <footer class="dlt-ce__foot">
        <div><strong>Not sure whether you need Post-Licensing or CE?</strong> Contact us and we will help identify the correct course.</div>
        <div><a href="tel:12394718500">239.471.8500</a>  •  <a href="mailto:daniel@daniellarsontraining.com">daniel@daniellarsontraining.com</a></div>
      </footer>

    </div>
  </section>

  
  </div>
</SiteLayout>
