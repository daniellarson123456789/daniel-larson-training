---
import SiteLayout from "../layouts/SiteLayout.astro";
import TrustpilotReviews from "../components/TrustpilotReviews.astro";
import CheckoutNote from "../components/CheckoutNote.astro";
import { site } from "../data/site";
import { products, salePrice } from "../data/products";
import { courseOffer } from "../lib/courseOffer";
import { faqPage } from "../lib/seo";
import { ceFaqs } from "../data/renewalFaqs";
import "../styles/draft-sales.css";

const ce = products.ce14;
const offerPrice = salePrice(ce);
const pageTitle = "Fastest Florida 14-Hour CE Online: Final Exam When Ready | Real Estate FastPass";
const pageDescription = `The fastest way to finish Florida 14-hour real estate CE online: self-paced, no page timers, and the FastPass final exam when you’re ready. 3 hours Core Law, 3 Ethics, 8 specialty, $${offerPrice}, with DBPR reporting. Then renew with DBPR.`;

const schema = [
  {
    "@type": "Course",
    "@id": `${site.url}/14ce/#course`,
    url: `${site.url}/14ce/`,
    name: "Florida 14-Hour Real Estate Continuing Education with FastPass final exam",
    description: `${pageDescription} Covers 3 hours Core Law, 3 hours Ethics and Business Practices, and 8 hours specialty education.`,
    provider: { "@id": `${site.url}/#organization` },
    inLanguage: "en-US",
    educationalLevel: "Florida real estate continuing education (renewals after the first)",
    offers: courseOffer(ce),
  },
  {
    "@type": "WebPage",
    "@id": `${site.url}/14ce/#webpage`,
    url: `${site.url}/14ce/`,
    name: pageTitle,
    description: pageDescription,
    dateModified: "2026-11-19",
    isPartOf: { "@id": `${site.url}/#website` },
    about: { "@id": `${site.url}/14ce/#course` },
    mainEntity: { "@id": `${site.url}/14ce/#course` },
    publisher: { "@id": `${site.url}/#organization` },
    inLanguage: "en-US",
  },
  faqPage(`${site.url}/14ce/#faq`, ceFaqs.map((f) => ({ name: f.q, text: f.a }))),
];
---

<SiteLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath="/14ce/"
  schema={schema}
>
  <div class="draft-sales lic-style">
    <section class="draft-hero">
      <div class="wrap draft-hero-grid">
        <div class="draft-hero-intro">
          <p class="draft-kicker">
            <span class="draft-brand">{site.name}</span>
            <span class="draft-school">{site.tagline}</span>
          </p>
          <h1>The fastest way to finish Florida <em class="fast">14‑hour CE</em> online.</h1>
          <p class="lic-q">What’s the fastest way to finish Florida <em class="lic-em">14‑hour CE?</em></p>
          <p class="lead">Take it online with <em class="lic-em">FastPass</em>. It’s self-paced with no page timers, so if you already know the material you can move fast, then take the final exam when you’re ready.</p>
          <a class="draft-link-more" href="#ce-deadline">Find my renewal date <span aria-hidden="true">→</span></a>
        </div>
        <aside class="draft-hero-panel">
          <div class="draft-hero-price">${offerPrice}<span>One-time enrollment · Sales and Brokers after Post-Licensing</span></div>
          <h2>All 14 hours in one course.</h2>
          <div class="draft-hero-includes">
            <p class="draft-hero-includes-label">Includes</p>
            <ul>
              <li>3 hours Core Law</li>
              <li>3 hours Ethics and Business Practices</li>
              <li>8 hours specialty education</li>
            </ul>
            <p class="draft-hero-includes-extra">Online and self-paced, with the FastPass final exam</p>
          </div>
          <a class="draft-btn primary" data-plan={ce.id} data-placement="hero_panel" href={ce.checkoutUrl} target="_top">Start 14-Hour CE — ${offerPrice}</a>
          <CheckoutNote />
        </aside>
      </div>
    </section>

    <section class="draft-section soft" id="ce-deadline">
      <div class="wrap">
        <p class="draft-eyebrow">Renewal deadline</p>
        <h2>Find my renewal date</h2>
        <p class="intro">Your renewal date is the expiration date on your license. Florida licenses expire on March 31 or September 30, and after your first renewal they renew every two years.</p>
        <div class="draft-feature-grid">
          <article class="draft-feature"><h3>Find your date</h3><p>Your expiration date is in your <a href="https://www2.myfloridalicense.com/">DBPR account at MyFloridaLicense.com</a>. DBPR sends a renewal notice before it.</p></article>
          <article class="draft-feature"><h3>If you miss it</h3><p>The license goes involuntary inactive. You have 12 months to finish the 14 hours and pay the fees, plus a late fee.</p></article>
          <article class="draft-feature"><h3>First renewal?</h3><p>Your first renewal needs <a href="/post-licensing/">Post-Licensing online</a> instead: 45 hours for sales associates, 60 for brokers.</p></article>
          <article class="draft-feature"><h3>Not sure where you stand?</h3><p><a href="sms:+12394718500">Text Daniel at {site.phoneDisplay}</a> with your question and he’ll tell you exactly what you need.</p></article>
        </div>
        <p class="lic-fine">Want the full breakdown? <a href="/license-guides/continuing-education/">Florida real estate CE requirements</a> · <a href="/license-guides/post-licensing-vs-ce/">Post-Licensing or CE: which do I need?</a></p>
      </div>
    </section>

    <TrustpilotReviews context="ce" />

    <section class="draft-section" id="ce-inside">
      <div class="wrap">
        <p class="draft-eyebrow">Use the course when it helps you</p>
        <h2>Good material. No forced march.</h2>
        <p class="intro">Read a section, listen while you’re out, or review a topic before the final. The material is there to make the education useful, even when your aim is to finish efficiently.</p>
        <div class="draft-feature-grid">
          <article class="draft-feature" id="include-ce-course"><h3>The complete 14-hour course</h3><p>Read, listen, and review the full CE course at your own pace. No page timers or forced lesson stops.</p></article>
          <article class="draft-feature" id="include-ce-pdfs"><h3>Downloadable section PDFs</h3><p>Clear material to read inside the course and keep for later reference.</p></article>
          <article class="draft-feature" id="include-ce-audio"><h3>Audio-guided lessons</h3><p>Listen podcast-style or follow along with the section PDF.</p></article>
          <article class="draft-feature" id="include-ce-review"><h3>Section review questions</h3><p>Check the concepts you want to reinforce before FastPass.</p></article>
          <article class="draft-feature" id="include-ce-final"><h3>FastPass final exam</h3><p>Test out when you’re ready.</p></article>
          <article class="draft-feature" id="include-ce-reporting"><h3>DBPR reporting</h3><p>After you pass, we report your completion to DBPR.</p></article>
        </div>
      </div>
    </section>

    <section class="draft-section soft" id="faq">
      <div class="wrap">
        <p class="draft-eyebrow">Questions</p>
        <h2>Your 14‑hour CE and renewal questions, answered</h2>
        <div class="faq-list">
          {ceFaqs.map((f) => (<details><summary>{f.q}</summary><p>{f.a}</p></details>))}
        </div>
      </div>
    </section>

    <section class="draft-section navy final-cta">
      <div class="wrap">
        <h2>Pass your final exam. We report your completion.</h2>
        <span class="checkout-cta">
          <a class="draft-btn primary" data-plan={ce.id} data-placement="final_cta" href={ce.checkoutUrl} target="_top">Start 14-Hour CE — ${offerPrice}</a>
          <CheckoutNote />
        </span>
      </div>
    </section>
  </div>
</SiteLayout>
