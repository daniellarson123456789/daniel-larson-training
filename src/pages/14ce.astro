---
import SiteLayout from "../layouts/SiteLayout.astro";
import TrustpilotReviews from "../components/TrustpilotReviews.astro";
import CheckoutNote from "../components/CheckoutNote.astro";
import { site } from "../data/site";
import { products, salePrice } from "../data/products";
import { courseOffer } from "../lib/courseOffer";
import { faqPage } from "../lib/seo";
import "../styles/draft-sales.css";

const ce = products.ce14;
const offerPrice = salePrice(ce);
const pageTitle = "Florida 14-Hour CE: Self-Paced + FastPass | Real Estate FastPass";
const pageDescription = `Florida 14-hour real estate continuing education with FastPass final exam for $${offerPrice}. Self-paced, no page timers: take the final when you’re ready to test out. DBPR reporting included.`;

const schema = [
  {
    "@type": "Course",
    "@id": `${site.url}/14ce/#course`,
    url: `${site.url}/14ce/`,
    name: "Florida 14-Hour Real Estate Continuing Education with FastPass final exam",
    description: pageDescription,
    provider: { "@id": `${site.url}/#organization` },
    inLanguage: "en-US",
    offers: courseOffer(ce),
  },
  {
    "@type": "WebPage",
    "@id": `${site.url}/14ce/#webpage`,
    url: `${site.url}/14ce/`,
    name: pageTitle,
    description: pageDescription,
    dateModified: "2026-11-10",
    isPartOf: { "@id": `${site.url}/#website` },
    about: { "@id": `${site.url}/14ce/#course` },
    mainEntity: { "@id": `${site.url}/14ce/#course` },
    publisher: { "@id": `${site.url}/#organization` },
    inLanguage: "en-US",
  },
  faqPage(`${site.url}/14ce/#faq`, [
    { name: "How much is 14-Hour CE?", text: `Pay $${offerPrice} for the complete 14-hour CE course with FastPass final exam, downloadable section PDFs, audio-guided lessons, review questions, and DBPR completion reporting. This is a one-time enrollment. State license renewal fees are separate and paid through DBPR.` },
    { name: "Do I have to sit through 14 hours of timed videos?", text: "No. The Florida 14-hour CE course with FastPass is self-paced, with no timed videos, lesson clock, or page timers. Take the included FastPass final exam when you’re ready to test out, and use the section PDFs, audio-guided lessons, and review questions for anything you want to review. After you pass, we report your completion to DBPR." },
    { name: "Is the FastPass final exam included?", text: "Yes. The FastPass final exam is included in your CE enrollment. If you already know the material, go straight to the final when you're ready to test out. The full course remains available to read, listen to, and review at your own pace, with no page timers or forced lesson stops." },
    { name: "How is completion reported to DBPR?", text: "Your licensed name and license number are collected before the final exam. After you pass, Daniel Larson Training reports your completion to DBPR automatically within 1 business day, guaranteed. You still complete your separate license renewal and pay the state renewal fee through MyFloridaLicense.com." },
  ]),
];
---

<SiteLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath="/14ce/"
  schema={schema}
>
  <div class="draft-sales">
    <section class="draft-hero">
      <div class="wrap draft-hero-grid">
        <div class="draft-hero-intro">
          <p class="draft-kicker">
            <span class="draft-brand">{site.name}</span>
            <span class="draft-school">{site.tagline}</span>
          </p>
          <h1>Florida 14-Hour CE, with a FastPass final exam.</h1>
          <p class="lead">Already know the material? Go straight to the included FastPass final when you’re ready to test out. Or use the full course at your own pace, with no page timers or forced lesson stops.</p>
          <a class="draft-link-more" href="#ce-inside">See the course material <span aria-hidden="true">→</span></a>
        </div>
        <aside class="draft-hero-panel">
          <div class="draft-hero-price">${offerPrice}<span>One-time enrollment · Sales and Brokers after Post-Licensing</span></div>
          <h2>Take the exam when ready.</h2>
          <div class="draft-hero-includes">
            <p class="draft-hero-includes-label">Includes</p>
            <ul>
              <li>3-hour Core Law (required)</li>
              <li>3-hour Ethics (required)</li>
              <li>FastPass final exam to test out</li>
            </ul>
          </div>
          <a class="draft-btn primary" data-plan={ce.id} data-placement="hero_panel" href={ce.checkoutUrl} target="_top">Start 14-Hour CE — ${offerPrice}</a>
          <CheckoutNote />
        </aside>
      </div>
    </section>

    <TrustpilotReviews context="ce" />

    <section class="draft-section" id="ce-inside">
      <div class="wrap">
        <p class="draft-eyebrow">Use the course when it helps you</p>
        <h2>Good material. No forced march.</h2>
        <p class="intro">Read a section, listen while you’re out, or review a topic before the final. The material is there to make the education useful, even when your aim is to finish efficiently.</p>
        <div class="draft-feature-grid">
          <article class="draft-feature" id="include-ce-course"><h3>The complete 14-hour course</h3><p>Read, listen, and review the full CE course at your own pace. No page timers or forced lesson stops.</p></article>
          <article class="draft-feature" id="include-ce-pdfs"><h3>Downloadable section PDFs</h3><p>Clear material to read inside the course and keep for later reference.</p></article>
          <article class="draft-feature" id="include-ce-audio"><h3>Audio-guided lessons</h3><p>Listen podcast-style or follow along with the section PDF.</p></article>
          <article class="draft-feature" id="include-ce-review"><h3>Section review questions</h3><p>Check the concepts you want to reinforce before FastPass.</p></article>
          <article class="draft-feature" id="include-ce-final"><h3>FastPass final exam</h3><p>Test out when you’re ready.</p></article>
          <article class="draft-feature" id="include-ce-reporting"><h3>DBPR reporting</h3><p>After you pass, we report your completion to DBPR.</p></article>
        </div>
      </div>
    </section>

    <section class="draft-section soft" id="faq">
      <div class="wrap">
        <p class="draft-eyebrow">Questions</p>
        <h2>14-Hour CE FAQ</h2>
        <div class="faq-list">
          <details><summary>How much is 14-Hour CE?</summary><p>Pay <strong>${offerPrice}</strong> for the complete 14-hour CE course with FastPass final exam, downloadable section PDFs, audio-guided lessons, review questions, and DBPR completion reporting. This is a one-time enrollment. State license renewal fees are separate and paid through DBPR.</p></details>
          <details><summary>Do I have to sit through 14 hours of timed videos?</summary><p>No. The Florida 14-hour CE course with FastPass is self-paced, with no timed videos, lesson clock, or page timers. Take the included FastPass final exam when you’re ready to test out, and use the section PDFs, audio-guided lessons, and review questions for anything you want to review. After you pass, we report your completion to DBPR.</p></details>
          <details><summary>Is the FastPass final exam included?</summary><p>Yes. The FastPass final exam is included in your CE enrollment. If you already know the material, go straight to the final when you’re ready to test out. The full course remains available to read, listen to, and review at your own pace, with no page timers or forced lesson stops.</p></details>
          <details><summary>How is completion reported to DBPR?</summary><p>Your licensed name and license number are collected before the final exam. After you pass, Daniel Larson Training reports your completion to DBPR automatically within 1 business day, guaranteed. You still complete your separate license renewal and pay the state renewal fee through <a href="https://www.myfloridalicense.com/">MyFloridaLicense.com</a>.</p></details>
        </div>
      </div>
    </section>

    <section class="draft-section navy final-cta">
      <div class="wrap">
        <h2>Pass your final exam. We report your completion.</h2>
        <span class="checkout-cta">
          <a class="draft-btn primary" data-plan={ce.id} data-placement="final_cta" href={ce.checkoutUrl} target="_top">Start 14-Hour CE — ${offerPrice}</a>
          <CheckoutNote />
        </span>
      </div>
    </section>
  </div>
</SiteLayout>
