---
import SiteLayout from "../layouts/SiteLayout.astro";
import PracticeQuestion from "../components/PracticeQuestion.astro";
import PracticeQuestionScript from "../components/PracticeQuestionScript.astro";
import ExamPrepTracking from "../components/ExamPrepTracking.astro";
import CheckoutNote from "../components/CheckoutNote.astro";
import { sampleQuestions, sampleTopics, sampleTopicFor } from "../data/sampleQuestions";
import { products, salePrice } from "../data/products";
import { site } from "../data/site";
import { webPage } from "../lib/seo";
import "../styles/draft-sales.css";

const pageTitle = "Try Sample Florida Real Estate Questions | Real Estate FastPass";
const pageDescription = "Try Florida real estate sample questions with explanations and short videos. Filter by topic and track your score. FastPass includes the full set.";
const total = sampleQuestions.length;
const topicCounts = sampleTopics
  .map((topic) => ({
    ...topic,
    count: sampleQuestions.filter((item) => sampleTopicFor(item.id) === topic.key).length,
  }))
  .filter((topic) => topic.count > 0);
const schema = [
  webPage({
    path: "/sample-questions/",
    name: pageTitle,
    description: pageDescription,
    dateModified: "2026-11-15",
  }),
];
---

<SiteLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath="/sample-questions/"
  schema={schema}
>
  <div class="draft-sales">
    <section class="sample-hero">
      <div class="wrap">
        <p class="draft-kicker">
          <span class="draft-brand">Real Estate FastPass</span>
          <span class="draft-school">{site.tagline}</span>
        </p>
        <h1>Try sample questions</h1>
        <p>No account required. These are practice items from the Course 1 library.</p>
      </div>
    </section>

    <section class="draft-section">
      <div class="wrap sample-quiz-wrap">
        <div class="sample-quiz" data-total={total}>
          <div class="sample-topics" role="group" aria-label="Choose a topic">
            <button type="button" class="sample-topic is-active" data-topic="all" aria-pressed="true">All <span class="sample-topic-count">{total}</span></button>
            {topicCounts.map((topic) => (
              <button type="button" class="sample-topic" data-topic={topic.key} aria-pressed="false">
                {topic.label} <span class="sample-topic-count">{topic.count}</span>
              </button>
            ))}
          </div>

          <div class="sample-prog">
            <span class="sample-prog-count" aria-live="polite">Question 1 of {total}</span>
            <span class="sample-score" aria-live="polite" hidden></span>
            <div class="sample-dots" role="navigation" aria-label="Question progress">
              {sampleQuestions.map((item, index) => (
                <button type="button" class="sample-dot" data-index={index} data-topic={sampleTopicFor(item.id) ?? ""} aria-label={`Question ${index + 1} of ${total}`}></button>
              ))}
            </div>
          </div>
          <div class="sample-bar" aria-hidden="true"><i class="sample-bar-fill"></i></div>

          {sampleQuestions.map((item, index) => (
            <div class="sample-slide" data-index={index} data-qid={item.id} data-topic={sampleTopicFor(item.id) ?? ""} hidden={index !== 0}>
              <PracticeQuestion item={item} />
            </div>
          ))}

          <p class="soft-cta sample-mid-cta" hidden>
            <a href={products.salesFastPass.checkoutUrl} data-plan={products.salesFastPass.id} data-placement="sample_questions_mid" target="_top">FastPass includes the full set of Sample Questions and Answers plus the full course</a>
          </p>

          <div class="sample-stepper-nav">
            <button type="button" class="draft-btn navy" data-sample-prev hidden>Back</button>
            <button type="button" class="draft-btn primary" data-sample-next>Next</button>
          </div>

          <div class="sample-finish final-cta" hidden>
            <p class="sample-finish-score" aria-live="polite"></p>
            <p class="sample-finish-note" hidden></p>
            <h2>Want the full set?</h2>
            <p class="intro" style="margin-inline: auto;">FastPass includes the full set of Sample Questions and Answers plus the full Course 1 path, for ${salePrice(products.salesFastPass)}.</p>
            <span class="checkout-cta">
              <a class="draft-btn primary" data-plan={products.salesFastPass.id} data-placement="sample_questions_final" href={products.salesFastPass.checkoutUrl} target="_top">Start FastPass — ${salePrice(products.salesFastPass)}</a>
              <CheckoutNote />
            </span>
            <p class="sample-finish-actions">
              <button type="button" class="sample-restart" data-sample-restart>Start these questions over</button>
            </p>
            {/* Optional, low-key email box. Finish card only; never gates the quiz. Kit form 10195073 ("Sample Questions quiz signup"). */}
            <div class="sample-finish-slot sample-email" data-slot="finish-extra" data-sample-email>
              <h3 class="sample-email-title">Have licensing questions?</h3>
              <p class="sample-email-body">I&apos;m happy to help. Leave your email and I&apos;ll send you a practice question now and then, each with a short video walking through the answer. Totally optional. You can unsubscribe anytime.</p>
              <form class="sample-email-form" action="https://app.kit.com/forms/10195073/subscriptions" method="post" data-sv-form="10195073" data-uid="8f13726dd2" target="_blank" novalidate>
                <label class="sample-email-label" for="sample-email-input">Email</label>
                <div class="sample-email-row">
                  <input id="sample-email-input" class="sample-email-input" type="email" name="email_address" placeholder="you@email.com" autocomplete="email" inputmode="email" required />
                  <button type="submit" class="draft-btn primary sample-email-submit">Keep in touch</button>
                </div>
                <p class="sample-email-error" role="alert" hidden></p>
              </form>
              <p class="sample-email-success" role="status" hidden>Thanks! Check your inbox. Your first question is on its way.</p>
              <p class="sample-email-small">Or text me anytime at <span class="sample-email-nowrap"><a href="sms:+12394718500">239.471.8500</a>.&nbsp;–&nbsp;Daniel</span></p>
              <p class="sample-email-privacy"><a href="/email-signup-privacy/">How we use your email</a></p>
              <button type="button" class="sample-email-dismiss" data-sample-email-dismiss>No thanks, keep practicing</button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <PracticeQuestionScript />
    <ExamPrepTracking />
  </div>
</SiteLayout>

<style is:global>
  .sample-topics {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }
  .sample-topic {
    border: 1px solid var(--border-light, #dfe7f0);
    background: #fff;
    color: var(--dark-text, #0b1f3a);
    border-radius: 999px;
    padding: 0.4rem 0.85rem;
    font: inherit;
    font-size: 0.9rem;
    cursor: pointer;
  }
  .sample-topic:hover {
    border-color: var(--gold, #d4a017);
  }
  .sample-topic.is-active {
    background: var(--navy, #0a1236);
    border-color: var(--navy, #0a1236);
    color: #fff;
  }
  .sample-topic-count {
    opacity: 0.7;
    font-size: 0.8em;
    margin-left: 0.15rem;
  }
  .sample-dot[hidden],
  .sample-score[hidden],
  .sample-finish-slot[hidden] {
    display: none !important;
  }
  .sample-prog-count,
  .sample-score {
    white-space: nowrap;
  }
  .sample-score {
    font-size: 0.9rem;
    opacity: 0.85;
  }
  .sample-finish {
    border-radius: 22px;
    overflow: hidden;
    padding-inline: 24px;
  }
  .sample-bar-fill.is-complete {
    width: 100% !important;
  }
  /* Readable text on the navy finish card (site's on-navy palette). */
  .sample-finish .intro {
    color: #c9d7ea;
  }
  .sample-finish .checkout-note {
    color: #c9d7ea;
  }
  .sample-finish .sample-finish-score {
    color: #f0c14b;
  }
  .sample-finish .sample-finish-note {
    margin: 0 0 0.75rem;
    font-size: 0.85rem;
    font-weight: 400;
    color: #b8c7dd;
  }
  .sample-finish-note[hidden] {
    display: none !important;
  }
  .sample-email {
    max-width: 34rem;
    margin: 1.75rem auto 0;
    padding: 1.25rem 1.25rem 1rem;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.05);
    text-align: center;
  }
  .sample-email-title {
    margin: 0 0 0.35rem;
    font-size: 1.15rem;
    color: #fff;
  }
  .sample-email-body {
    margin: 0 0 0.9rem;
    font-size: 0.95rem;
    color: #c9d7ea;
  }
  .sample-email-label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .sample-email-row {
    display: flex;
    gap: 0.5rem;
  }
  .sample-email-input {
    flex: 1 1 auto;
    min-width: 0;
    min-height: 48px;
    padding: 0 1rem;
    border: 1px solid #dfe7f0;
    border-radius: 999px;
    background: #fff;
    color: #0b1f3a;
    font: inherit;
  }
  .sample-email-input::placeholder {
    color: #53667d;
  }
  .sample-email-input:focus-visible {
    outline: 3px solid #f0c14b;
    outline-offset: 2px;
  }
  .sample-email-submit {
    flex: 0 0 auto;
    min-height: 48px;
    border: 0;
    cursor: pointer;
    font: inherit;
    font-weight: 700;
  }
  .sample-email-submit[disabled] {
    opacity: 0.7;
    cursor: progress;
  }
  .sample-email-error {
    margin: 0.6rem 0 0;
    font-size: 0.9rem;
    color: #ffb4a8;
  }
  .sample-email-success {
    margin: 0.25rem 0 0.5rem;
    font-weight: 700;
    color: #f0c14b;
  }
  .sample-email-small {
    margin: 0.8rem 0 0.4rem;
    font-size: 0.85rem;
    color: #b8c7dd;
  }
  .sample-email-small a {
    color: #fff;
  }
  .sample-email-nowrap {
    white-space: nowrap;
  }
  .sample-email-privacy {
    margin: 0 0 0.4rem;
    font-size: 0.8rem;
  }
  .sample-email-privacy a {
    color: #b8c7dd;
  }
  .sample-email-dismiss {
    background: none;
    border: 0;
    padding: 0.25rem;
    font: inherit;
    font-size: 0.85rem;
    color: #c9d7ea;
    text-decoration: underline;
    cursor: pointer;
  }
  .sample-email-error[hidden],
  .sample-email-success[hidden],
  .sample-email-form[hidden],
  .sample-email-dismiss[hidden] {
    display: none !important;
  }
  @media (max-width: 480px) {
    .sample-email-row {
      flex-direction: column;
    }
    .sample-email-submit {
      width: 100%;
    }
  }
  .sample-finish .sample-restart {
    color: #fff;
  }
  .sample-finish-score {
    font-size: 1.35rem;
    font-weight: 700;
    margin: 0 0 0.5rem;
  }
  .sample-finish-actions {
    margin-top: 1rem;
  }
  .sample-restart {
    background: none;
    border: 0;
    padding: 0;
    font: inherit;
    color: inherit;
    text-decoration: underline;
    cursor: pointer;
  }
  @media (max-width: 640px) {
    .sample-topics {
      flex-wrap: nowrap;
      overflow-x: auto;
      padding-bottom: 0.25rem;
    }
    .sample-topic {
      flex: 0 0 auto;
    }
  }
</style>
