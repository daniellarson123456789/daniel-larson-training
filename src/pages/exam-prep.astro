---
import SiteLayout from "../layouts/SiteLayout.astro";
import TrustpilotReviews from "../components/TrustpilotReviews.astro";
import CheckoutNote from "../components/CheckoutNote.astro";
import ExamPrepTracking from "../components/ExamPrepTracking.astro";
import { site } from "../data/site";
import { products, salePrice } from "../data/products";
import { courseOffer } from "../lib/courseOffer";
import "../styles/draft-sales.css";

const schema = [
  {
    "@type": "Course",
    "@id": `${site.url}/exam-prep/#sales`,
    name: "Sales Exam Prep + FastPass Only",
    description: "Florida Sales Associate exam preparation for students taking or already finished with their required pre-license course. Exam preparation only; does not include the required pre-license course or completion certificate.",
    provider: { "@id": `${site.url}/#organization` },
    inLanguage: "en-US",
    offers: courseOffer(products.salesExamPrep, "Sales Exam Prep + FastPass Only"),
  },
  {
    "@type": "Course",
    "@id": `${site.url}/exam-prep/#broker`,
    name: "Broker Exam Prep + FastPass Only",
    description: "Florida Broker exam preparation for students taking or already finished with their required broker pre-license course. Exam preparation only; does not include the required pre-license course or completion certificate.",
    provider: { "@id": `${site.url}/#organization` },
    inLanguage: "en-US",
    offers: courseOffer(products.brokerExamPrep, "Broker Exam Prep + FastPass Only"),
  },
  {
    "@type": "WebPage",
    "@id": `${site.url}/exam-prep/#webpage`,
    url: `${site.url}/exam-prep/`,
    name: "Florida Real Estate Exam Prep | Real Estate FastPass",
    isPartOf: { "@id": `${site.url}/#website` },
    publisher: { "@id": `${site.url}/#organization` },
    inLanguage: "en-US",
  },
];
---

<SiteLayout
  title="Florida Real Estate Exam Prep | Real Estate FastPass"
  description="Florida Sales Associate and Broker exam preparation for students taking or already finished with their pre-license course. FastPass, practice questions, audio review, math help, and direct instructor support."
  canonicalPath="/exam-prep/"
  schema={schema}
>
  <div class="draft-sales">
    <div class="exam-only-banner"><p>Already finished Course 1 or Course 2 elsewhere? This page is exam prep only — $130. It is not a FastPass licensing package.</p></div>

    <section class="draft-hero">
      <div class="wrap draft-hero-grid hero-dual">
        <div class="draft-hero-intro">
          <p class="draft-kicker">
            <span class="draft-brand">{site.name}</span>
            <span class="draft-school">{site.tagline}</span>
          </p>
          <h1 class="h1-balance">Exam prep only, for students who took the course elsewhere.</h1>
          <p class="lead">Taking Course 1 or Course 2 with another school — or already have your completion certificate? Add focused prep for the Florida state exam.</p>
          <a class="draft-link-more" href="#options">See your options <span aria-hidden="true">→</span></a>
        </div>
        <aside class="draft-hero-panel">
          <h2>Focus on the state exam.</h2>
          <p>Practice exams and review built to get you through the state test.</p>
          <div class="hero-panel-actions">
            <a class="draft-btn outline" data-plan={products.salesExamPrep.id} data-placement="hero_panel" href={products.salesExamPrep.checkoutUrl} target="_top">Sales Exam Prep — ${salePrice(products.salesExamPrep)}</a>
            <a class="draft-btn primary" data-plan={products.brokerExamPrep.id} data-placement="hero_panel" href={products.brokerExamPrep.checkoutUrl} target="_top">Broker Exam Prep — ${salePrice(products.brokerExamPrep)}</a>
          </div>
          <CheckoutNote />
        </aside>
      </div>
    </section>

    <section class="draft-section soft" id="options">
      <div class="wrap">
        <p class="draft-eyebrow">Choose the right exam prep</p>
        <h2>Choose the prep that matches your Florida licensing exam.</h2>
        <p class="intro">Standalone prep is ${products.salesExamPrep.price} for Sales and ${products.brokerExamPrep.price} for Broker. If you still need the required licensing course itself, go to the <a href="/">Sales</a> or <a href="/broker-licensing/">Broker</a> pages. Those packages are separate from exam prep only.</p>
        <div class="price-grid two">
          <article class="price-card popular">
            <span class="price-badge">Sales Associate</span>
            <h3>Sales Exam Prep</h3>
            <div class="price">${products.salesExamPrep.price}</div>
            <p class="note">FastPass exam-prep system, 500 sample Q&amp;A, audio eBook review, FastPass Workbook (online + PDF), exam math basics, and direct instructor support.</p>
            <a class="draft-btn primary" data-plan={products.salesExamPrep.id} data-placement="package_card" href={products.salesExamPrep.checkoutUrl} target="_top">Enroll in Sales Exam Prep — ${products.salesExamPrep.price}</a>
            <CheckoutNote />
          </article>
          <article class="price-card">
            <span class="price-badge">Broker</span>
            <h3>Broker Exam Prep</h3>
            <div class="price">${products.brokerExamPrep.price}</div>
            <p class="note">Broker FastPass exam-prep system, broker-focused practice and explanations, audio review, Broker FastPass Workbook (online + PDF), exam math review, and direct instructor support.</p>
            <a class="draft-btn navy" data-plan={products.brokerExamPrep.id} data-placement="package_card" href={products.brokerExamPrep.checkoutUrl} target="_top">Enroll in Broker Exam Prep — ${products.brokerExamPrep.price}</a>
            <CheckoutNote />
          </article>
        </div>
      </div>
    </section>

    <section class="draft-section">
      <div class="wrap">
        <p class="draft-eyebrow">What you are buying</p>
        <h2>State-exam preparation alongside or after your licensing course.</h2>
        <div class="draft-feature-grid">
          <article class="draft-feature"><h3>Exam-style questions</h3><p>Use realistic questions and explanations to identify weak areas and sharpen recall.</p></article>
          <article class="draft-feature"><h3>Review without rereading</h3><p>Use audio review when listening is more useful than opening the course materials again.</p></article>
          <article class="draft-feature"><h3>Exam math basics</h3><p>Review the calculations and setup that commonly slow students down on test day.</p></article>
          <article class="draft-feature"><h3>A real person if you get stuck</h3><p>Text or call us for exam-prep questions, study direction, or next-step guidance.</p></article>
        </div>
        <p class="draft-extra" style="margin-top:28px;">Your school certifies course completion. Exam Prep Only helps you prepare. The Florida licensing exam is a separate state exam administered by Pearson Professional Assessments (formerly Pearson VUE). Exam Prep Only does not issue a Course 1 or Course 2 completion certificate.</p>
      </div>
    </section>

    <TrustpilotReviews />

    <section class="draft-section navy final-cta">
      <div class="wrap">
        <h2>Studying now? Get ready for the state exam.</h2>
        <div class="draft-hero-actions" style="justify-content:center;">
          <span class="checkout-cta">
            <a class="draft-btn primary" data-plan={products.salesExamPrep.id} data-placement="final_cta" href={products.salesExamPrep.checkoutUrl} target="_top">Sales Exam Prep</a>
            <CheckoutNote />
          </span>
          <span class="checkout-cta">
            <a class="draft-btn primary" style="background:#fff;color:#0a1236;" data-plan={products.brokerExamPrep.id} data-placement="final_cta" href={products.brokerExamPrep.checkoutUrl} target="_top">Broker Exam Prep</a>
            <CheckoutNote />
          </span>
        </div>
      </div>
    </section>
  </div>
  <ExamPrepTracking />
</SiteLayout>
