---
import SiteLayout from "../layouts/SiteLayout.astro";
import TrustpilotReviews from "../components/TrustpilotReviews.astro";
import TrustpilotReviewLink from "../components/TrustpilotReviewLink.astro";
import SalePrice from "../components/SalePrice.astro";
import { products, salePrice } from "../data/products";
import { courseOffer } from "../lib/courseOffer";
import "../styles/licensing-parity.css";

const pageTitle = `Florida Real Estate License Course $${salePrice(products.salesCourse1)} with Code | Daniel Larson Training`;
const pageDescription = `Florida 63-hour pre-license course $${salePrice(products.salesCourse1)} with ${products.salesCourse1.couponCode}. FastPass $${salePrice(products.salesFastPass)} with ${products.salesFastPass.couponCode}; Full Package with Post $${salePrice(products.salesFastPassPost)} with ${products.salesFastPassPost.couponCode}. One-year access.`;
const pricingAnswer = `Course 1 is $${salePrice(products.salesCourse1)} with ${products.salesCourse1.couponCode}, saving $${products.salesCourse1.discountAmount} from the regular $${products.salesCourse1.price}. FastPass is $${salePrice(products.salesFastPass)} with ${products.salesFastPass.couponCode}, saving $${products.salesFastPass.discountAmount} from $${products.salesFastPass.price}. The Full Package, FastPass + Post, is $${salePrice(products.salesFastPassPost)} with ${products.salesFastPassPost.couponCode}, saving $${products.salesFastPassPost.discountAmount} from $${products.salesFastPassPost.price}. Enrollment links include the matching coupon. Each price is a one-time enrollment payment; state application, fingerprinting, and state-exam fees are separate.`;
const booksAnswer = "No. All course content is included online. FastPass and the Full Package, FastPass + Post, also include the FastPass Workbook to read online or download as a PDF. Printed books included on request with the Full Package. Full Package students can text or email Daniel their shipping address; books and shipping are included.";

const schema = [
  {
    "@type": "Course",
    "@id": "https://daniellarsontraining.com/#course1",
    "name": "Florida 63-Hour Sales Associate Pre-License Course (Course 1)",
    "description": `Florida 63-hour Sales Associate pre-license education from $${salePrice(products.salesCourse1)} with ${products.salesCourse1.couponCode}. FastPass adds course certification and exam preparation, audio/video instruction, and 500+ questions and explanations. All packages include one-year access and direct instructor support. Printed books included on request with the Full Package, FastPass + Post.`,
    "provider": {
      "@id": "https://daniellarsontraining.com/#organization"
    },
    "inLanguage": "en-US",
    "offers": [
      courseOffer(products.salesCourse1, "Course 1 + Traditional Final"),
      courseOffer(products.salesFastPass, "Sales Course 1 + FastPass"),
      courseOffer(products.salesFastPassPost, "Sales FastPass + Post-Licensing"),
    ]
  },
  {
    "@type": "WebPage",
    "@id": "https://daniellarsontraining.com/#webpage",
    "url": "https://daniellarsontraining.com/",
    "name": pageTitle,
    "description": pageDescription,
    "isPartOf": {
      "@id": "https://daniellarsontraining.com/#website"
    },
    "about": {
      "@id": "https://daniellarsontraining.com/#course1"
    },
    "publisher": {
      "@id": "https://daniellarsontraining.com/#organization"
    },
    "inLanguage": "en-US"
  },
  {
    "@type": "FAQPage",
    "@id": "https://daniellarsontraining.com/#faq",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "How much do the sales licensing packages cost?",
        "acceptedAnswer": { "@type": "Answer", "text": pricingAnswer }
      },
      {
        "@type": "Question",
        "name": "Do I need printed course books?",
        "acceptedAnswer": { "@type": "Answer", "text": booksAnswer }
      }
    ]
  }
];
---

<SiteLayout
  title={pageTitle}
  description={pageDescription}
  shareTitle="Sales Licensing"
  ogImage="/share-license-expanded-v2.png"
  canonicalPath="/"
  schema={schema}
>
  <div class="licensing-parity">

<section class="hero" data-motion-section="hero">
<div class="wrap">
<div>
<div class="eyebrow">Florida Sales Associate Licensing</div>
<h1>Get your Florida real estate license <em>fast.</em></h1>
<p class="hero-deck">Get licensed on your schedule with required Florida pre-license education, FastPass certification and exam preparation, 500+ Q&amp;A, audio/video instruction, and direct help from the instructor who built the system.</p>
<p class="hero-kicker">No 63-hour video marathon. No endless PDF grind.</p>
<div class="hero-actions">
<a class="btn btn-primary" href="#packages">See licensing packages ↓</a>
<a class="btn btn-ghost" data-trial="hero" href="https://portal.daniellarsontraining.com/courses/starthere" target="_top">Try FastPass Free</a>
</div>
<TrustpilotReviewLink />
</div>
<aside aria-label="Direct instructor support" class="hero-card">
<div class="eyebrow">Personalized answers</div>
<h2>When you need help, you can ask Daniel.</h2>
<p>Questions about licensing, exam prep, fingerprints, Pearson Professional Assessments, or what to do next? You are not routed to a generic call center.</p>
<a class="support-number" href="sms:+12394718500">TEXT 239.471.8500</a>
<div class="support-note">Professional license support from Daniel Larson Training.</div>
</aside>
</div>
<div aria-label="Course highlights" class="truststrip">
<div><b>1 year</b>online access</div>
<div><b>DBPR approved</b>Course 1</div>
<div><b>500+ Q&amp;A</b>plus explainers</div>
<div><b>Audio + video</b>learn your way</div>
<div class="support-trust"><b>Direct Support</b><a href="mailto:daniel@daniellarsontraining.com">daniel@daniellarsontraining.com</a></div>
</div>
</section>
<section class="packages" data-motion-section="packages" id="packages-section">
<div class="wrap">
<div class="section-head">
<div class="eyebrow">Sales Associate Licensing Options</div>
<h2 id="packages">Choose your path. Fast to thorough — it’s up to you.</h2>
<p>Florida-required pre-license education + exam-prep tools. With FastPass, you can go straight into the three FastPass exams and use the full course, Q&A, audio, video, and study materials as much or as little as you need. Pass FastPass to complete your course-certification path, then head to the state exam prepared. Add Post-Licensing to cover your first-renewal period.</p>
</div>
<div class="package-grid">
<article class="package">
<span class="badge">Course + Traditional Final</span>
<h3>Course 1</h3>
<div class="subplan">Required pre-license education + traditional final exam + state exam math</div>
<SalePrice product={products.salesCourse1} />
<ul>
<li>DBPR-approved 63-hour Course 1</li>
<li>Traditional course final exam</li>
<li>State exam math — Exam Math Basics</li>
<li>One year of access</li>
<li>Direct support from Daniel</li>
</ul>
<a class="btn btn-primary" data-placement="package_card" data-plan={products.salesCourse1.id} href={products.salesCourse1.checkoutUrl} target="_top">Enroll in Course 1</a>
</article>
<article class="package featured">
<span class="badge blue">Most Popular</span>
<h3>FastPass</h3>
<div class="subplan">Required pre-license education + FastPass certification + exam prep</div>
<SalePrice product={products.salesFastPass} />
<ul>
<li>Three FastPass certification exams</li>
<li>Full 63-hour Course 1 included</li>
<li>State exam math — Exam Math Basics</li>
<li>Audio ebook review</li>
<li>FastPass Workbook — online + PDF</li>
<li>500+ Q&amp;A and explanations</li>
<li>One year of access</li>
<li>Direct support from Daniel</li>
</ul>
<a class="btn btn-primary" data-placement="package_card" data-plan={products.salesFastPass.id} href={products.salesFastPass.checkoutUrl} target="_top">Enroll in FastPass</a>
</article>
<article class="package">
<span class="badge">Full Package · Best Value</span>
<h3>Full Package</h3>
<div class="subplan">Sales FastPass + your required 45-hour Sales Post-Licensing course</div>
<SalePrice product={products.salesFastPassPost} />
<ul>
<li>Everything in FastPass</li>
<li>Sales Post-Licensing — required before first renewal</li>
<li>Bundle your next required education step now</li>
<li>FastPass Workbook — online + PDF</li>
<li>One year of access</li>
<li>Printed books included on request with the Full Package.</li>
<li>Direct support from Daniel</li>
</ul>
<a class="btn btn-primary" data-placement="package_card" data-plan={products.salesFastPassPost.id} href={products.salesFastPassPost.checkoutUrl} target="_top">Enroll in FastPass + Post</a>
</article>
</div>
</div>
</section>
    <TrustpilotReviews context="school" />

<section class="fastpass" data-motion-section="fastpass" id="fastpass">
<div class="wrap fast-grid">
<div class="mark-scene"><a aria-label="Enroll in FastPass" class="mark" data-placement="logo" data-plan={products.salesFastPass.id} href={products.salesFastPass.checkoutUrl} target="_top"><img alt="FastPass Florida real estate exam preparation" src="/fastpass-logo.webp"/></a></div>
<div>
<div class="section-head">
<div class="eyebrow" style="color:#1766c7">The FastPass approach</div>
<h2>Go straight into FastPass. Use everything else to get you through it.</h2>
<p>Once you enroll, you can begin with the three FastPass exams. Pass all three to complete your Course 1 testing path and qualify to sit for the separate Florida licensing exam administered by Pearson Professional Assessments (formerly Pearson VUE). Your full Course 1, 500+ practice questions, ebook, audio reviews, videos, and study materials are there as a toolbox — use as much or as little as you need.</p>
<p><a href="/florida-sales-associate-exam-prep/">Explore Sales FastPass: Course 1, certification, exam-prep tools, instructor experience, and official exam references →</a></p>
</div>
<div class="steps">
<div class="step"><div class="stepnum">01</div><div><h3>Start with FastPass.</h3><p>Go right into the FastPass exams. They give you a clear target and quickly show you what you already know — and what you still need to review.</p></div></div>
<div class="step"><div class="stepnum">02</div><div><h3>Use the rest as your prep toolbox.</h3><p>Course 1, 500+ Q&amp;A, the ebook, audio reviews, video explainers, workbooks, and drills are there when you need them. You do not have to use every resource.</p></div></div>
<div class="step"><div class="stepnum">03</div><div><h3>Pass FastPass. Head to the state exam prepared.</h3><p>Pass the three FastPass exams, earn your course certification, and take the separate Florida licensing exam administered by Pearson Professional Assessments. Because the prep is built closely around the state-exam content and experience, the work you do for FastPass also prepares you for the state exam.</p></div></div>
</div>
</div>
</div>
</section>
<section class="included" data-motion-section="included">
<div class="wrap included-grid">
<div>
<div class="eyebrow">Included with FastPass</div>
<h2>Everything you need to pass — <em>fast.</em></h2>
<p class="included-copy">Built around the Florida licensing exam. Clear explanations, exam-language reinforcement, realistic practice, and actual instructor support — without forcing you through a single learning format.</p>
</div>
<div class="feature-grid">
<div class="feature"><b>Optional video explainers</b><span>Daniel breaks down the concepts; use them when you need them.</span></div>
<div class="feature"><b>Glossary reviews</b><span>Definitions plus examples phrased the way you will see them.</span></div>
<div class="feature"><b>FastPass Workbook included</b><span>Read online or download the PDF for offline review.</span></div>
<div class="feature"><b>Audio review course</b><span>Listen in the car, gym, or at night — same instruction.</span></div>
<div class="feature"><b>500+ Q&amp;A</b><span>A deep question bank with explanations, not just answer keys.</span></div>
<div class="feature"><b>Ongoing support</b><span>Real help from the person who wrote the course.</span></div>
</div>
</div>
</section>
<section class="books" data-motion-section="books">
<div class="wrap">
<div class="bookcard">
<div><h2>Printed books with the Full Package.</h2><p>FastPass and the Full Package, FastPass + Post, include the FastPass Workbook to read online or download as a PDF. Printed books included on request with the Full Package.</p></div>
<div class="bookaside"><b>Full Package book requests</b><span>Text or email your name, shipping address, and course. Books and shipping are included with the Full Package.</span></div>
<div class="credential">Written &amp; published by Daniel Larson — DBPR-approved Course 1, Course 2, Post-Licensing &amp; 14-Hour CE — plus Exam Prep and FastPass.</div>
</div>
