---
import SiteLayout from "../layouts/SiteLayout.astro";
import TrustpilotReviews from "../components/TrustpilotReviews.astro";
import CheckoutNote from "../components/CheckoutNote.astro";
import PracticeQuestion from "../components/PracticeQuestion.astro";
import PracticeQuestionScript from "../components/PracticeQuestionScript.astro";
import { products, salePrice } from "../data/products";
import { courseOffer } from "../lib/courseOffer";
import { homeTeaserQuestions } from "../data/sampleQuestions";
import { site } from "../data/site";
import { faqPage } from "../lib/seo";
import "../styles/draft-sales.css";

const pageTitle = "Florida Real Estate License Course | Real Estate FastPass";
const pageDescription = `Get your Florida real estate license fast with FastPass: self-paced, no lesson clock, and three exams built to closely match the Pearson state exam. Pass all three and you’re certified to take it. Course 1 $${salePrice(products.salesCourse1)}, FastPass $${salePrice(products.salesFastPass)}, or FastPass + Post $${salePrice(products.salesFastPassPost)}. One-year access and direct support.`;
const pricingAnswer = `Course 1 is $${salePrice(products.salesCourse1)}. FastPass is $${salePrice(products.salesFastPass)}. The Full Package, FastPass + Post, is $${salePrice(products.salesFastPassPost)}. Each price is a one-time enrollment payment; state application, fingerprinting, and state-exam fees are separate.`;
const booksAnswer = "No. All course content is included online. FastPass and the Full Package, FastPass + Post, also include the FastPass Workbook to read online or download as a PDF. Want a printed workbook? Just ask and we'll send one free through Amazon.";

const schema = [
  {
    "@type": "Course",
    "@id": "https://realestatefastpass.com/#course1",
    "name": "Florida 63-Hour Sales Associate Pre-License Course (Course 1)",
    "description": `Florida 63-hour Sales Associate pre-license education from $${salePrice(products.salesCourse1)}. FastPass adds course certification and exam preparation, audio/video instruction, and 500+ questions and explanations. All packages include one-year access and direct instructor support. Want a printed workbook? Just ask and we'll send one free through Amazon.`,
    "provider": { "@id": "https://realestatefastpass.com/#organization" },
    "inLanguage": "en-US",
    "offers": [
      courseOffer(products.salesCourse1, "Course 1 + Traditional Final"),
      courseOffer(products.salesFastPass, "Sales Course 1 + FastPass"),
      courseOffer(products.salesFastPassPost, "Sales FastPass + Post-Licensing"),
    ]
  },
  {
    "@type": "WebPage",
    "@id": "https://realestatefastpass.com/#webpage",
    "url": "https://realestatefastpass.com/",
    "name": pageTitle,
    "description": pageDescription,
    "isPartOf": { "@id": "https://realestatefastpass.com/#website" },
    "about": { "@id": "https://realestatefastpass.com/#course1" },
    "publisher": { "@id": "https://realestatefastpass.com/#organization" },
    "inLanguage": "en-US"
  },
  faqPage("https://realestatefastpass.com/#faq", [
    { name: "How much do the Sales licensing packages cost?", text: pricingAnswer },
    { name: "What is included in the FastPass package?", text: `FastPass is $${salePrice(products.salesFastPass)}. The package includes the DBPR-approved 63-hour Course 1, three FastPass certification exams, Exam Math Basics, 500+ practice questions and explanations, audio ebook review, the FastPass Workbook online and as a PDF, one year of access, and direct support.` },
    { name: "How is FastPass different?", text: "FastPass for the Florida Sales Associate license is three certification exams built to closely match the content on the Pearson state exam, used in place of the traditional Course 1 final. Pass all three and you’re certified to take the Florida state exam, so course certification and state-exam prep happen at the same time. Course 1 with the traditional final uses a standard course final instead. FastPass is self-paced, so you take the exams when you’re ready, and you still take the Florida state licensing exam separately." },
    { name: "What’s the fastest way to get my Florida real estate license?", text: "The fastest way to get your Florida real estate license with Real Estate FastPass is to work through FastPass at your own pace instead of on a lesson clock. FastPass pairs the self-paced 63-hour Course 1 with three certification exams built to closely match the content on the Pearson state exam, and once you pass all three, you’re certified to take the Florida state exam. There are no page timers or forced lesson stops, so students who already know the material can go straight to the FastPass exams, and the course, workbook, and audio review are there for anything they want to brush up on." },
    { name: "Do I have to sit through 63 hours of timed videos?", text: "No. FastPass for the Florida Sales Associate license is self-paced, with no timed videos, lesson clock, or page timers. Take the three FastPass exams, built to closely match the content on the Pearson state exam, when you’re ready, and once you pass all three, you’re certified to take the Florida state exam. Course 1, the audio review, and the workbook are there for anything you want to review." },
    { name: "Can I just take the FastPass exams when I’m ready?", text: "Yes. FastPass for the Florida Sales Associate license is self-paced, with no lesson clock or page timers, so you can take the three FastPass exams whenever you’re ready. Many students go straight into the exams and use Course 1, the workbook, and the audio review to fill in whatever they still need. Passing all three certifies you to take the Florida state exam, which you still take separately." },
    { name: "Does FastPass replace the Florida state licensing exam?", text: "No. The Florida state licensing exam is a separate exam administered by Pearson Professional Assessments (formerly Pearson VUE). FastPass is preparation and part of the course-certification path; you still take the state exam separately." },
    { name: "How long do I have access?", text: "Course bundles include one year of online access." },
    { name: "Can I contact the school directly?", text: "Yes. Text or email us at 239.471.8500 or daniel@daniellarsontraining.com about the course, exam preparation, or your licensing steps." },
    { name: "Can I get a printed workbook?", text: booksAnswer },
  ]),
];
---

<SiteLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath="/"
  schema={schema}
>
  <div class="draft-sales">

    <section class="draft-hero">
      <div class="wrap draft-hero-grid">
        <div class="draft-hero-intro">
          <p class="draft-kicker">
            <span class="draft-brand">{site.name}</span>
            <span class="draft-school">{site.tagline}</span>
          </p>
          <h1>Get your Florida real estate license <em class="fast">Fast</em> with FastPass.</h1>
          <p class="lead">Self-paced Course 1, with no lesson clock, and three FastPass exams built to closely match the content on the Pearson state exam. Pass all three and you’re certified to take the state exam, so you get certified while you prep for it.</p>
          <a class="draft-link-more" href="#whats-included">See what’s included <span aria-hidden="true">→</span></a>
        </div>
        <aside class="draft-hero-panel">
          <div class="draft-hero-price">${salePrice(products.salesFastPass)}<span>Most popular · one-time enrollment</span></div>
          <h2>The complete licensing path.</h2>
          <p>Course 1, FastPass certification exams that mirror the state exam, the workbook, audio review, math basics, and 500 sample questions, plus direct support.</p>
          <a class="draft-btn primary" data-plan={products.salesFastPass.id} data-placement="hero_panel" href={products.salesFastPass.checkoutUrl} target="_top">Start FastPass — ${salePrice(products.salesFastPass)}</a>
          <CheckoutNote />
        </aside>
      </div>
    </section>

    <section class="draft-section" id="whats-included">
      <div class="wrap">
        <p class="draft-eyebrow">What you get</p>
        <h2>What you get with FastPass</h2>
        <p class="intro">Here’s what’s included — the complete FastPass bundle.</p>
        <ol class="draft-bundle">
          <li id="include-course-1">
            <span class="num">1</span>
            <div>
              <h3>Course 1 (DBPR-approved 63-hour)</h3>
              <p>The required Florida Sales Associate pre-license course.</p>
            </div>
          </li>
          <li id="include-fastpass-start">
            <span class="num">2</span>
            <div>
              <h3>FastPass Start</h3>
              <p>A clear starting point so you know how to move through the course and certification path.</p>
            </div>
          </li>
          <li id="include-workbook">
            <span class="num">3</span>
            <div>
              <h3>FastPass Workbook (online + PDF)</h3>
              <p>Read it in your course or download the PDF to study offline. Want a printed workbook? Just ask and we&apos;ll send one free through Amazon.</p>
            </div>
          </li>
          <li id="include-certification">
            <span class="num">4</span>
            <div>
              <h3>FastPass Certification (three certification exams)</h3>
              <p>Three FastPass certification exams that mirror the state exam, in place of the traditional course final. Certification and exam prep happen together.</p>
            </div>
          </li>
          <li id="include-audio">
            <span class="num">5</span>
            <div>
              <h3>Audio Ebook Review</h3>
              <p>Listen through the review when you can’t sit down with the workbook.</p>
            </div>
          </li>
          <li id="include-math">
            <span class="num">6</span>
            <div>
              <h3>Exam Math Basics</h3>
              <p>The math you’ll need for the course and the state exam, explained clearly.</p>
            </div>
          </li>
          <li id="include-sample-questions">
            <span class="num">7</span>
            <div>
              <h3>500 Sample Q&amp;A with explanations</h3>
              <p>Practice questions with answers and explanations, so you can see why an answer is right.</p>
            </div>
          </li>
          <li id="include-access">
            <span class="num">8</span>
            <div>
              <h3>One year of access</h3>
              <p>Your FastPass enrollment includes one year of online access.</p>
            </div>
          </li>
          <li id="include-support">
            <span class="num">9</span>
            <div>
              <h3>Direct support</h3>
              <p>Text or email us when you get stuck. There is no call center.</p>
            </div>
          </li>
        </ol>
      </div>
    </section>

    <section class="draft-section navy" id="why-daniel">
      <div class="wrap why-grid">
        <img class="why-photo" src="/daniel-larson-teaching.webp" alt="Daniel Larson teaching a Florida real estate class" width="1200" height="800" loading="lazy" decoding="async" />
        <div>
          <p class="draft-eyebrow">Why this school</p>
          <h2>Why Daniel Larson Training</h2>
          <p class="intro">Text or email us when you get stuck. There is no call center and no sales staff in between.</p>
          <ul class="why-list">
            <li><strong>You can reach Daniel directly</strong><span>Questions? Text Daniel at 239.471.8500. No call center.</span></li>
            <li><strong>Florida-focused, not a national brand</strong><span>Built for Florida licensing, Florida law, and the Florida state exam.</span></li>
            <li><strong>Learn the way that works for you</strong><span>Audio, video, PDF, workbook, and review questions. Use what helps you pass.</span></li>
          </ul>
        </div>
      </div>
    </section>

    <section class="draft-section soft" id="pricing">
      <div class="wrap">
        <p class="draft-eyebrow">Pricing</p>
        <h2>Choose your Sales licensing package</h2>
        <p class="intro">Three options. FastPass is the complete path most students choose.</p>
        <div class="price-grid">
          <article class="price-card">
            <h3>Course 1 + Traditional Final</h3>
            <div class="price">${salePrice(products.salesCourse1)}</div>
            <p class="note">FastPass gets you certified and ready for the state exam at the same time, for just $80 more.</p>
            <a class="draft-btn navy" data-plan={products.salesCourse1.id} data-placement="pricing_card" href={products.salesCourse1.checkoutUrl} target="_top">Enroll — ${salePrice(products.salesCourse1)}</a>
            <CheckoutNote />
          </article>
          <article class="price-card popular">
            <span class="price-badge">MOST POPULAR</span>
            <h3>FastPass</h3>
            <div class="price">${salePrice(products.salesFastPass)}</div>
            <p class="note">The full FastPass bundle: Course 1, certification exams that mirror the state exam, workbook, audio review, math basics, and 500 sample questions. Certification and exam prep happen together. Want a printed workbook? Just ask and we&apos;ll send one free through Amazon.</p>
            <a class="draft-btn primary" data-plan={products.salesFastPass.id} data-placement="pricing_card" href={products.salesFastPass.checkoutUrl} target="_top">Start FastPass — ${salePrice(products.salesFastPass)}</a>
            <CheckoutNote />
          </article>
          <article class="price-card">
            <h3>FastPass + Post</h3>
            <div class="price">${salePrice(products.salesFastPassPost)}</div>
            <p class="note">Best value: your required Post-Licensing course is included at a bundle price, ready for when you&apos;re licensed, before your first renewal.</p>
            <a class="draft-btn navy" data-plan={products.salesFastPassPost.id} data-placement="pricing_card" href={products.salesFastPassPost.checkoutUrl} target="_top">Enroll — ${salePrice(products.salesFastPassPost)}</a>
            <CheckoutNote />
          </article>
        </div>
      </div>
    </section>

    <TrustpilotReviews context="school" />

    <section class="draft-section" id="sample-questions">
      <div class="wrap">
        <p class="draft-eyebrow">Try it</p>
        <h2>Sample questions</h2>
        <p class="intro">Three real practice questions from the course. Choose an answer or reveal it — no account required.</p>
        <div class="teaser-grid">
          {homeTeaserQuestions.map((item) => <PracticeQuestion item={item} />)}
        </div>
        <div class="teaser-cta">
          <a class="draft-btn primary" href="/sample-questions/">Try more sample questions</a>
        </div>
      </div>
    </section>

    <div class="wrap">
      <p class="exam-prep-line">Already finished Course 1 elsewhere? <a href="/exam-prep/">Exam prep only — $130</a></p>
    </div>

    <section class="draft-section soft" id="faq">
      <div class="wrap">
        <p class="draft-eyebrow">Questions</p>
        <h2>Florida Real Estate Licensing FAQ</h2>
        <div class="faq-list">
          <details><summary>How much do the Sales licensing packages cost?</summary><p>{pricingAnswer}</p></details>
          <details><summary>What is included in the FastPass package?</summary><p>FastPass is ${salePrice(products.salesFastPass)}. The package includes the DBPR-approved 63-hour Course 1, three FastPass certification exams, Exam Math Basics, 500+ practice questions and explanations, audio ebook review, the FastPass Workbook online and as a PDF, one year of access, and direct support.</p></details>
          <details><summary>How is FastPass different?</summary><p>FastPass for the Florida Sales Associate license is three certification exams built to closely match the content on the Pearson state exam, used in place of the traditional Course 1 final. Pass all three and you’re certified to take the Florida state exam, so course certification and state-exam prep happen at the same time. Course 1 with the traditional final uses a standard course final instead. FastPass is self-paced, so you take the exams when you’re ready, and you still take the Florida state licensing exam separately.</p></details>
          <details><summary>What’s the fastest way to get my Florida real estate license?</summary><p>The fastest way to get your Florida real estate license with Real Estate FastPass is to work through FastPass at your own pace instead of on a lesson clock. FastPass pairs the self-paced 63-hour Course 1 with three certification exams built to closely match the content on the Pearson state exam, and once you pass all three, you’re certified to take the Florida state exam. There are no page timers or forced lesson stops, so students who already know the material can go straight to the FastPass exams, and the course, workbook, and audio review are there for anything they want to brush up on.</p></details>
          <details><summary>Do I have to sit through 63 hours of timed videos?</summary><p>No. FastPass for the Florida Sales Associate license is self-paced, with no timed videos, lesson clock, or page timers. Take the three FastPass exams, built to closely match the content on the Pearson state exam, when you’re ready, and once you pass all three, you’re certified to take the Florida state exam. Course 1, the audio review, and the workbook are there for anything you want to review.</p></details>
          <details><summary>Can I just take the FastPass exams when I’m ready?</summary><p>Yes. FastPass for the Florida Sales Associate license is self-paced, with no lesson clock or page timers, so you can take the three FastPass exams whenever you’re ready. Many students go straight into the exams and use Course 1, the workbook, and the audio review to fill in whatever they still need. Passing all three certifies you to take the Florida state exam, which you still take separately.</p></details>
          <details><summary>Does FastPass replace the Florida state licensing exam?</summary><p>No. The Florida state licensing exam is a separate exam administered by <a href="https://www.pearsonvue.com/us/en/fl/dbpr.html" rel="noopener" target="_blank">Pearson Professional Assessments</a> (formerly Pearson VUE). FastPass is preparation and part of the course-certification path; you still take the state exam separately.</p></details>
          <details><summary>How long do I have access?</summary><p>Course bundles include one year of online access.</p></details>
          <details><summary>Can I contact the school directly?</summary><p>Yes. Text or email us at <a href="sms:+12394718500">239.471.8500</a> or <a href="mailto:daniel@daniellarsontraining.com">daniel@daniellarsontraining.com</a> about the course, exam preparation, or your licensing steps.</p></details>
          <details><summary>Can I get a printed workbook?</summary><p>{booksAnswer}</p></details>
        </div>
      </div>
    </section>

    <section class="draft-section navy final-cta">
      <div class="wrap">
        <h2>Ready to get your Florida real estate license?</h2>
        <span class="checkout-cta">
          <a class="draft-btn primary" data-plan={products.salesFastPass.id} data-placement="final_cta" href={products.salesFastPass.checkoutUrl} target="_top">Start FastPass — ${salePrice(products.salesFastPass)}</a>
          <CheckoutNote />
        </span>
      </div>
    </section>

    <PracticeQuestionScript />
  </div>
</SiteLayout>
