  <script is:inline>
document.addEventListener('click', function(e){
    const a = e.target.closest('a');
    if(!a) return;

    if(typeof window.gtag === 'function'){
      if(a.dataset.plan){
        window.gtag('event','select_course_package',{
          course_package:a.dataset.plan,
          link_placement:a.dataset.placement,
          link_url:a.href
        });
      }

      if(a.dataset.trial){
        window.gtag('event','try_fastpass_free',{
          cta_location:a.dataset.trial,
          link_url:a.href
        });
      }
    }
  });
</script>

<script is:inline>
document.addEventListener('click', function(e){
    const link = e.target.closest('a[href="#packages"]');
    if(!link) return;

    const target = document.getElementById('packages');
    if(!target) return;

    e.preventDefault();
    const reduceMotion = window.matchMedia &&
      window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    target.scrollIntoView({
      behavior: reduceMotion ? 'auto' : 'smooth',
      block: 'start'
    });
  });
</script>
</SiteLayout>

