---
import SiteLayout from "../layouts/SiteLayout.astro";
import GuidedHome from "../components/GuidedHome.astro";
import { products, licensingSale } from "../data/products";
import { courseOffer } from "../lib/courseOffer";

const schema = [
  {
    "@type": "Course",
    "@id": "https://daniellarsontraining.com/#course1",
    "name": "Florida 63-Hour Sales Associate Pre-License Course (Course 1)",
    "description": "Florida Sales Associate pre-license education with FastPass certification and exam preparation, audio/video instruction, 500+ questions and explanations, one-year access, free printed books on request, and direct instructor support.",
    "provider": {
      "@id": "https://daniellarsontraining.com/#organization"
    },
    "inLanguage": "en-US",
    "offers": [
      courseOffer(products.salesCourse1, "Course 1 + Traditional Final"),
      courseOffer(products.salesFastPass, "Sales Course 1 + FastPass"),
      courseOffer(products.salesFastPassPost, "Sales FastPass + Post-Licensing"),
    ]
  },
  {
    "@type": "WebPage",
    "@id": "https://daniellarsontraining.com/#webpage",
    "url": "https://daniellarsontraining.com/",
    "name": "Florida Real Estate License Course & FastPass | Daniel Larson Training",
    "description": `Florida Sales FastPass combines Course 1, three certification exams, 500+ practice questions, a workbook, and direct support from course author Daniel Larson. $${products.salesFastPass.price}; save $100 at checkout with code ${licensingSale.code}. One year of access.`,
    "isPartOf": {
      "@id": "https://daniellarsontraining.com/#website"
    },
    "about": {
      "@id": "https://daniellarsontraining.com/#course1"
    },
    "publisher": {
      "@id": "https://daniellarsontraining.com/#organization"
    },
    "inLanguage": "en-US"
  }
];
---

<SiteLayout
  title="Florida Real Estate License Course & FastPass | Daniel Larson Training"
  description={`Get a clear path to your Florida real estate license with FastPass, required Course 1 education, flexible study tools, and direct help from Daniel Larson. Packages from $${products.salesCourse1.price}; save $100 with ${licensingSale.code}.`}
  shareTitle="Your Florida License. A Clear Path."
  ogImage="/share-license-expanded-v2.png"
  canonicalPath="/"
  schema={schema}
  showSale={false}
>
  <GuidedHome />
</SiteLayout>
