---
import SiteLayout from "../layouts/SiteLayout.astro";
import "../styles/draft-sales.css";
---

<SiteLayout
  title="Page Not Found | Real Estate FastPass"
  description="The requested Daniel Larson Training page could not be found."
  canonicalPath="/404/"
  robots="noindex,follow"
>
  <div class="draft-sales">
    <section class="draft-hero">
      <div class="wrap" style="text-align:center;max-width:40rem;">
        <p class="draft-kicker" style="justify-content:center;"><span class="draft-brand">404</span></p>
        <h1>That page isn’t here.</h1>
        <p class="lead">Use the site navigation or return to Sales Licensing.</p>
        <div class="draft-hero-actions" style="justify-content:center;">
          <a class="draft-btn primary" href="/">Go to Sales Licensing</a>
        </div>
      </div>
    </section>
  </div>
</SiteLayout>
