---
import SiteLayout from "../layouts/SiteLayout.astro";
import TrustpilotReviews from "../components/TrustpilotReviews.astro";
import FAQ from "../components/FAQ.astro";
import ExamPrepTracking from "../components/ExamPrepTracking.astro";
import SalePrice from "../components/SalePrice.astro";
import { products, salePrice } from "../data/products";
import { site } from "../data/site";
import { courseOffer } from "../lib/courseOffer";
import CheckoutNote from "../components/CheckoutNote.astro";
import "../styles/draft-sales.css";

const pagePath = "/florida-broker-exam-prep/";
const pageUrl = `${site.url}${pagePath}`;
const fastPass = products.brokerFastPass;
const prepOnly = products.brokerExamPrep;
const fullPackage = products.brokerCareerLaunch;
const pageTitle = "Florida Broker Exam Prep | Real Estate FastPass";
const pageDescription = `Florida 72-hour Course 2 with Broker FastPass certification and exam prep for $${salePrice(fastPass)}. Digital workbook, audio, and instructor support.`;
const faqItems = [
  {
    question: "Is this preparation specifically for the Florida broker exam?",
    answer: "Yes. Broker FastPass and Broker Exam Prep Only are the broker-specific options from Daniel Larson Training. They use Florida broker materials, practice questions, explanations, math review, and the Broker FastPass Workbook. Choose Sales Associate Exam Prep instead if you are preparing for the sales associate exam.",
  },
  {
    question: "Does Broker FastPass include my Course 2 certification?",
    answer: `Broker FastPass is $${salePrice(fastPass)}. It includes the required 72-hour Broker Course 2, the three Broker FastPass certification exams, and exam preparation. Pass the three Broker FastPass exams to complete your Course 2 certification path. The Florida state licensing exam administered through Pearson is a separate exam, and DBPR exam eligibility still applies.`,
  },
  {
    question: "Can I use this if I took Course 2 with another school?",
    answer: `Yes. The $${prepOnly.price} Broker Exam Prep Only option is for candidates taking or already finished with Course 2 elsewhere. It includes broker exam preparation and the Broker FastPass Workbook. It does not include Course 2 or issue a Course 2 completion certificate; your licensing school handles your course completion. If you also need the required course and DLT certification, Broker FastPass includes Course 2, the FastPass certification path, and state-exam preparation for $${salePrice(fastPass)}.`,
  },
  {
    question: "Can I get a printed workbook?",
    answer: `Broker students always get the Course 2 textbook and the FastPass workbook, online and as a downloadable PDF. Want a printed copy? Just ask and we'll send one free through Amazon.`,
  },
  {
    question: "Who answers my study questions?",
    answer: `Yes. Call or text ${site.phoneDisplay}, or email ${site.email} if you have a question, need help with a study topic, or want to know which package fits.`,
  },
  {
    question: "Where should I check current exam information?",
    answer: "Use DBPR's Candidate Information Booklets page and select Real Estate – Broker for the official broker exam bulletin. Use Pearson's Florida Real Estate page for testing and scheduling information. Links to both appear in the official exam information section below. The state and testing provider control their requirements.",
  },
];

const schema = [
  {
    "@type": "WebPage",
    "@id": `${pageUrl}#webpage`,
    url: pageUrl,
    name: pageTitle,
    description: pageDescription,
    isPartOf: { "@id": `${site.url}/#website` },
    publisher: { "@id": `${site.url}/#organization` },
    author: { "@id": `${site.url}/#daniel-larson` },
    about: [ { "@id": `${pageUrl}#broker-fastpass` }, { "@id": `${pageUrl}#prep-only` } ],
    inLanguage: "en-US",
  },
  {
    "@type": "Course",
    "@id": `${pageUrl}#broker-fastpass`,
    name: "Broker FastPass — Course 2, Certification & Exam Prep",
    description: "Florida 72-hour Broker Course 2 with three Broker FastPass certification exams, 500+ questions and explanations, audio review, the Broker FastPass Workbook, math review, one-year access, and direct instructor support.",
    provider: { "@id": `${site.url}/#organization` },
    inLanguage: "en-US",
    offers: courseOffer(fastPass),
  },
  {
    "@type": "Course",
    "@id": `${pageUrl}#prep-only`,
    name: "Florida Broker Exam Prep Only",
    description: "Florida broker exam preparation for candidates taking or already finished with their required course elsewhere. Broker FastPass prep, questions and explanations, workbook, audio, math review, and direct support. Does not include Course 2 or a course completion certificate.",
    provider: { "@id": `${site.url}/#organization` },
    inLanguage: "en-US",
    offers: courseOffer(prepOnly),
  },
  {
    "@type": "FAQPage",
    "@id": `${pageUrl}#faq`,
    mainEntity: faqItems.map(({ question, answer }) => ({
      "@type": "Question",
      name: question,
      acceptedAnswer: { "@type": "Answer", text: answer },
    })),
  },
];
---
<SiteLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath={pagePath}
  schema={schema}
>



  <div class="draft-sales">
    <section class="draft-hero">
      <div class="wrap draft-hero-grid">
        <div>
          <p class="draft-kicker">
            <span class="draft-brand">{site.name}</span>
            <span class="draft-school">{site.tagline}</span>
          </p>
          <h1>Get your Florida broker license with FastPass.</h1>
          <p class="hero-deck lead">Your complete Florida broker licensing package: Course 2, FastPass certification exams that mirror the state exam, and focused preparation for the separate state exam. Get broker-specific practice, explanations, a workbook, math review, and you can text or email us if you get stuck.</p>
          <div class="draft-hero-actions">
            <span class="checkout-cta">
              <a class="draft-btn primary" data-plan={fastPass.id} data-placement="hero" href={fastPass.checkoutUrl} target="_top">Start FastPass — ${salePrice(fastPass)}</a>
              <CheckoutNote />
            </span>
            <a class="draft-link-secondary" href="#broker-fastpass">See what’s included</a>
          </div>
        </div>
        <aside class="draft-hero-panel">
          <div class="draft-hero-price">${salePrice(fastPass)}<span>Most popular · one-time enrollment</span></div>
          <h2>Certification and exam prep happen together.</h2>
          <p>FastPass uses three certification exams that mirror the state exam, in place of the traditional course final, so you get certified and ready for the state exam at the same time.</p>
        </aside>
      </div>
    </section>

    <section class="draft-section soft" id="broker-fastpass">
      <div class="wrap">
        <p class="draft-eyebrow">Broker FastPass</p>
        <h2>Course 2, certification, and exam prep in one package</h2>
        <p class="intro">Broker FastPass includes the required 72-hour Broker Course 2, three FastPass certification exams that mirror the state exam, 500+ questions and explanations, audio review, the FastPass Workbook, math review, one-year access, and direct instructor support.</p>
        <div class="price-grid" style="grid-template-columns:1fr;max-width:480px;">
          <article class="price-card popular">
            <span class="price-badge">MOST POPULAR</span>
            <h3>Broker FastPass</h3>
            <div class="price">${salePrice(fastPass)}</div>
            <p class="note">FastPass gets you certified and ready for the state exam at the same time.</p>
            <a class="draft-btn primary" data-plan={fastPass.id} data-placement="pricing_card" href={fastPass.checkoutUrl} target="_top">Start FastPass — ${salePrice(fastPass)}</a>
            <CheckoutNote />
          </article>
        </div>
        <p class="exam-prep-line">Already finished Course 2 elsewhere? <a href="/exam-prep/">Exam prep only — $130</a></p>
      </div>
    </section>

    <TrustpilotReviews context="broker" />

    <section class="draft-section soft" id="faq">
      <div class="wrap">
        <p class="draft-eyebrow">Questions</p>
        <h2>Broker FastPass FAQ</h2>
        <div class="faq-list">
          {faqItems.map((item) => (
            <details>
              <summary>{item.question}</summary>
              <p>{item.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="draft-section navy final-cta">
      <div class="wrap">
        <h2>Ready to get your Florida broker license?</h2>
        <span class="checkout-cta">
          <a class="draft-btn primary" data-plan={fastPass.id} data-placement="final_cta" href={fastPass.checkoutUrl} target="_top">Start FastPass — ${salePrice(fastPass)}</a>
          <CheckoutNote />
        </span>
      </div>
    </section>
  </div>
  <ExamPrepTracking />
</SiteLayout>
